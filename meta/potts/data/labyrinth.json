{"key":"8c0b0088941fc306","source_file":"Potts La - Le.json","source_id":1884,"source_url":"concordance-labyrinth-ppl-labyrintheus","term":"Labyrinth","headwords":["Labyrinth","Labyrinthine"],"latin":["Labyrintheus","Labyrintheus"],"header_pairs":[{"english":["Labyrinth"],"latin":["Labyrintheus"]},{"english":["Labyrinthine"],"latin":["Labyrintheus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","TCR"],"contexts":[{"reference":{"work":"AC","section":"5181","subsection":"end"},"text":"They who pertain to the lymphatics... are as it were labyrinths...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"8","subsection":"4"},"text":"This paradisiacal labyrinth is truly an entrance into Heaven.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"165","subsection":"3"},"text":"Like one who enters a labyrinth without a guide or thread.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1153","subsection":"7"},"text":"By infinite ways, which appear as labyrinthine even before the Angels of the Third Heaven.","comment":null,"footnote":null}],"slug":"labyrinth","url":"/meta/potts/labyrinth/"}