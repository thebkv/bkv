{"key":"e38413299d984cdd","source_file":"Potts Sh - So.json","source_id":8702,"source_url":"concordance-shoot-ppl-palmes","term":"Shoot","headwords":["Shoot"],"latin":["Palmes"],"header_pairs":[{"english":["Shoot"],"latin":["Palmes"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"1069","subsection":"4"},"text":"Occurs. AC 5113:6. TCR 354.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1069","subsection":"end"},"text":"I am the Vine, ye are the branches. AC 9258:4. HH 11. AE 293:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5113","subsection":"4"},"text":"Degenerate shoots of a strange vine () = the man of a perverted Church.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5113","subsection":"15"},"text":"Those who are implanted in the truth which is from Him, thus in Him, He compares to the branches.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9272","subsection":"3"},"text":"To sow the land with a slip of what is strange () = to teach truths not genuine.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"281","subsection":"2"},"text":"Shoots = the Knowledges of truth and good...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"376","subsection":"end"},"text":"The shoots of the vine = truths from which is doctrine.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"403","subsection":"6"},"text":"Its branches are made white () = no longer anything spiritual.","comment":null,"footnote":null}],"slug":"shoot-e38413","url":"/meta/potts/shoot-e38413/"}