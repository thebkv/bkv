{"key":"e2172546b96a1dac","source_file":"Potts Pr - Py.json","source_id":3774,"source_url":"concordance-precede-ppl-praecedere","term":"Precede","headwords":["Precede"],"latin":["Praecedere"],"header_pairs":[{"english":["Precede"],"latin":["Praecedere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"2235","subsection":"3"},"text":"When judgment precedes, it = love through faith; but when justice precedes, it = faith from love.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3089","subsection":"end"},"text":"Such an (impure) affection must precede.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3350","subsection":null},"text":"No one wants to precede others.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3995","subsection":"2"},"text":"Truth (then) apparently precedes... Good then manifestly precedes.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8864","subsection":"4"},"text":"The things which precede reign in the things which follow.","comment":null,"footnote":null}],"slug":"precede","url":"/meta/potts/precede/"}