{"key":"0ca14dbd5a8d57ba","source_file":"Potts Re.json","source_id":19662,"source_url":"concordance-refuse-ppl-renuere","term":"Refuse","headwords":["Refuse","Refusal"],"latin":["Renuere","Renuentia"],"header_pairs":[{"english":["Refuse"],"latin":["Renuere"]},{"english":["Refusal"],"latin":["Renuentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH"],"contexts":[{"reference":{"work":"AC","section":"4366","subsection":null},"text":"The refusal here involves assent... The end of refusal, when one accepts, is sometimes that affection may be insinuated. Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4990","subsection":null},"text":"He refused () = aversion.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7038","subsection":"end"},"text":"If thou refuse to let him go () = obstinacy even to the last. AC 7350. AC 7501.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8513","subsection":null},"text":"How long do ye refuse... ().","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9185","subsection":null},"text":"To refuse () = not to admit.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"343","subsection":null},"text":"The refusal and resistance (of the infants there).","comment":null,"footnote":null}],"slug":"refuse-0ca14d","url":"/meta/potts/refuse-0ca14d/"}