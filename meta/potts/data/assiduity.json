{"key":"182b4ba4e7092a16","source_file":"Potts An - Az.json","source_id":43705,"source_url":"concordance-assiduity-ppl-sedulitas","term":"Assiduity","headwords":["Assiduity","Industrious"],"latin":["Sedulitas","Sedulus"],"header_pairs":[{"english":["Assiduity"],"latin":["Sedulitas"]},{"english":["Industrious"],"latin":["Sedulus"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","HH"],"contexts":[{"reference":{"work":"HH","section":"364","subsection":null},"text":"It is very different with the poor who are content with their lot, industrious and diligent at their work...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"164","subsection":null},"text":"(Assiduity one of the moral virtues.)","comment":null,"footnote":null},{"reference":{"work":"CL","section":"220","subsection":"3"},"text":"In the world also it is known to some that the industrious have abundant store, and not the idle.","comment":null,"footnote":null}],"slug":"assiduity","url":"/meta/potts/assiduity/"}