{"key":"672b2df028b5acca","source_file":"Potts St - Sy.json","source_id":25493,"source_url":"concordance-strew-ppl-sternere","term":"Strew","headwords":["Strew","Stretched out"],"latin":["Sternere","Substernere","Stratus"],"header_pairs":[{"english":["Strew"],"latin":["Sternere","Substernere"]},{"english":["Stretched out"],"latin":["Stratus"]}],"header_sentences":["See Stratified."],"redirect_xref":null,"works":["AC","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"9212","subsection":"6"},"text":"The multitude strewed their garments in the way... and strewed the branches of trees (). Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9214","subsection":null},"text":"That sensuous things have been laid under interior ones. Signified.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"380","subsection":null},"text":"Ants which... tread a beaten way.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"160","subsection":"2"},"text":"I saw in the north a paved way, crowded with Spirits.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"366","subsection":"2"},"text":"Spiritual defilements bestrew the way.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1063","subsection":"2"},"text":"They rejoice when they see prostrate masses of corpses. SE 3145:end.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1260","subsection":null},"text":"A bier spread with black cloths.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1696","subsection":null},"text":"He was thrown down on the ground horizontally.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3117","subsection":null},"text":"(The fixed situation of some Spirits is) lying stretched out on the ground.","comment":null,"footnote":null}],"slug":"strew","url":"/meta/potts/strew/"}