{"key":"2c979d1876825369","source_file":"Potts Ea - Es.json","source_id":41260,"source_url":"concordance-emulate-ppl-aemulari","term":"Emulate","headwords":["Emulate","Emulation","Emulous"],"latin":["Aemulari","Aemulatio","Aemulus"],"header_pairs":[{"english":["Emulate"],"latin":["Aemulari"]},{"english":["Emulation"],"latin":["Aemulatio"]},{"english":["Emulous"],"latin":["Aemulus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"847","subsection":"end"},"text":"Straitnesses emulous of spiritual temptations.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"17","subsection":null},"text":"(The relaxation) which the cupidity of emulation had induced on some.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"100","subsection":null},"text":"Which emulates the conjugial form of good and truth. It is said that it emulates this, because it is not the same, but is like it...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"248","subsection":null},"text":"The third of the external causes (of cold) is a striving for pre-eminence between the married partners... While this emulation lasts... While they are in the vehemence of their emulation...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"32","subsection":"end"},"text":"How singulars vie with universals...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"339","subsection":null},"text":"Persuasion emulates faith in externals.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"395","subsection":null},"text":"The sight of the body emulates that of the mind.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1398","subsection":null},"text":"So this striving for pre-eminence is continuous, yet not with open hatred.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"996","subsection":"2"},"text":"While their love emulates love truly conjugial...","comment":null,"footnote":null}],"slug":"emulate","url":"/meta/potts/emulate/"}