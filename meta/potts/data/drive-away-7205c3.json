{"key":"7205c3c037cd4f6c","source_file":"Potts Do - Dy.json","source_id":28410,"source_url":"concordance-drive-away-ppl-abigere","term":"Drive away","headwords":["Drive away","Driving away"],"latin":["Abigere","Abactio"],"header_pairs":[{"english":["Drive away"],"latin":["Abigere"]},{"english":["Driving away"],"latin":["Abactio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1398","subsection":null},"text":"One Angel can drive away myriads of evil Spirits...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1835","subsection":null},"text":"Abram drove them away () = that the Lord put them to flight.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5722","subsection":null},"text":"When they are driven away...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6912","subsection":null},"text":"Afterwards, he will let you go = the driving away of those who are in falsities... To let go = to be driven away; for they who are in falsities never let them go... unless they are driven away.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"299","subsection":"end"},"text":"They were driven away, and the anxiety ceased.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"639","subsection":"2"},"text":"While they are driving away the evil Spirits...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3528","subsection":"end"},"text":"They could be driven away... by the power of a little child...","comment":null,"footnote":null}],"slug":"drive-away-7205c3","url":"/meta/potts/drive-away-7205c3/"}