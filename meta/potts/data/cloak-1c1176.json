{"key":"1c11765a3fe58e6a","source_file":"Potts Ci - Cl.json","source_id":10095,"source_url":"concordance-cloak-ppl-amiculum","term":"Cloak","headwords":["Cloak"],"latin":["Amiculum"],"header_pairs":[{"english":["Cloak"],"latin":["Amiculum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","TCR"],"contexts":[{"reference":{"work":"AC","section":"2576","subsection":"9"},"text":"Cloaks, and broidered garments () = Knowledges from scientifics; thus lower truths.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2576","subsection":"13"},"text":"The garments of salvation () = the truths of faith; the robe of righteousness = the good of charity.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3103","subsection":"3"},"text":"The changeable garments and the mantles () = truth, and its badges.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9688","subsection":"4"},"text":"Cloaks () = external truths.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"75","subsection":"2"},"text":"Natural heat and light... serve as a cloak and aid to spiritual heat and light.","comment":null,"footnote":null}],"slug":"cloak-1c1176","url":"/meta/potts/cloak-1c1176/"}