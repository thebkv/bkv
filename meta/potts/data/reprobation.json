{"key":"941e1aaef426a040","source_file":"Potts Re.json","source_id":43694,"source_url":"concordance-reprobation-ppl-reprobatio","term":"Reprobation","headwords":["Reprobation","Reprobate, To"],"latin":["Reprobatio","Reprobare"],"header_pairs":[{"english":["Reprobation"],"latin":["Reprobatio"]},{"english":["Reprobate, To"],"latin":["Reprobare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CanonsNC","TCR"],"contexts":[{"reference":{"work":"AC","section":"9163","subsection":"3"},"text":"They reprobate the truths which are from Him.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9256","subsection":"7"},"text":"The stone which the builders have rejected.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"384","subsection":null},"text":"Those who reprobate the Lord and the Word... Those who reprobate the Word also reprobate the Lord... and those who reprobate either the one or the other, also reprobate the Church... and those who reprobate the Church are outside Heaven.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"205","subsection":"5"},"text":"His reprobation by the Jewish nation. Treated of.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"617","subsection":"8"},"text":"That he may know to reject the evil and choose the good (). Explained.","comment":null,"footnote":null},{"reference":{"work":"CanonsNC","section":"20","subsection":null},"text":"Redeemer. 7. 4. Occurs. 9. 9. Redemption 7. 7.","comment":null,"footnote":null}],"slug":"reprobation","url":"/meta/potts/reprobation/"}