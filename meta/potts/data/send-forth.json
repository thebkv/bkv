{"key":"c5cc6be47a36156a","source_file":"Potts Se.json","source_id":21892,"source_url":"concordance-send-forth-ppl-emittere","term":"Send forth","headwords":["Send forth"],"latin":["Emittere"],"header_pairs":[{"english":["Send forth"],"latin":["Emittere"]}],"header_sentences":["See Emissary."],"redirect_xref":null,"works":["AC","AE","AR"],"contexts":[{"reference":{"work":"AC","section":"878","subsection":"8"},"text":"To put forth the hand = Own power.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2678","subsection":null},"text":"He sent Hagar forth () = that He left it in proprium.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6948","subsection":null},"text":"To cast, or send forth = what proceeds, thus influx.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9272","subsection":"6"},"text":"To send forth the foot of the ox and the donkey () = to be instructed in...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"949","subsection":"2"},"text":"The Lord cannot emit anything from Himself except what is Himself.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"318","subsection":null},"text":"The seven Spirits of God sent forth into all the earth () = all wisdom and intelligence communicated...","comment":null,"footnote":null}],"slug":"send-forth","url":"/meta/potts/send-forth/"}