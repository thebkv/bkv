{"key":"09e7be273a3bc243","source_file":"Potts In.json","source_id":70137,"source_url":"concordance-introspect-ppl-introspicere","term":"Introspect","headwords":["Introspect","Introspection"],"latin":["Introspicere","Introspectio"],"header_pairs":[{"english":["Introspect"],"latin":["Introspicere"]},{"english":["Introspection"],"latin":["Introspectio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","TCR"],"contexts":[{"reference":{"work":"AC","section":"10227","subsection":"3"},"text":"As they cannot look into truths themselves...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"312","subsection":"end"},"text":"Unless the Lord... has given him the opportunity of looking into the Spiritual World...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"561","subsection":"end"},"text":"They lead him away from... introspecting himself...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"564","subsection":null},"text":"That he who has not... introspected and searched himself, at last does not know what damnable evil and saving good are. General article.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"603","subsection":null},"text":"Perception looks into the lower thought.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"260","subsection":null},"text":"a. See Intromit.","comment":null,"footnote":null}],"slug":"introspect","url":"/meta/potts/introspect/"}