{"key":"7d9fb174804270b1","source_file":"Potts Mi - My.json","source_id":29082,"source_url":"concordance-morsel-ppl-offa","term":"Morsel","headwords":["Morsel"],"latin":["Offa","Offula"],"header_pairs":[{"english":["Morsel"],"latin":["Offa","Offula"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","SE","TCR"],"contexts":[{"reference":{"work":"TCR","section":"629","subsection":"end"},"text":"As if God were to deliver some as morsels to the devil.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4946","subsection":null},"text":"She called it a morsel, and gave it him to eat.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"740","subsection":"8"},"text":"To enter into him with the morsel (or sop) () is into the belly; and to enter into the belly is into the thought; and falsities from evil are of the thought.","comment":null,"footnote":null}],"slug":"morsel-7d9fb1","url":"/meta/potts/morsel-7d9fb1/"}