{"key":"9348202f3bd03ad0","source_file":"Potts Et - Ez.json","source_id":30501,"source_url":"concordance-excommunicate-ppl-excommunicare","term":"Excommunicate","headwords":["Excommunicate"],"latin":["Excommunicare"],"header_pairs":[{"english":["Excommunicate"],"latin":["Excommunicare"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","AR","CL","DP","TCR"],"contexts":[{"reference":{"work":"DP","section":"256","subsection":"3"},"text":"They who deny the Divine of the Lord... are excommunicated from the Church.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"264","subsection":null},"text":"(That devil said) In my right hand is the thunderbolt of excommunicating.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"798","subsection":"4"},"text":"I absolve, or I excommunicate.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"14","subsection":null},"text":"That the man who does not acknowledge God is excommunicated from the Church...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"380","subsection":"2"},"text":"The Arian and the Socinian heresies, which are excommunicated from the Christian Church...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"741","subsection":"25"},"text":"They shall excommunicate him out of the world () = to cast out from the good of the Church.","comment":null,"footnote":null}],"slug":"excommunicate","url":"/meta/potts/excommunicate/"}