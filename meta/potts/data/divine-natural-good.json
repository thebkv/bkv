{"key":"6f5420bd04ef2029","source_file":"Potts Di.json","source_id":41021,"source_url":"concordance-divine-natural-good-ppl-divinum-bonum-naturale","term":"Divine Natural Good","headwords":["Divine Natural Good"],"latin":["Divinum Bonum Naturale"],"header_pairs":[{"english":["Divine Natural Good"],"latin":["Divinum Bonum Naturale"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"4350","subsection":null},"text":"Esau ran to meet him = the influx of Divine natural good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4370","subsection":null},"text":"The Divine things which are to he adjoined to Divine natural good. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4387","subsection":null},"text":"Esau returned in that day to his way to Seir = the state of Divine natural good at that time, to which have been adjoined the goods of truth.","comment":null,"footnote":null}],"slug":"divine-natural-good","url":"/meta/potts/divine-natural-good/"}