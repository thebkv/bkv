{"key":"aaac0491843c93dc","source_file":"Potts Sa - Sc.json","source_id":21756,"source_url":"concordance-scene-ppl-scena","term":"Scene","headwords":["Scene"],"latin":["Scena"],"header_pairs":[{"english":["Scene"],"latin":["Scena"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL","HH","LJCont","TCR"],"contexts":[{"reference":{"work":"AC","section":"1631","subsection":"2"},"text":"But the scene is changed. Described. DP 298.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8118","subsection":"3"},"text":"But this scene has been changed.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"574","subsection":"3"},"text":"Thus is one scene changed into another.","comment":null,"footnote":null},{"reference":{"work":"LJCont","section":"19","subsection":"end"},"text":"Thus have the scenes of these theatres been changed.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"655","subsection":"2"},"text":"Such theatrical scenes are changed into direful infernal ones.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"297","subsection":null},"text":"Thus would marriages be turned into tragic scenes.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"137","subsection":"3"},"text":"Turned the Church into a theatre... within which the actors represented new scenes.","comment":null,"footnote":null}],"slug":"scene","url":"/meta/potts/scene/"}