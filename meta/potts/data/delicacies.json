{"key":"290c42e1417d24c5","source_file":"Potts De.json","source_id":12377,"source_url":"concordance-delicacies-ppl-lautitiae","term":"Delicacies","headwords":["Delicacies"],"latin":["Lautitiae"],"header_pairs":[{"english":["Delicacies"],"latin":["Lautitiae"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DP","TCR"],"contexts":[{"reference":{"work":"AC","section":"10037","subsection":"4"},"text":"They who have eaten delicacies () = those who have the Word, and thence Knowledges of truth.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"254","subsection":"4"},"text":"A peasant would be oppressed at heart... if a table were set before him covered with delicacies...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"394","subsection":null},"text":"Delicacies for the tongue.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"810","subsection":null},"text":"They select something savoury from their Own intelligence, which they roll over in their mouths as delicacies... and so teach.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"652","subsection":"10"},"text":"Delicacies () = genuine truths from the Word.","comment":null,"footnote":null}],"slug":"delicacies","url":"/meta/potts/delicacies/"}