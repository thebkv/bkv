{"key":"c239232447a70d7c","source_file":"Potts Go - Gy.json","source_id":53673,"source_url":"concordance-guest-ppl-advena","term":"Guest","headwords":["Guest"],"latin":["Advena"],"header_pairs":[{"english":["Guest"],"latin":["Advena"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DP","TCR"],"contexts":[{"reference":{"work":"AC","section":"2119","subsection":null},"text":"They are welcome and accepted guests.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7710","subsection":null},"text":"The Lord gifts the new guests with celestial and spiritual good.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"305","subsection":null},"text":"I have heard many new-comers from the world complaining...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"2","subsection":"2"},"text":"Some new guests from the world...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"151","subsection":null},"text":"a [2]. The emissaries had met some new guests from the earth.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"154","subsection":null},"text":"They all turned to the new-comers...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"307","subsection":"2"},"text":"Hither the three new-comers...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"797","subsection":"3"},"text":"With every new-comer Angels are at first associated.","comment":null,"footnote":null}],"slug":"guest-c23923","url":"/meta/potts/guest-c23923/"}