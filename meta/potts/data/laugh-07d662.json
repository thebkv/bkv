{"key":"07d6629fe48d3f3a","source_file":"Potts La - Le.json","source_id":18123,"source_url":"concordance-laugh-ppl-cachinnare","term":"Laugh","headwords":["Laugh","Loud laughter"],"latin":["Cachinnare","Cachinnus"],"header_pairs":[{"english":["Laugh"],"latin":["Cachinnare"]},{"english":["Loud laughter"],"latin":["Cachinnus"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","TCR"],"contexts":[{"reference":{"work":"CL","section":"79","subsection":"7"},"text":"Many in the crowd laughed aloud, mocked at, and jested...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"240","subsection":"2"},"text":"They will perhaps laugh at the mention of love truly conjugial.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"16","subsection":"end"},"text":"On seeing this portent, the bystanders laughed with a loud laugh.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"80","subsection":"4"},"text":"He replied, with a loud laugh...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"172","subsection":"2"},"text":"For who does not laugh at three gods?","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"562","subsection":"2"},"text":"They fled away; some laughing and uttering peals of laughter...","comment":null,"footnote":null}],"slug":"laugh-07d662","url":"/meta/potts/laugh-07d662/"}