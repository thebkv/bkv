{"key":"2cd3c2548974b4d8","source_file":"Potts Ph - Po.json","source_id":7753,"source_url":"concordance-pirate-ppl-pirata","term":"Pirate","headwords":["Pirate","Piratical"],"latin":["Pirata","Piraticus"],"header_pairs":[{"english":["Pirate"],"latin":["Pirata"]},{"english":["Piratical"],"latin":["Piraticus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","Char","DP","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"5387","subsection":null},"text":"He had been addicted to piratical practices.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5387","subsection":"2"},"text":"(The character and correspondence of a pirate.)","comment":null,"footnote":null},{"reference":{"work":"DP","section":"199","subsection":null},"text":"So a pirate, when he sees vessels.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"511","subsection":null},"text":"They are like robbers and pirates...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"148","subsection":null},"text":"Like pirates, who on land are men; but at sea are crocodiles.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"317","subsection":null},"text":"To act the pirate in time of peace.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"380","subsection":"4"},"text":"Like pirates who hang out the flag of a kingdom at peace; but when a ship approaches... hoist a piratical flag...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2953","subsection":null},"text":"Concerning pirates, or sea robbers. Explained.","comment":null,"footnote":null},{"reference":{"work":"Char","section":"170","subsection":null},"text":"They hold no share with pirates.","comment":null,"footnote":null}],"slug":"pirate","url":"/meta/potts/pirate/"}