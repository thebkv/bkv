{"key":"8535d1dda724f00f","source_file":"Potts St - Sy.json","source_id":47950,"source_url":"concordance-susceptible-ppl-susceptibilis","term":"Susceptible","headwords":["Susceptible","Susceptibility"],"latin":["Susceptibilis","Susceptibilitas"],"header_pairs":[{"english":["Susceptible"],"latin":["Susceptibilis"]},{"english":["Susceptibility"],"latin":["Susceptibilitas"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"1573","subsection":"7"},"text":"The Divine is not susceptible of evil.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8114","subsection":null},"text":"They were susceptible of receiving a state of still more interior happiness.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"189","subsection":null},"text":"These forms... are vital, and thus susceptible.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"987","subsection":null},"text":"The susceptibility of this idea is varied according to the faculties of the Spirit.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1275","subsection":null},"text":"He was susceptible of no reason.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1478","subsection":null},"text":"Souls, after the death of the body, are susceptible of many things in each idea... This susceptibility increases...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1479","subsection":null},"text":"But the Angels are so susceptible that it can never be expressed...","comment":null,"footnote":null}],"slug":"susceptible","url":"/meta/potts/susceptible/"}