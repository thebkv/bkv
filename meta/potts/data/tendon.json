{"key":"50108b9ec3fb478e","source_file":"Potts Ta - Ti.json","source_id":19485,"source_url":"concordance-tendon-ppl-tendo","term":"Tendon","headwords":["Tendon","Tendinous"],"latin":["Tendo","Tendinosus"],"header_pairs":[{"english":["Tendon"],"latin":["Tendo"]},{"english":["Tendinous"],"latin":["Tendinosus"]}],"header_sentences":[],"redirect_xref":null,"works":["DLW","HH","SE"],"contexts":[{"reference":{"work":"HH","section":"466","subsection":null},"text":"Their callosity appears... within as of striated tendons.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"304","subsection":null},"text":"Fibres proceed from their first forms until at last they become tendons.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3457","subsection":null},"text":"They acted like a sinew which acts only as it is relaxed.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5535","subsection":null},"text":"a. As when a tendon is twisted back and recoils.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5575","subsection":null},"text":"The celestials correspond... to the flesh, even to the tendinous things...","comment":null,"footnote":null}],"slug":"tendon","url":"/meta/potts/tendon/"}