{"key":"19454efd7461887a","source_file":"Potts Fa - Fe.json","source_id":30944,"source_url":"concordance-fast-ppl-jejunare","term":"Fast","headwords":["Fast","Fasting","Fasting"],"latin":["Jejunare","Jejunium","Jejunus","Jejunatio"],"header_pairs":[{"english":["Fast"],"latin":["Jejunare","Jejunium"]},{"english":["Fasting"],"latin":["Jejunus"]},{"english":["Fasting"],"latin":["Jejunatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"4293","subsection":"3"},"text":"They could fast for many days...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4779","subsection":"end"},"text":"Jejunium, occurs.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9050","subsection":"7"},"text":"A fasting soul () = a longing to learn the goods... of faith.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9182","subsection":"10"},"text":"They will fast when the bridegroom is taken away from them () = that they are in an unhappy state when good is no longer conjoined with truths.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"375","subsection":"24"},"text":"To fast = to mourn; because they fasted when they mourned.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"730","subsection":"41"},"text":"Fasting () = affliction, such as exists in the combats of temptations.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"750","subsection":"10"},"text":"A fasting soul = no understanding of good.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1189","subsection":"2"},"text":"To fast = to mourn on account of the failure of truth and good.","comment":null,"footnote":null}],"slug":"fast","url":"/meta/potts/fast/"}