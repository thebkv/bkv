{"key":"37a821c22ff239c8","source_file":"Potts To - Ty.json","source_id":18622,"source_url":"concordance-triple-ppl-triplex","term":"Triple","headwords":["Triple","Triplicate","Triplication","Triplicity","Triplicate, To"],"latin":["Triplex","Triplicatus","Triplicatio","Triplicitas","Triplicare"],"header_pairs":[{"english":["Triple"],"latin":["Triplex"]},{"english":["Triplicate"],"latin":["Triplicatus"]},{"english":["Triplication"],"latin":["Triplicatio"]},{"english":["Triplicity"],"latin":["Triplicitas"]},{"english":["Triplicate, To"],"latin":["Triplicare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","CL","DLW","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"4154","subsection":null},"text":"The goods and truths of the internal man are of triple degree... (Those) of the external man are also of triple degree.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10217","subsection":"8"},"text":"The triplication of the number six involves the end.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"586","subsection":null},"text":"Most of the Hells are triplicate.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"190","subsection":"end"},"text":"Compaginations and conglobations in triple order.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"203","subsection":"end"},"text":"In a triplicate ratio. DP 34:2.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"212","subsection":null},"text":"In a triplicate series.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"235","subsection":null},"text":"The triple ascent of the degrees of height.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"245","subsection":null},"text":"Forms in a triple order, or of three degrees.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"247","subsection":null},"text":"The triplication involves all the Holy in Himself alone.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"416","subsection":null},"text":"The triplication makes the superlative. Explained.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"610","subsection":null},"text":"Triplication completes.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"484","subsection":null},"text":"On triplicate adultery.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"147","subsection":null},"text":"A duplicity and a triplicity in every created thing. Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"847","subsection":null},"text":"That all these things may be signified to the full, the number is triplicated; and by the triplication the number 666 arises. For by what is triplicate is signified completeness and fulness from beginning to end.","comment":null,"footnote":null}],"slug":"triple","url":"/meta/potts/triple/"}