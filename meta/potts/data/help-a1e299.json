{"key":"a1e29958f6f24da5","source_file":"Potts Hi - Hy.json","source_id":11501,"source_url":"concordance-help-ppl-auxilium","term":"Help","headwords":["Help","Helper"],"latin":["Auxilium","Auxiliator"],"header_pairs":[{"english":["Help"],"latin":["Auxilium"]},{"english":["Helper"],"latin":["Auxiliator"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"140","subsection":null},"text":"A help as with him () = the proprium... AC 142:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2691","subsection":null},"text":"Help then. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2694","subsection":null},"text":"Hope of help. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5005","subsection":null},"text":"Without the help of anyone. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8652","subsection":null},"text":"The God of my father was my help () = the mercy and presence of the Lord in the Church.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8652","subsection":null},"text":"Help, predicated of the Lord, = mercy; for help from Him is of mercy; and it also = presence, for where there is the reception of mercy there is presence...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"176","subsection":null},"text":"For mutual help...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3528","subsection":"2"},"text":"Immediate help is not according to order...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3681","subsection":null},"text":"How the Lord... affords help in a moment...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"406","subsection":"13"},"text":"Occurs. AE 654:42.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"654","subsection":"39"},"text":"Helpers () = confirmations of truth...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"684","subsection":"21"},"text":"I have laid help upon one that is mighty () = the Divine truth through which Divine good operates all things.","comment":null,"footnote":null}],"slug":"help-a1e299","url":"/meta/potts/help-a1e299/"}