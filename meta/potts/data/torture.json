{"key":"6b0dabe43075dc93","source_file":"Potts To - Ty.json","source_id":5289,"source_url":"concordance-torture-ppl-tortura","term":"Torture","headwords":["Torture","Torture, To","Wrenching, A"],"latin":["Tortura","Torquere","Torsio"],"header_pairs":[{"english":["Torture"],"latin":["Tortura"]},{"english":["Torture, To"],"latin":["Torquere"]},{"english":["Wrenching, A"],"latin":["Torsio"]}],"header_sentences":["See Torment, and Twist."],"redirect_xref":null,"works":["AC","AR","DLW","DMin","DeConj","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"4299","subsection":"2"},"text":"When Angels look at them, they are tortured.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5071","subsection":null},"text":"By these fires the infernals torture one another in direful ways.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5389","subsection":null},"text":"With a certain kind of torture.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7643","subsection":"9"},"text":"They tortured them five months () = they vastated them.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"400","subsection":"end"},"text":"If he puts a finger out he is tortured and tormented.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"263","subsection":"end"},"text":"A spiral twisting itself...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"691","subsection":null},"text":"That love to the Lord tortured them. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"453","subsection":null},"text":"That there are Souls who love to be punished and tortured. Explained.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"867","subsection":null},"text":"On the torture of Spirits who desire to be high.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1806","subsection":null},"text":"This causes great torture.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2643","subsection":null},"text":"One loves to torture another, even his greatest friend.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4511","subsection":null},"text":"Punished by various tortures.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5214","subsection":null},"text":"They tormented them with various tortures.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4564","subsection":null},"text":"Could not be restrained, except by tortures.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4658","subsection":null},"text":"He racked my body by twisting it... It was a peculiar method of wrenching.","comment":null,"footnote":null},{"reference":{"work":"DeConj","section":"97","subsection":null},"text":"They become as cold as ice, by which they are miserably tortured.","comment":null,"footnote":null}],"slug":"torture","url":"/meta/potts/torture/"}