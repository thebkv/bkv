{"key":"8e76bc364c0406f8","source_file":"Potts Re.json","source_id":11589,"source_url":"concordance-recite-ppl-recitare","term":"Recite","headwords":["Recite"],"latin":["Recitare"],"header_pairs":[{"english":["Recite"],"latin":["Recitare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DMin","DSS","SE"],"contexts":[{"reference":{"work":"AC","section":"2481","subsection":null},"text":"Reciting a whole letter...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2483","subsection":null},"text":"His adulteries... were recited in a series.","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"64","subsection":"2"},"text":"They recite some sayings from the sense of the letter... AE 832:2.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2155","subsection":null},"text":"They could recite every word... which I had written many years before.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3489","subsection":null},"text":"They recited of what quality I had been.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4574","subsection":null},"text":"Some listen... merely in order that they may recite what they have heard.","comment":null,"footnote":null}],"slug":"recite","url":"/meta/potts/recite/"}