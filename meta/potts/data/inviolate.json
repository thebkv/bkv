{"key":"e0428b6c6c5816d2","source_file":"Potts In.json","source_id":71842,"source_url":"concordance-inviolate-ppl-illibatus","term":"Inviolate","headwords":["Inviolate"],"latin":["Illibatus"],"header_pairs":[{"english":["Inviolate"],"latin":["Illibatus"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","CL","DLW","DP","SE"],"contexts":[{"reference":{"work":"DLW","section":"355","subsection":null},"text":"Can any man of unimpaired reason fail to see...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"96","subsection":null},"text":"That the Lord keeps these two faculties inviolate, and as holy...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"502","subsection":null},"text":"On the state of a virgin or undeflowered woman...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6054","subsection":null},"text":"Adulteries are of... an unmarried man with... an undeflowered virgin...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6106","subsection":"2"},"text":"There are some who love violations, and thus the undeflowered state...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"974","subsection":"2"},"text":"Like nuts devoured by maggots internally, the shells of which are uninjured.","comment":null,"footnote":null}],"slug":"inviolate","url":"/meta/potts/inviolate/"}