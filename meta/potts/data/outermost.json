{"key":"a98861cfb862a4ca","source_file":"Potts O.json","source_id":36425,"source_url":"concordance-outermost-ppl-extimus","term":"Outermost","headwords":["Outermost"],"latin":["Extimus"],"header_pairs":[{"english":["Outermost"],"latin":["Extimus"]}],"header_sentences":["See Extreme."],"redirect_xref":null,"works":["AC","AE","DP"],"contexts":[{"reference":{"work":"AC","section":"1718","subsection":null},"text":"These (senses, etc.) constitute the outermost...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3695","subsection":"2"},"text":"The outermost is most general.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4154","subsection":"2"},"text":"Interior things can never be seen from outermost things; but outermost things from interior ones.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4459","subsection":"7"},"text":"(The Jews) are in outermost or lowest things...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6436","subsection":null},"text":"The feet and soles = outermost things.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"180","subsection":"3"},"text":"(Thus) there is a perpetual connection of outermost things with inmost ones; and therefore as the outermost acts or is acted upon, so also do the interiors from the inmosts act or be acted upon. Example(s).","comment":null,"footnote":null},{"reference":{"work":"AE","section":"195","subsection":"11"},"text":"Outermost darkness = falsities from evil.","comment":null,"footnote":null}],"slug":"outermost","url":"/meta/potts/outermost/"}