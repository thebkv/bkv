{"key":"17218bd6d3969955","source_file":"Potts Re.json","source_id":36669,"source_url":"concordance-rend-ppl-lacerare","term":"Rend","headwords":["Rend","Rending, A","Rent"],"latin":["Lacerare","Laceratio","Laceratus","Lacerus"],"header_pairs":[{"english":["Rend"],"latin":["Lacerare"]},{"english":["Rending, A"],"latin":["Laceratio"]},{"english":["Rent"],"latin":["Laceratus","Lacerus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"956","subsection":null},"text":"The penalty of rending. SE 2746. SE 4236. SE 4419. SE 4420.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2576","subsection":"16"},"text":"Truth thus rent. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9916","subsection":null},"text":"That it be not rent () = safe from injury.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10536","subsection":"2"},"text":"The garments of those in (mere) externals are dirty and tattered...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"182","subsection":null},"text":"The infernals, being without truths, appear in garments ragged...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2692","subsection":null},"text":"A sphere as of particles of rent garments...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3057","subsection":null},"text":"They appeared as if their garments were torn.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3297","subsection":null},"text":"They lacerated some one who was their god... SE 3298.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3366","subsection":null},"text":"By phantasies they lacerated, rent, and tore to pieces, the Lord.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4087","subsection":"end"},"text":"(Cause of the appearance of rendings, etc.)","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1044","subsection":"4"},"text":"Lest they turn and rend you () = to cover with ignominy and contumely.","comment":null,"footnote":null}],"slug":"rend-17218b","url":"/meta/potts/rend-17218b/"}