{"key":"2ad27a1d2afd13f1","source_file":"Potts Rh - Ry.json","source_id":17876,"source_url":"concordance-rude-ppl-rudis","term":"Rude","headwords":["Rude","Ignorance"],"latin":["Rudis","Ruditas"],"header_pairs":[{"english":["Rude"],"latin":["Rudis"]},{"english":["Ignorance"],"latin":["Ruditas"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"3909","subsection":null},"text":"The things in the sense of the letter are relatively rude.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4379","subsection":null},"text":"These arcana are open... as to some rude image...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8149","subsection":"end"},"text":"Thus are the very ignorances of falsity wiped away.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1935","subsection":null},"text":"Thus the Knowledges of Truths with men (are) vessels... rude, nay the rudest.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2185","subsection":null},"text":"They said... that the things I have written are so rude and gross...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6042","subsection":null},"text":"In his chamber are many things which are rude and sad.","comment":null,"footnote":null}],"slug":"rude","url":"/meta/potts/rude/"}