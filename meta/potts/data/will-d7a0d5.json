{"key":"d7a0d51730e49b3c","source_file":"Potts Wi.json","source_id":11358,"source_url":"concordance-will-ppl-arbitrium","term":"Will","headwords":["Will","Arbitrary","Think"],"latin":["Arbitrium","Arbitrarius","Arbitrari"],"header_pairs":[{"english":["Will"],"latin":["Arbitrium"]},{"english":["Arbitrary"],"latin":["Arbitrarius"]},{"english":["Think"],"latin":["Arbitrari"]}],"header_sentences":["See Free Will."],"redirect_xref":null,"works":["AC","AE","AR","CL","DLW","DP","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"9378","subsection":"2"},"text":"To desist from evils has been left to the will or freedom of man.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"412","subsection":"2"},"text":"They then think that...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"128","subsection":null},"text":"They suppose that the Lord confers Heaven at will...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"125","subsection":"2"},"text":"As man acts in ultimates, which are at his disposal...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"799","subsection":null},"text":"By various and arbitrary rights. Signified.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"231","subsection":"2"},"text":"A sign that their judgments were... arbitrary.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"291","subsection":"2"},"text":"They reduce them... into compliance with their will.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"292","subsection":null},"text":"They could not but obey the will (or authoritative commands) of their wives most submissively.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"292","subsection":"2"},"text":"After yielding to their authoritative commands, the husbands submit.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"320","subsection":"2"},"text":"They are then in full freedom to...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"322","subsection":"end"},"text":"A widow is more at her own disposal.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"17","subsection":"3"},"text":"Each (Divine Person) has his own will, right, and Power.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"106","subsection":null},"text":"When he becomes his own master-,.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"486","subsection":null},"text":"The belief that man... has no free will in spiritual things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3148","subsection":null},"text":"The body is formed in accord with all the determinations of the will.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"735","subsection":"2"},"text":"There are no Archangels in obedience to whom others stand by any authority.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1029","subsection":"2"},"text":"They rejected the Lord... unless He assented to every decision of theirs.","comment":null,"footnote":null}],"slug":"will-d7a0d5","url":"/meta/potts/will-d7a0d5/"}