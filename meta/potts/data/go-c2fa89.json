{"key":"c2fa8955c48c4bf3","source_file":"Potts Go - Gy.json","source_id":852,"source_url":"concordance-go-ppl-vadere","term":"Go","headwords":["Go"],"latin":["Vadere"],"header_pairs":[{"english":["Go"],"latin":["Vadere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","LJ"],"contexts":[{"reference":{"work":"AC","section":"2221","subsection":null},"text":"To go with the three men () = to be still in perception.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3326","subsection":null},"text":"To go to die () = to rise again afterwards.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3415","subsection":null},"text":"To go from being with us () = not to endure the presence.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3533","subsection":null},"text":"To go and to take for me () = to do. AC 3535.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4712","subsection":null},"text":"Go, see the peace of thy brethren () = every advent of the Lord...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6992","subsection":null},"text":"To go, or to go, = life.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7018","subsection":null},"text":"Go in peace. Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7306","subsection":null},"text":"To go, or enter, to Pharaoh = communication.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8580","subsection":null},"text":"To go = to perfect a command.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8823","subsection":null},"text":"To go and strengthen itself () = its increase.","comment":null,"footnote":null},{"reference":{"work":"LJ","section":"32","subsection":null},"text":"He then goes hither and thither.","comment":null,"footnote":null},{"reference":{"work":"LJ","section":"48","subsection":"2"},"text":"When they go from place to place...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"864","subsection":null},"text":"To follow Him whithersoever He goeth () = to acknowledge His Divine and to do His precepts.","comment":null,"footnote":null}],"slug":"go-c2fa89","url":"/meta/potts/go-c2fa89/"}