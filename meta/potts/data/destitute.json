{"key":"e15c92e9599f9cc5","source_file":"Potts De.json","source_id":35015,"source_url":"concordance-destitute-ppl-destitutus","term":"Destitute","headwords":["Destitute"],"latin":["Destitutus"],"header_pairs":[{"english":["Destitute"],"latin":["Destitutus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"1506","subsection":null},"text":"Being deserted by his associates...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"426","subsection":"end"},"text":"Being destitute of phantasies...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"476","subsection":null},"text":"They are entirely destitute of understanding.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"507","subsection":"end"},"text":"If he were destitute of adorers...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"970","subsection":null},"text":"a. They were then deprived of their spiritual food.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2485","subsection":"end"},"text":"Brute animals, being destitute of such a faculty...","comment":null,"footnote":null}],"slug":"destitute","url":"/meta/potts/destitute/"}