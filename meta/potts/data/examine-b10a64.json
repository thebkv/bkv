{"key":"b10a64345c14236f","source_file":"Potts Et - Ez.json","source_id":28713,"source_url":"concordance-examine-ppl-rimari","term":"Examine","headwords":["Examine","Examiner"],"latin":["Rimari","Rimator"],"header_pairs":[{"english":["Examine"],"latin":["Rimari"]},{"english":["Examiner"],"latin":["Rimator"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DLW","DWis","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"9026","subsection":"2"},"text":"He who examines the interiors of the Word...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"212","subsection":null},"text":"Examined and investigated by a sagacious and wise observer...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"403","subsection":"end"},"text":"Only examine the connections well, and survey them with an anatomical eye...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"133","subsection":null},"text":"They heard from the investigators... The investigators said...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"368","subsection":null},"text":"This arcanum... is to be examined in the following order.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"570","subsection":"3"},"text":"They who examine effects; they who investigate causes; and they who explore ends.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1122","subsection":"2"},"text":"He who searches more deeply, is able to know...","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"3","subsection":null},"text":"3. [end]. An industrious examiner can see this, if he investigates.","comment":null,"footnote":null}],"slug":"examine-b10a64","url":"/meta/potts/examine-b10a64/"}