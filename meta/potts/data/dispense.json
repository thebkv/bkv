{"key":"4ed98a392bb0eb48","source_file":"Potts Di.json","source_id":14511,"source_url":"concordance-dispense-ppl-dispensare","term":"Dispense","headwords":["Dispense","Dispensation","Dispensing","Dispenser"],"latin":["Dispensare","Dispensatio","Dispensator"],"header_pairs":[{"english":["Dispense"],"latin":["Dispensare"]},{"english":["Dispensation","Dispensing"],"latin":["Dispensatio"]},{"english":["Dispenser"],"latin":["Dispensator"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","DP","HH","LJPost","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2371","subsection":"2"},"text":"They arrogate to themselves the dispensings of rewards.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4988","subsection":"3"},"text":"He thence knows how to dispense good... according to uses. The doctrine of what is just and fair teaches this dispensing...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"360","subsection":"end"},"text":"On account of their dispensings of what is just and right...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"210","subsection":"2"},"text":"He who faithfully dispenses the goods of his lord.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"280","subsection":null},"text":"The papal dispensations.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"316","subsection":"end"},"text":"He is not a dispenser, but a thief.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"783","subsection":null},"text":"By various dispensations and promises of heavenly joys...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"784","subsection":null},"text":"As to the dispensations by which they get money, they are various. Enumerated.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"799","subsection":"2"},"text":"The dispensations by virtue of the power of the keys. Signified. AR 799:3, Explained.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"364","subsection":"3"},"text":"The atmosphere does not dispense part of itself to...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"412","subsection":"2"},"text":"Dignities are dispensed according to...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"425","subsection":null},"text":"Benefits are dispensed according to...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"459","subsection":"10"},"text":"The gifts which are dispensed to others...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"617","subsection":null},"text":"The crew of devils... manages these affections in a wonderful way...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3428","subsection":null},"text":"Preface. How charity is to be dispensed...","comment":null,"footnote":null},{"reference":{"work":"LJPost","section":"5","subsection":null},"text":"The Italians enjoy this liberty of committing murder, etc. from the dispensations; (but it is otherwise with the English) because there is no dispensation...","comment":null,"footnote":null}],"slug":"dispense","url":"/meta/potts/dispense/"}