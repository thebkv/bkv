{"key":"1d53eac357214dbf","source_file":"Potts U.json","source_id":20141,"source_url":"concordance-use-of-to-make-ppl-usurpare","term":"Use of, To make","headwords":["Use of, To make","Using, A"],"latin":["Usurpare","Usurpatio"],"header_pairs":[{"english":["Use of, To make"],"latin":["Usurpare"]},{"english":["Using, A"],"latin":["Usurpatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2479","subsection":"end"},"text":"Believe that... intelligence perishes with the non-using of the corporeal memory.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"194","subsection":"3"},"text":"To procure intelligence by the using of one's faculties.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"297","subsection":null},"text":"The name of God... is to be constantly made use of in holy things...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"497","subsection":"end"},"text":"According to the use made of his free will...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2989","subsection":null},"text":"They lose nothing but... the making use of the corporeal memory.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3783","subsection":null},"text":"A Spirit is not allowed to make use of the corporeal memory.","comment":null,"footnote":null}],"slug":"use-of-to-make","url":"/meta/potts/use-of-to-make/"}