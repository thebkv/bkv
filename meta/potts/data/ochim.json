{"key":"67c2aedf62e45e88","source_file":"Potts O.json","source_id":7218,"source_url":"concordance-ochim-ppl-ochim","term":"Ochim","headwords":["Ochim"],"latin":["Ochim"],"header_pairs":[{"english":["Ochim"],"latin":["Ochim"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL"],"contexts":[{"reference":{"work":"AC","section":"1326","subsection":"3"},"text":"Ochim, etc. () = the interior things of their worship; for such things are of the love of self, or of the proprium.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"458","subsection":"2"},"text":"By ochim, etc. are signified various concupiscences.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"264","subsection":"4"},"text":"See Ijim. TCR 45:end. AE 1029:14.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"430","subsection":null},"text":"The forms... under which (the lascivious delights of scortatory love) are presented to the view, are... also the birds called ochim and ziim.","comment":null,"footnote":null}],"slug":"ochim","url":"/meta/potts/ochim/"}