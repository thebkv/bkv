{"key":"433d895027caae5f","source_file":"Potts Fa - Fe.json","source_id":37004,"source_url":"concordance-fault-ppl-vitium","term":"Fault","headwords":["Fault","Faulty","Corrupt","Vitiate"],"latin":["Vitium","Vitiosus","Vitiare"],"header_pairs":[{"english":["Fault"],"latin":["Vitium"]},{"english":["Faulty","Corrupt"],"latin":["Vitiosus"]},{"english":["Vitiate"],"latin":["Vitiare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"4225","subsection":null},"text":"Correspond to... blemishes and diseases...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4227","subsection":"3"},"text":"Correspond to corruptions of the purer blood... which the corruptions enter without order...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4657","subsection":null},"text":"They observe the faults and blemishes of others...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4674","subsection":null},"text":"Evil report = blemishes and faults...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5719","subsection":null},"text":"They relate to corruptions of the blood...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5726","subsection":null},"text":"Hence comes the first and inmost vitiation of the blood...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"252","subsection":null},"text":"The first cause of lawful separation is vitiation of mind. Defined.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"253","subsection":null},"text":"The second cause... is vitiation of body. Defined.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"299","subsection":"end"},"text":"By which, marriage love is vitiated in its first heat.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"405","subsection":"end"},"text":"They shut their eyes to their faults.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"300","subsection":"end"},"text":"Convitium.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1696","subsection":"end"},"text":"The penalty evolves itself from the fault... SE 2913.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2157","subsection":"2"},"text":"The faultiness received by inheritance...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2458","subsection":null},"text":"Under Drunk, see this reference.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3547","subsection":null},"text":"Little children (there), are faulty...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4592","subsection":null},"text":"The intemperance of various vices... DMin 4590. Occurs. DMin 4676. DMin 4772. AE 1062:end.","comment":null,"footnote":null}],"slug":"fault-433d89","url":"/meta/potts/fault-433d89/"}