{"key":"83569d2d4af8dda6","source_file":"Potts Aa - Am.json","source_id":7504,"source_url":"concordance-accidental-ppl-fortuitus","term":"Accidental","headwords":["Accidental"],"latin":["Fortuitus"],"header_pairs":[{"english":["Accidental"],"latin":["Fortuitus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DMin","DP"],"contexts":[{"reference":{"work":"AC","section":"5508","subsection":"2"},"text":"What is called accidental etc. is of Providence...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6316","subsection":null},"text":"They attribute everything to prudence, nature and accident.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6493","subsection":null},"text":"When what appeared to be accidental happened to me the Angels said that it happened because such Spirits were near.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6493","subsection":"end"},"text":"What is apparently accidental, or fortune, is Providence in the ultimate of order...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"70","subsection":null},"text":"Accidental and contingent things are vain words.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4758","subsection":null},"text":"On fortune, accidental things, etc.","comment":null,"footnote":null}],"slug":"accidental","url":"/meta/potts/accidental/"}