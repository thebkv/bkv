{"key":"e95c06bd895442c2","source_file":"Potts Ea - Es.json","source_id":56809,"source_url":"concordance-entrance-ppl-introitus","term":"Entrance","headwords":["Entrance"],"latin":["Introitus"],"header_pairs":[{"english":["Entrance"],"latin":["Introitus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"168","subsection":null},"text":"On the entrance of man into eternal life. HH 445.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1443","subsection":"end"},"text":"The entrance of the Sons of Israel (into Canaan) represents the entrance of the faithful into the Lord's Kingdom.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1940","subsection":"2"},"text":"This Inmost is as it were the gate or entrance of the Lord into man.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2145","subsection":null},"text":"The door of the tent = the entrance to what is holy.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4225","subsection":"2"},"text":"Such are admitted only to the first entrance of Heaven... AC 8980.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5553","subsection":null},"text":"Under Cuticle, see this reference.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8977","subsection":null},"text":"Such in the other life are in the entrance to Heaven. AE 798 6.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"39","subsection":null},"text":"This inmost or highest something may be called the entrance of the Lord to Angel and to man.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"435","subsection":"2"},"text":"LJ 25:5.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"338","subsection":null},"text":"The entrances appear like openings in the earth...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"120","subsection":null},"text":"On the entrance (of man into the World of Spirits)...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"494","subsection":null},"text":"The entrance of the Lord into man with Divine goods and truths is there.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"798","subsection":"4"},"text":"The Natural Heaven... may be called the entrance.","comment":null,"footnote":null}],"slug":"entrance-e95c06","url":"/meta/potts/entrance-e95c06/"}