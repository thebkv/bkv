{"key":"6663af271adee9ec","source_file":"Potts To - Ty.json","source_id":12035,"source_url":"concordance-treasures-ppl-gaza","term":"Treasures","headwords":["Treasures","Treasury"],"latin":["Gaza","Gazophylarium"],"header_pairs":[{"english":["Treasures"],"latin":["Gaza"]},{"english":["Treasury"],"latin":["Gazophylarium"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","Coro","LJ","TCR"],"contexts":[{"reference":{"work":"LJ","section":"61","subsection":"6"},"text":"See Last Judgment. SE 5295. SE 5412. SE 5652.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"3","subsection":"5"},"text":"Heavenly joys supposed to consist in the richest treasures. CL 7.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"7","subsection":"4"},"text":"There are (indeed) in the Heavens the richest treasures...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"245","subsection":"2"},"text":"Like treasures with the king of Persia...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"701","subsection":"2"},"text":"See Treasure.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"21","subsection":null},"text":"The doctrine of redemption is like a treasury of all the spiritual riches or dogmas of the New Church.","comment":null,"footnote":null}],"slug":"treasures","url":"/meta/potts/treasures/"}