{"key":"a1a7ee850afa97b8","source_file":"Potts Go - Gy.json","source_id":53740,"source_url":"concordance-guest-ppl-hospes","term":"Guest","headwords":["Guest"],"latin":["Hospes"],"header_pairs":[{"english":["Guest"],"latin":["Hospes"]}],"header_sentences":[],"redirect_xref":null,"works":["5M","AC","CL","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1631","subsection":null},"text":"At first all are received in the other life as guests...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6916","subsection":null},"text":"From the guests of her house () = the affection of good, which also they have.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10736","subsection":null},"text":"Sometimes guests come to them (from our Earth).","comment":null,"footnote":null},{"reference":{"work":"HH","section":"71","subsection":"end"},"text":"The Angels long for nothing more than that new Angel guests should come to them.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"10","subsection":"2"},"text":"Lo a new guest not clad in a garment of Heaven!","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4233","subsection":null},"text":"As when they say to a guest that his coming is welcome...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4234","subsection":"end"},"text":"They treat their departing guests in this manner.","comment":null,"footnote":null},{"reference":{"work":"5M","section":"7","subsection":null},"text":"On hearing these things the new guests are amazed...","comment":null,"footnote":null}],"slug":"guest-a1a7ee","url":"/meta/potts/guest-a1a7ee/"}