{"key":"11b8b1248f9945d1","source_file":"Potts St - Sy.json","source_id":8840,"source_url":"concordance-stated-ppl-status","term":"Stated","headwords":["Stated"],"latin":["Status"],"header_pairs":[{"english":["Stated"],"latin":["Status"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DLW","DP","HH"],"contexts":[{"reference":{"work":"AC","section":"8070","subsection":null},"text":"See Statute.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"159","subsection":"2"},"text":"These alternations (of state) are not stated; but come more slowly or quickly...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"70","subsection":null},"text":"For the spaces and times there are not stated as they are here. DLW 321:end.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"165","subsection":null},"text":"A dead sun was created that in ultimates all things may be fixed, stated, and constant.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"220","subsection":"2"},"text":"Hence the Angels have ultimates, which in themselves are fixed and stated.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1218","subsection":"2"},"text":"Material things are stated, because they recur regularly...","comment":null,"footnote":null}],"slug":"stated","url":"/meta/potts/stated/"}