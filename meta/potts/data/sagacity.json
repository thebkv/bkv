{"key":"697ac9663e8fdcb8","source_file":"Potts Sa - Sc.json","source_id":4344,"source_url":"concordance-sagacity-ppl-sagacitas","term":"Sagacity","headwords":["Sagacity","Sagacious"],"latin":["Sagacitas","Sagax"],"header_pairs":[{"english":["Sagacity"],"latin":["Sagacitas"]},{"english":["Sagacious"],"latin":["Sagax"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DLW","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"4624","subsection":null},"text":"Hence to be keen-scented, is predicated of those who by divination come near the point, and also of those who perceive.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7454","subsection":"2"},"text":"Which sphere is smelt by keen-scented beasts.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"403","subsection":"2"},"text":"Consult those sagacious in anatomy.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"163","subsection":null},"text":"The things of the rational wisdom of men are called... in special, sagacity, etc.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"315","subsection":"3"},"text":"Five (youths) were found who excelled in sagacity.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"380","subsection":"end"},"text":"He spoke... with a new sagacity of cleverness.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"699","subsection":null},"text":"The most sagacious men of the Church have taught...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2181","subsection":null},"text":"Occurs. SE 2252.","comment":null,"footnote":null}],"slug":"sagacity","url":"/meta/potts/sagacity/"}