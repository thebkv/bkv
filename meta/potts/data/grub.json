{"key":"9bef4c2e12b526bb","source_file":"Potts Go - Gy.json","source_id":51948,"source_url":"concordance-grub-ppl-blatta","term":"Grub","headwords":["Grub"],"latin":["Blatta"],"header_pairs":[{"english":["Grub"],"latin":["Blatta"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","TCR"],"contexts":[{"reference":{"work":"AC","section":"9331","subsection":"7"},"text":"The moth = falsities in the extremes; and the grub () = evils there.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"329","subsection":null},"text":"They saw a moth running upon my paper...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"54","subsection":"end"},"text":"Every worm even to a grub.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"376","subsection":"2"},"text":"Like pictures upon paper, which the grubs consume.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"508","subsection":"3"},"text":"Obliterated as writing on paper by bookworms tineis, and the wool of a piece of cloth by caterpillars.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"617","subsection":null},"text":"Like merchandise... gnawed by mice and grubs.","comment":null,"footnote":null}],"slug":"grub","url":"/meta/potts/grub/"}