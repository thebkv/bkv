{"key":"c8c08d4beec165bd","source_file":"Potts Ta - Ti.json","source_id":26302,"source_url":"concordance-thin-ppl-tenuis","term":"Thin","headwords":["Thin","Thinness"],"latin":["Tenuis","Tenuitas"],"header_pairs":[{"english":["Thin"],"latin":["Tenuis"]},{"english":["Thinness"],"latin":["Tenuitas"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","HH"],"contexts":[{"reference":{"work":"AC","section":"8443","subsection":"end"},"text":"(This cloud appears) in density or tenuity according to the quality of the Truths.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"120","subsection":null},"text":"The Angels are covered over with a thin cloud...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"182","subsection":"6"},"text":"(The Greeks said) We believed that Souls were... thin, because spiritual.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"799","subsection":"15"},"text":"Who stretcheth out the heavens as something thin () = omnipotence to enlarge the Heavens at will.","comment":null,"footnote":null}],"slug":"thin-c8c08d","url":"/meta/potts/thin-c8c08d/"}