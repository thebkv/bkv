{"key":"742ed2239439ee7a","source_file":"Potts Rh - Ry.json","source_id":17201,"source_url":"concordance-round-ppl-rotundus","term":"Round","headwords":["Round"],"latin":["Rotundus"],"header_pairs":[{"english":["Round"],"latin":["Rotundus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","TCR"],"contexts":[{"reference":{"work":"AC","section":"7484","subsection":null},"text":"A certain round fruit...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8243","subsection":null},"text":"(The round faces of the inhabitants of Jupiter.)","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8458","subsection":null},"text":"A small round thing () = the good of truth. Round is predicated of good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8458","subsection":"2"},"text":"Good is (there) presented as round, which is continuous in its form. AC 9717:2.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"268","subsection":"2"},"text":"(Those who are in the phantasy of the possession of all the wealth of the world) appear with round faces...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"86","subsection":null},"text":"The Divine good is like the round hilt of a sword.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"503","subsection":null},"text":"A round temple like that at Rome called the Pantheon, seen.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"253","subsection":"7"},"text":"Round () = the corresponding good.","comment":null,"footnote":null}],"slug":"round","url":"/meta/potts/round/"}