{"key":"bddb488182084218","source_file":"Potts V.json","source_id":28009,"source_url":"concordance-vulture-ppl-vultur","term":"Vulture","headwords":["Vulture"],"latin":["Vultur"],"header_pairs":[{"english":["Vulture"],"latin":["Vultur"]}],"header_sentences":[],"redirect_xref":null,"works":["Coro","TCR"],"contexts":[{"reference":{"work":"TCR","section":"123","subsection":"4"},"text":"As if he felt a vulture in his bosom...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"381","subsection":"end"},"text":"As to faith they appear like vultures.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"501","subsection":"end"},"text":"Like vultures over cocks.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"40","subsection":null},"text":"A man who has no religion, is, in spiritual things, like a starving vulture devouring its own offspring.","comment":null,"footnote":null}],"slug":"vulture","url":"/meta/potts/vulture/"}