{"key":"3206097ab4ec4281","source_file":"Potts Aa - Am.json","source_id":15380,"source_url":"concordance-adjure-ppl-adjurare","term":"Adjure","headwords":["Adjure","Adjuration"],"latin":["Adjurare","Adjuratio"],"header_pairs":[{"english":["Adjure"],"latin":["Adjurare"]},{"english":["Adjuration"],"latin":["Adjuratio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"3023","subsection":null},"text":"To adjure = to bind by an oath, for adjuration is nothing but binding.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3046","subsection":null},"text":"To adjure = most sacred binding, thus a solemn obligation. AC 3154:3.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6514","subsection":null},"text":"To adjure = to bind inwardly, here, to have at heart. AC 6520.","comment":null,"footnote":null}],"slug":"adjure","url":"/meta/potts/adjure/"}