{"key":"26aefb83c17ff564","source_file":"Potts Sh - So.json","source_id":4612,"source_url":"concordance-shell-ppl-crusta","term":"Shell","headwords":["Shell","Crustaceous"],"latin":["Crusta","Crustaceus"],"header_pairs":[{"english":["Shell"],"latin":["Crusta"]},{"english":["Crustaceous"],"latin":["Crustaceus"]}],"header_sentences":["See Peel."],"redirect_xref":null,"works":["AC","CL","LJ","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1200","subsection":"end"},"text":"Like a shell without a kernel. AC 6587:end. AC 10331:5.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1500","subsection":null},"text":"Like things crustaceous and scaly, which separate themselves of their own accord.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1718","subsection":null},"text":"The body is as it were a crust.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4844","subsection":"13"},"text":"Like a shell without a kernel.","comment":null,"footnote":null},{"reference":{"work":"LJ","section":"61","subsection":"7"},"text":"A black crust (on that sea).","comment":null,"footnote":null},{"reference":{"work":"CL","section":"140","subsection":"2"},"text":"Like a shell painted with shapes in various colours.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"267","subsection":"3"},"text":"His shell or body is wise; his kernel or spirit is insane.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"364","subsection":"end"},"text":"Their externals are like their shells.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"109","subsection":"3"},"text":"Like the rind of some fruit.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1024","subsection":null},"text":"It is falsities which harden such crusts. SE 1025.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2896","subsection":null},"text":"His simplest idea was this crust.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2947","subsection":null},"text":"(Such faith) is only a shell.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3611","subsection":null},"text":"Like oyster shells... Thus [they are] crustaceous.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3696","subsection":null},"text":"The life of persuasions constitutes the shell; and the life of nature the kernel.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3804","subsection":null},"text":"He received as it were a new shell...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4356","subsection":null},"text":"He projected himself as serpents do from their skin or slough.","comment":null,"footnote":null}],"slug":"shell-26aefb","url":"/meta/potts/shell-26aefb/"}