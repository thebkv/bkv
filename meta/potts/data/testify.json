{"key":"cda6b965e2e81cfa","source_file":"Potts Ta - Ti.json","source_id":22569,"source_url":"concordance-testify-ppl-testificare","term":"Testify","headwords":["Testify","Testification"],"latin":["Testificare","Testificatio"],"header_pairs":[{"english":["Testify"],"latin":["Testificare"]},{"english":["Testification"],"latin":["Testificatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","CL","CanonsNC","DP"],"contexts":[{"reference":{"work":"AC","section":"5028","subsection":null},"text":"Testification. Signified, Explained. AC 5654. AC 5919. AC 5920:end, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7876","subsection":null},"text":"That this is a testification of the will of good. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9293","subsection":null},"text":"For deeds are testifications of such things as as are of the will.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"212","subsection":"end"},"text":"Ocular testification.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"960","subsection":null},"text":"The Lord... testifying this Gospel... Signified.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"300","subsection":"2"},"text":"These pledges are testifications. Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":null},"text":"A Divine testification concerning the future Church, and concerning the reception of its doctrine. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":"4"},"text":"Signs = testifications which indicate and persuade... Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":"9"},"text":"Therefore a manifest testification was not given them from Heaven. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":"12"},"text":"A testification that they might believe. Signified.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"824","subsection":null},"text":"Testifications and persuasions. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"826","subsection":null},"text":"To persuade... by testifications from the Word... Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"838","subsection":null},"text":"A testification of acknowledgement that they are of the Church. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"CanonsNC","section":"45","subsection":null},"text":"Trinity. 8. 4. A plurality of Gods may be confirmed by... there are three that bear witness in Heaven...","comment":null,"footnote":null}],"slug":"testify","url":"/meta/potts/testify/"}