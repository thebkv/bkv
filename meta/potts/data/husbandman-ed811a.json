{"key":"ed811a1924fa7587","source_file":"Potts Hi - Hy.json","source_id":60695,"source_url":"concordance-husbandman-ppl-agricola","term":"Husbandman","headwords":["Husbandman"],"latin":["Agricola"],"header_pairs":[{"english":["Husbandman"],"latin":["Agricola"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DP","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"368","subsection":null},"text":"Husbandmen () = worshippers.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"254","subsection":"4"},"text":"It is comparatively like a husbandman and a king...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"483","subsection":"3"},"text":"As in the parable of the husbandmen in the vineyard.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2513","subsection":null},"text":"If a husbandman were set in a royal palace... he would long to return to his own cottage...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"374","subsection":"4"},"text":"Husbandmen () = those who are of the Church.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"644","subsection":"11"},"text":"Husbandmen () = those who teach.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"652","subsection":"18"},"text":"Husbandman () = the man of the Church; because a field = the Church as to the implantation of truth.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"863","subsection":"8"},"text":"The husbandman and his yoke () = like things.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"911","subsection":"13"},"text":"Husbandmen () = those who are in the good of the Church; vinedressers, those who are in its truths.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"922","subsection":"7"},"text":"Husbandmen () = that people.","comment":null,"footnote":null}],"slug":"husbandman-ed811a","url":"/meta/potts/husbandman-ed811a/"}