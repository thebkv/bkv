{"key":"dd00f864d3bc52dc","source_file":"Potts Fl - Fu.json","source_id":1809,"source_url":"concordance-flattery-ppl-assentatio","term":"Flattery","headwords":["Flattery","Flatterer"],"latin":["Assentatio","Assentator"],"header_pairs":[{"english":["Flattery"],"latin":["Assentatio"]},{"english":["Flatterer"],"latin":["Assentator"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","DP","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"5388","subsection":null},"text":"Flatteries differ according to the ends...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"499","subsection":null},"text":"This is evident from pretenders and flatterers.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"393","subsection":null},"text":"(The cardiac and pulmonic motions) with hypocrites, flatterers, deceivers.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"89","subsection":"2"},"text":"Thus he acts the hypocrite and flatterer.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"104","subsection":"2"},"text":"A flatterer and a hypocrite have a double thought.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"111","subsection":null},"text":"Hence come pretences, flatteries, and hypocrisies... TCR 592:end.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"448","subsection":"2"},"text":"I have seen such bindings... of many with flatterers...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1169","subsection":null},"text":"Such Spirits insinuate themselves into the affections of everyone... flattering them...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2120","subsection":null},"text":"Flattery by external things is not tolerated there...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2500","subsection":null},"text":"They make familiars for themselves by flattery.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2503","subsection":null},"text":"This... may be called the deceit of flatterers. SE 2504.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5533","subsection":"end"},"text":"Some introduce themselves, by flatteries, into Societies of the simple good.","comment":null,"footnote":null}],"slug":"flattery","url":"/meta/potts/flattery/"}