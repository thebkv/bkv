{"key":"7fa0cbbc6354c022","source_file":"Potts U.json","source_id":20199,"source_url":"concordance-useless-ppl-inutilis","term":"Useless","headwords":["Useless"],"latin":["Inutilis"],"header_pairs":[{"english":["Useless"],"latin":["Inutilis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","Char","DLife"],"contexts":[{"reference":{"work":"AC","section":"503","subsection":null},"text":"There can be no life in what is useless; for whatever is useless, is cast away.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1509","subsection":"end"},"text":"In the other life, such are useless members, and are cast out.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1937","subsection":"2"},"text":"Such are as it were without proprium... and are therefore among the more useless Spirits. Described.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3951","subsection":"2"},"text":"By renouncing worldly things... they render themselves useless...","comment":null,"footnote":null},{"reference":{"work":"DLife","section":"30","subsection":"end"},"text":"Such are called useless servants ().","comment":null,"footnote":null},{"reference":{"work":"AR","section":"153","subsection":"9"},"text":"As they cannot be brought to their works... they are cast out as useless.","comment":null,"footnote":null},{"reference":{"work":"Char","section":"128","subsection":null},"text":"See Use.","comment":null,"footnote":null}],"slug":"useless","url":"/meta/potts/useless/"}