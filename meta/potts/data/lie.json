{"key":"2685917397e1065e","source_file":"Potts Li.json","source_id":1810,"source_url":"concordance-lie-ppl-jacere","term":"Lie","headwords":["Lie"],"latin":["Jacere"],"header_pairs":[{"english":["Lie"],"latin":["Jacere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"5376","subsection":"3"},"text":"To lie in the head of all the streets () = that truths appear to be dispersed. AE 652:24. AE 863:3.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9942","subsection":"13"},"text":"To cast a lot.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"433","subsection":null},"text":"While they are lying upon the bier...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"527","subsection":null},"text":"When the life of their love was taken away, they lay as if dead.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5200","subsection":null},"text":"They lie (there) like corpses... SE 5634.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"315","subsection":"4"},"text":"Occurs. AE 405:31.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1147","subsection":"2"},"text":"They lie like new-born infants...","comment":null,"footnote":null}],"slug":"lie","url":"/meta/potts/lie/"}