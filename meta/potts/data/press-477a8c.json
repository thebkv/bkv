{"key":"477a8ce527b44eba","source_file":"Potts Pr - Py.json","source_id":11773,"source_url":"concordance-press-ppl-premere","term":"Press","headwords":["Press","Pressure"],"latin":["Premere","Pressio","Circumpressio"],"header_pairs":[{"english":["Press"],"latin":["Premere"]},{"english":["Pressure"],"latin":["Pressio","Circumpressio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"6057","subsection":null},"text":"The lungs are formed to all the nature of the pressure of the air; as also the compass of the body, which is held together in its form by the circumpressure of the air. DLW 176:2. DLW 310.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1280","subsection":null},"text":"Brazen points which they press with their hands.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4063","subsection":null},"text":"Thus man cannot consist without the pressure of the atmospheres.","comment":null,"footnote":null}],"slug":"press-477a8c","url":"/meta/potts/press-477a8c/"}