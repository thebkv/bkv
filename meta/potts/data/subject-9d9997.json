{"key":"9d9997060e9c2cbf","source_file":"Potts St - Sy.json","source_id":30034,"source_url":"concordance-subject-ppl-subditus","term":"Subject","headwords":["Subject"],"latin":["Subditus"],"header_pairs":[{"english":["Subject"],"latin":["Subditus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","TCR"],"contexts":[{"reference":{"work":"AC","section":"10814","subsection":null},"text":"It never comes into his mind to subject them to himself as subjects.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"422","subsection":null},"text":"A king who sets his subjects a (good) example.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"533","subsection":"2"},"text":"These two evil loves may reign... with subjects more than with kings.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"681","subsection":null},"text":"Like a subject who renders allegiance to a king, and yet repudiates his laws...","comment":null,"footnote":null}],"slug":"subject-9d9997","url":"/meta/potts/subject-9d9997/"}