{"key":"e9a1116657d2e20d","source_file":"Potts St - Sy.json","source_id":45878,"source_url":"concordance-superstition-ppl-superstitio","term":"Superstition","headwords":["Superstition","Superstitious"],"latin":["Superstitio","Superstitiosus"],"header_pairs":[{"english":["Superstition"],"latin":["Superstitio"]},{"english":["Superstitious"],"latin":["Superstitiosus"]}],"header_sentences":[],"redirect_xref":null,"works":["Coro","TCR"],"contexts":[{"reference":{"work":"TCR","section":"821","subsection":"2"},"text":"It is as difficult to lead away from the superstitious things of that religion...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"824","subsection":"end"},"text":"They are not allowed to speak with any of the papal nation who are in that superstition.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"51","subsection":"2"},"text":"Hence their religion was not a religion, but a superstition; and the worship of such is not representative, but idolatrous.","comment":null,"footnote":null}],"slug":"superstition","url":"/meta/potts/superstition/"}