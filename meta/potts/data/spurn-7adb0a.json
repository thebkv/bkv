{"key":"7adb0ae05a8d9fa8","source_file":"Potts Sp - Sq.json","source_id":48920,"source_url":"concordance-spurn-ppl-respuere","term":"Spurn","headwords":["Spurn"],"latin":["Respuere"],"header_pairs":[{"english":["Spurn"],"latin":["Respuere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"4027","subsection":"2"},"text":"They reject, nay spurn, these arcana.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7245","subsection":"2"},"text":"They spurned Knowledges of internal Things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7950","subsection":"end"},"text":"He will then disown, hold in aversion, and spurn the truth.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"487","subsection":null},"text":"So that they spurn all the doctrine of the wise.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"243","subsection":"end"},"text":"The diabolical crew then spurned these things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2995","subsection":null},"text":"They spurned (these truths) with some aversion.","comment":null,"footnote":null}],"slug":"spurn-7adb0a","url":"/meta/potts/spurn-7adb0a/"}