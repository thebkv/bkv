{"key":"8462501a84770eaf","source_file":"Potts Bl - Bu.json","source_id":30062,"source_url":"concordance-breathe-ppl-spirare","term":"Breathe","headwords":["Breathe"],"latin":["Spirare"],"header_pairs":[{"english":["Breathe"],"latin":["Spirare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DWis","HH"],"contexts":[{"reference":{"work":"AC","section":"1769","subsection":null},"text":"They who have aspired to high things... AC 9365.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8296","subsection":null},"text":"Thou hast blown with Thy wind () = the presence of the Lord with the Angels.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10240","subsection":"3"},"text":"To breathe = the state of the life of faith. References.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"537","subsection":"2"},"text":"From Hell there continually breathes forth falsity from evil, and from Heaven truth from good.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"552","subsection":"2"},"text":"Thus does (a Spirit) breathe his own life...","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"6","subsection":null},"text":"4. He breathed into them () = intelligence.","comment":null,"footnote":null}],"slug":"breathe-846250","url":"/meta/potts/breathe-846250/"}