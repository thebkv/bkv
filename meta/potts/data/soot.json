{"key":"749d214b874dc3b1","source_file":"Potts Sh - So.json","source_id":51161,"source_url":"concordance-soot-ppl-fuligo","term":"Soot","headwords":["Soot","Sooty","Chimney sweep"],"latin":["Fuligo","Fuliginosus","Fuliginarius"],"header_pairs":[{"english":["Soot"],"latin":["Fuligo"]},{"english":["Sooty"],"latin":["Fuliginosus"]},{"english":["Chimney sweep"],"latin":["Fuliginarius"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","AR","CL","DLW","HH","TCR"],"contexts":[{"reference":{"work":"HH","section":"429","subsection":null},"text":"Dusky and as it were sooty caverns.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"585","subsection":null},"text":"An exhalation from the Hells (when opened)... like the soot which comes from a chimney on fire... Smoke and soot correspond to the falsities therefrom.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"357","subsection":null},"text":"Above the Sensuous... there appeared a covering... in some black like soot.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"153","subsection":"end"},"text":"Some devils appear black like soot.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"264","subsection":null},"text":"Their loins were black like soot.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"61","subsection":"end"},"text":"Like a chimney sweep sticking in a dusky chimney.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"209","subsection":"3"},"text":"The Word appears to him... as if covered with soot.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"331","subsection":"4"},"text":"Like a servant with his face and clothes defiled with soot...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"803","subsection":"3"},"text":"Hence (their goods) appeared either burnt, or sooty.","comment":null,"footnote":null}],"slug":"soot","url":"/meta/potts/soot/"}