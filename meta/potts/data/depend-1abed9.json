{"key":"1abed9bde4006b7a","source_file":"Potts De.json","source_id":27026,"source_url":"concordance-depend-ppl-dependere","term":"Depend","headwords":["Depend","Dependence"],"latin":["Dependere","Dependentia"],"header_pairs":[{"english":["Depend"],"latin":["Dependere"]},{"english":["Dependence"],"latin":["Dependentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"2026","subsection":"end"},"text":"On the Heaven of Angels depends the Heaven of Angelic Spirits...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6465","subsection":null},"text":"The posterior depends upon the prior...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8728","subsection":null},"text":"Perpetual dependence thence. Signified. To judge, here, = subordinate disposition, which is dependence.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8728","subsection":null},"text":"The Angels and the angelic Societies are in such subordination and dependence...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"216","subsection":null},"text":"a. Their love depends upon their husbands.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"486","subsection":null},"text":"Unless they depended on a single love, which is Divine...","comment":null,"footnote":null}],"slug":"depend-1abed9","url":"/meta/potts/depend-1abed9/"}