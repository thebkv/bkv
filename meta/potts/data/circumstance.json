{"key":"b66dcb65e9dbcaca","source_file":"Potts Ci - Cl.json","source_id":1659,"source_url":"concordance-circumstance-ppl-circumstantia","term":"Circumstance","headwords":["Circumstance"],"latin":["Circumstantia"],"header_pairs":[{"english":["Circumstance"],"latin":["Circumstantia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"2481","subsection":null},"text":"Describing... with many circumstances... AC 2482. AC 2483:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7298","subsection":"end"},"text":"According to circumstances.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"462","subsection":"8"},"text":"All the circumstances appear together.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"166","subsection":null},"text":"It does not become me to open these things as to the circumstances.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"485","subsection":null},"text":"Circumstances... vary the case. SE 60. SE 2537.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"487","subsection":"end"},"text":"They cannot be judged from these circumstances...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"530","subsection":null},"text":"There are various circumstances in the world that mitigate... and that aggravate crimes.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"622","subsection":null},"text":"They permitted him to punish according to the circumstances.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3537","subsection":null},"text":"Although circumstances vary truths, they do not take them away. Example(s).","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4312","subsection":null},"text":"On those who inhere in general truth without application to circumstances. Example(s).","comment":null,"footnote":nu