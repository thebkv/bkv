{"key":"1798dacdddb91a6c","source_file":"Potts Co.json","source_id":56755,"source_url":"concordance-copper-ppl-cuprum","term":"Copper","headwords":["Copper"],"latin":["Cuprum","Cupreus"],"header_pairs":[{"english":["Copper"],"latin":["Cuprum","Cupreus"]}],"header_sentences":["See Brass."],"redirect_xref":null,"works":["AE","AR","CL","DMin","HH","TCR"],"contexts":[{"reference":{"work":"HH","section":"115","subsection":"end"},"text":"Copper natural good, in which was the next posterity.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"913","subsection":null},"text":"Copper, or brass, = the good of charity.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"77","subsection":null},"text":"(A visit to those of the Copper Age.)","comment":null,"footnote":null},{"reference":{"work":"CL","section":"182","subsection":"end"},"text":"They gave insignia to the three novitiates, which were copper plates...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"609","subsection":"end"},"text":"Copper = natural good, which is the good of the ultimate Heaven. DMin 4735.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4735","subsection":null},"text":"One who had thought much about copper...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"176","subsection":null},"text":"Copper, or brass = the good of the external or natural man... Hence called the Copper Age.","comment":null,"footnote":null}],"slug":"copper-1798da","url":"/meta/potts/copper-1798da/"}