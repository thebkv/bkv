{"key":"25807da9d2fa3dbe","source_file":"Potts Ea - Es.json","source_id":37830,"source_url":"concordance-embalm-ppl-condire","term":"Embalm","headwords":["Embalm","Embalming"],"latin":["Condire","Conditura"],"header_pairs":[{"english":["Embalm"],"latin":["Condire"]},{"english":["Embalming"],"latin":["Conditura"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","HH"],"contexts":[{"reference":{"work":"AC","section":"6503","subsection":null},"text":"To embalm his father () = lest it be infected by any contagion. To embalm = a means of preservation from contagion... because embalmings took place in order to preserve a body from putridity.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6595","subsection":null},"text":"They embalmed him () = preservation still.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10252","subsection":"7"},"text":"(The signification of embalming.)","comment":null,"footnote":null},{"reference":{"work":"HH","section":"449","subsection":null},"text":"An aromatic odour, like that of an embalmed corpse.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"282","subsection":"end"},"text":"The man would be like an embalmed corpse.","comment":null,"footnote":null}],"slug":"embalm","url":"/meta/potts/embalm/"}