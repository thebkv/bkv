{"key":"7c22d2b942537abf","source_file":"Potts Sp - Sq.json","source_id":48485,"source_url":"concordance-sprinkle-ppl-aspergere","term":"Sprinkle","headwords":["Sprinkle","Sprinkling, A"],"latin":["Aspergere","Circumspergere","Conspergere","Aspersio"],"header_pairs":[{"english":["Sprinkle"],"latin":["Aspergere","Circumspergere","Conspergere"]},{"english":["Sprinkling, A"],"latin":["Aspersio"]}],"header_sentences":["See Scatter."],"redirect_xref":null,"works":["AC","AE","HH"],"contexts":[{"reference":{"work":"AC","section":"10047","subsection":null},"text":"To sprinkle blood upon the altar round about () = to unite Divine truth with Divine good in the Lord.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10067","subsection":null},"text":"To sprinkle upon them () = to unite; for that which is sprinkled and poured upon anyone represents unition.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"289","subsection":"end"},"text":"An odour of vegetation diffused.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"578","subsection":null},"text":"Evils which they scatter around.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"475","subsection":"4"},"text":"The purification of the externals of the Church was represented by the sprinkling of the water of expiation, etc. ().","comment":null,"footnote":null},{"reference":{"work":"AE","section":"519","subsection":"6"},"text":"Scatterings () = truths destroyed through falsities; breaches = the same, but in a less degree.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"922","subsection":"5"},"text":"Therefore it is said with dyed garments ().","comment":null,"footnote":null}],"slug":"sprinkle","url":"/meta/potts/sprinkle/"}