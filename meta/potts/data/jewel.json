{"key":"9ff64239201ef90e","source_file":"Potts J.json","source_id":22586,"source_url":"concordance-jewel-ppl-clenodium","term":"Jewel","headwords":["Jewel"],"latin":["Clenodium"],"header_pairs":[{"english":["Jewel"],"latin":["Clenodium"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","TCR"],"contexts":[{"reference":{"work":"CL","section":"457","subsection":null},"text":"That the Conjugial of one man with one wife is the jewel of human life... CL 466:2. CL 531.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"527","subsection":"2"},"text":"Like those who gather into their treasuries jewels of gold and silver...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"669","subsection":null},"text":"The two sacraments... are like two jewels in a king's sceptre...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"763","subsection":"end"},"text":"(Such Churches) are like so many jewels in a king's crown.","comment":null,"footnote":null}],"slug":"jewel","url":"/meta/potts/jewel/"}