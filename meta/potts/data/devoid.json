{"key":"b3ab77680fe26039","source_file":"Potts De.json","source_id":40451,"source_url":"concordance-devoid-ppl-expers","term":"Devoid","headwords":["Devoid"],"latin":["Expers"],"header_pairs":[{"english":["Devoid"],"latin":["Expers"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"8941","subsection":"3"},"text":"Being devoid of heavenly life...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8943","subsection":null},"text":"Man's Own intelligence is in itself devoid of life.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9076","subsection":null},"text":"That he may be free from damnation. Signified.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"341","subsection":"3"},"text":"The nature of the innocence of little children was represented to me by what is woody, almost devoid of life.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"432","subsection":"2"},"text":"The natural world, in which all things are material, and in themselves devoid of life.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"204","subsection":null},"text":"With substances and matters devoid of life...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"547","subsection":"end"},"text":"They consider the face as being devoid of muscles and fibres.","comment":null,"footnote":null}],"slug":"devoid","url":"/meta/potts/devoid/"}