{"key":"f8316623dca38ff9","source_file":"Potts St - Sy.json","source_id":25639,"source_url":"concordance-strike-ppl-ferire","term":"Strike","headwords":["Strike"],"latin":["Ferire"],"header_pairs":[{"english":["Strike"],"latin":["Ferire"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","HH"],"contexts":[{"reference":{"work":"AC","section":"9065","subsection":null},"text":"To strike (with the horn) () = to injure. DFaith 67.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9081","subsection":null},"text":"To strike with the horn = to destroy.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9182","subsection":"6"},"text":"To strike a covenant. Explained.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"429","subsection":"end"},"text":"When a breath from Heaven struck him... When a breath from Hell struck him.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"432","subsection":"end"},"text":"It is said of an instrument that it strikes, etc.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"316","subsection":"16"},"text":"The ram pushed (). AE 316:19.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"316","subsection":"23"},"text":"To strike (with his horns) the peoples to the ends of the earth () = to instruct in truths all who are of the Church, and to scatter falsities by means of truths.","comment":null,"footnote":null}],"slug":"strike-f83166","url":"/meta/potts/strike-f83166/"}