{"key":"a2b155b2c5cecec9","source_file":"Potts Sh - So.json","source_id":15107,"source_url":"concordance-silkworm-ppl-bombyx","term":"Silkworm","headwords":["Silkworm"],"latin":["Bombyx"],"header_pairs":[{"english":["Silkworm"],"latin":["Bombyx"]}],"header_sentences":[],"redirect_xref":null,"works":["DLW","TCR"],"contexts":[{"reference":{"work":"DLW","section":"61","subsection":null},"text":"Occurs. DP 3:3. SE 3819.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"356","subsection":null},"text":"Those vile worms, called silkworms, clothe queens in silk... CL 420. TCR 13:3.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"335","subsection":"4"},"text":"Does the silkworm, when a caterpillar, think in its little head...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"524","subsection":"2"},"text":"The silkworm would perish... unless other worms were shaken off...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"687","subsection":"3"},"text":"The wonderful transformation of silkworms, etc.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"785","subsection":null},"text":"It is the internal of the silkworm whereby its external is moved to spin silk.","comment":null,"footnote":null}],"slug":"silkworm-a2b155","url":"/meta/potts/silkworm-a2b155/"}