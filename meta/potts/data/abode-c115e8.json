{"key":"c115e85ff653fffe","source_file":"Potts Aa - Am.json","source_id":1606,"source_url":"concordance-abode-ppl-domicilium","term":"Abode","headwords":["Abode"],"latin":["Domicilium"],"header_pairs":[{"english":["Abode"],"latin":["Domicilium"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"939","subsection":null},"text":"The abodes of the evil there. AC 950.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7988","subsection":"4"},"text":"The angelic abodes shine like the stars. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8030","subsection":null},"text":"The inhabitants of Jupiter call the starry heaven the abode of the Angels.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10810","subsection":"end"},"text":"The evil there introduce themselves into the abodes of the good.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"39","subsection":null},"text":"This inmost degree is the Lord's very abode with man... LJ 25:5.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"177","subsection":null},"text":"Since Angels are men they have abodes, etc.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4181","subsection":null},"text":"On abodes... The abodes of my mothers there.","comment":null,"footnote":null}],"slug":"abode-c115e8","url":"/meta/potts/abode-c115e8/"}