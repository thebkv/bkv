{"key":"6504a5fad0545365","source_file":"Potts Ci - Cl.json","source_id":1493,"source_url":"concordance-circumrotate-ppl-circumrotare","term":"Circumrotate","headwords":["Circumrotate","Circumrotation"],"latin":["Circumrotare","Circumrotatio"],"header_pairs":[{"english":["Circumrotate"],"latin":["Circumrotare"]},{"english":["Circumrotation"],"latin":["Circumrotatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"829","subsection":null},"text":"Their punishment is... that they are circumrotated rapidly like a roll, from left to right... AC 5188:2. SE 1485. SE 1806. SE 4309. SE 4714.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6110","subsection":"4"},"text":"The earth, by its circumrotation, turns itself from the sun...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1183","subsection":null},"text":"They are beautifully circumrotated...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1259","subsection":"2"},"text":"There, sitting on a seat, he was circumrotated, which signified that he was versatile.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4087","subsection":"end"},"text":"Hence come... bodily progressions, circumrotations, etc.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4327","subsection":null},"text":"A new kind of punishment by circumrotation.","comment":null,"footnote":null}],"slug":"circumrotate","url":"/meta/potts/circumrotate/"}