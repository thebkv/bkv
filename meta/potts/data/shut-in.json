{"key":"f05f2c258136d79d","source_file":"Potts Sh - So.json","source_id":10885,"source_url":"concordance-shut-in-ppl-includere","term":"Shut in","headwords":["Shut in"],"latin":["Includere"],"header_pairs":[{"english":["Shut in"],"latin":["Includere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DLife","DP","SE"],"contexts":[{"reference":{"work":"AC","section":"8625","subsection":"2"},"text":"They were then shut up in Hell.","comment":null,"footnote":null},{"reference":{"work":"DLife","section":"110","subsection":null},"text":"This influx shuts in concupiscences... Hereditary evil thus lies shut in.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"133","subsection":null},"text":"Their evils have been shut in (by miracles).","comment":null,"footnote":null},{"reference":{"work":"DP","section":"136","subsection":"4"},"text":"Forced worship shuts in evils.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"251","subsection":null},"text":"If evils were not permitted to break out... they would remain shut in, and, like a cancer or gangrene, would consume everything vital. DP 281:2.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"225","subsection":null},"text":"The worst Genii have been shut up in Hell.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"970","subsection":"end"},"text":"Spiritual things are enclosed in natural ideas until man enters the Spiritual World.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1155","subsection":"3"},"text":"External means... do not cast out evils and falsities, but shut them in. Explained.","comment":null,"footnote":null}],"slug":"shut-in","url":"/meta/potts/shut-in/"}