{"key":"d16430c9b3af4b9e","source_file":"Potts Lo - Ly.json","source_id":48927,"source_url":"concordance-lower-regions-ppl-inferi","term":"Lower Regions","headwords":["Lower Regions"],"latin":["Inferi"],"header_pairs":[{"english":["Lower Regions"],"latin":["Inferi"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL"],"contexts":[{"reference":{"work":"AC","section":"6854","subsection":"2"},"text":"See Lower Earth. CL 231.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8018","subsection":"2"},"text":"The deliverance of (those of the Spiritual Church) when He rose again, is signified by the descent of the Lord to the Lower Regions.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"7","subsection":"2"},"text":"There then appeared as it were a mist ascending from the Lower Regions...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"263","subsection":"2"},"text":"The devil replied hoarsely, I am from the Lower Regions...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"269","subsection":null},"text":"We ascended from these Lower Regions... (Compare CL 268.)","comment":null,"footnote":null},{"reference":{"work":"CL","section":"535","subsection":null},"text":"I heard a hostile murmur from the Lower Regions... TCR 849.","comment":null,"footnote":null}],"slug":"lower-regions-d16430","url":"/meta/potts/lower-regions-d16430/"}