{"key":"b5881adb22dde533","source_file":"Potts O.json","source_id":6008,"source_url":"concordance-obstinacy-ppl-obnixitas","term":"Obstinacy","headwords":["Obstinacy","Obstinately","Steadfast"],"latin":["Obnixitas","Obnixe","Obnixus"],"header_pairs":[{"english":["Obstinacy"],"latin":["Obnixitas"]},{"english":["Obstinately"],"latin":["Obnixe"]},{"english":["Steadfast"],"latin":["Obnixus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DP"],"contexts":[{"reference":{"work":"AC","section":"1267","subsection":null},"text":"Those who persist more obstinately...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"115","subsection":null},"text":"Like those who fix their eyes obstinately on the sun.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"212","subsection":null},"text":"Who can act against fortune if it is steadfast?","comment":null,"footnote":null},{"reference":{"work":"CL","section":"252","subsection":null},"text":"The highest degree of obstinacy in not complying with what is just and fair (a cause of legitimate separation).","comment":null,"footnote":null},{"reference":{"work":"CL","section":"292","subsection":"2"},"text":"The unintermitted obstinacies of petitions (of polite wives).","comment":null,"footnote":null},{"reference":{"work":"CL","section":"292","subsection":null},"text":"For they know that the men... cannot possibly resist the obstinacies of their wives.","comment":null,"footnote":null}],"slug":"obstinacy-b5881a","url":"/meta/potts/obstinacy-b5881a/"}