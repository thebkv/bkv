{"key":"62ca04e3823f88c5","source_file":"Potts O.json","source_id":3112,"source_url":"concordance-oblique-ppl-obliquus","term":"Oblique","headwords":["Oblique","Obliquely","Obliquity"],"latin":["Obliquus","Oblique","Obliquitas"],"header_pairs":[{"english":["Oblique"],"latin":["Obliquus"]},{"english":["Obliquely"],"latin":["Oblique"]},{"english":["Obliquity"],"latin":["Obliquitas"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DLW","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1276","subsection":null},"text":"At every obliquity.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3527","subsection":"end"},"text":"The crooked to straight () = the evil of ignorance to good.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"429","subsection":null},"text":"Caverns tending obliquely downwards...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"125","subsection":null},"text":"Those more in wisdom see the Lord obliquely to the right; those less in wisdom, obliquely to the left.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"42","subsection":"4"},"text":"She turned herself obliquely from her husband.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"362","subsection":"3"},"text":"A man who looks askance at these things...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4003","subsection":"end"},"text":"They are turned into contraries, or other oblique things...","comment":null,"footnote":null}],"slug":"oblique","url":"/meta/potts/oblique/"}