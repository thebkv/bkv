{"key":"e3fa4bfa9f33671a","source_file":"Potts Co.json","source_id":47783,"source_url":"concordance-consternation-ppl-consternare","term":"Consternation","headwords":["Consternation"],"latin":["Consternare","Consternatio"],"header_pairs":[{"english":["Consternation"],"latin":["Consternare","Consternatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR"],"contexts":[{"reference":{"work":"AC","section":"5881","subsection":null},"text":"They were terrified at his presence () = a moving among them.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8314","subsection":null},"text":"Then were the dukes of Edom affrighted () = the like with those who are in a life of evil from self-love.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9327","subsection":"3"},"text":"I will put consternation in their hearts ().","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9328","subsection":null},"text":"The consternation of all falsities. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9330","subsection":"2"},"text":"When they are in Hell they are in terror and consternation at the truths from good in which the Angels are from the Lord.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"911","subsection":null},"text":"A moving of the mind, and consternation at Divine truths. Signified.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"406","subsection":"3"},"text":"Occurs. AE 411:18. AE 650:64. AE 727:18. AE 783:3. AE 811:23.","comment":null,"footnote":null}],"slug":"consternation","url":"/meta/potts/consternation/"}