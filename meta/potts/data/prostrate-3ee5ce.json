{"key":"3ee5ce5cc9f75f2c","source_file":"Potts Pr - Py.json","source_id":36691,"source_url":"concordance-prostrate-ppl-prostrare","term":"Prostrate","headwords":["Prostrate","Prostration"],"latin":["Prostrare","Prostratio"],"header_pairs":[{"english":["Prostrate"],"latin":["Prostrare"]},{"english":["Prostration"],"latin":["Prostratio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL"],"contexts":[{"reference":{"work":"AC","section":"1999","subsection":null},"text":"Humiliation of heart (is attended with) prostration to the earth upon the face before the Lord. AC 2153. AC 2327. AC 4215:2. AC 5323.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4293","subsection":"3"},"text":"They could lie prostrate on the ground for whole days.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"10","subsection":"5"},"text":"He said, I prostrated myself on the ground.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"863","subsection":"2"},"text":"He hath prostrated all my strong ones () = that all the power of truth against falsities has perished.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"922","subsection":"5"},"text":"The prostration of the Hells by His Own power. Signified.","comment":null,"footnote":null}],"slug":"prostrate-3ee5ce","url":"/meta/potts/prostrate-3ee5ce/"}