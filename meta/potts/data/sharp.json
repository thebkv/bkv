{"key":"50b7fcc41ba463f3","source_file":"Potts Sh - So.json","source_id":1824,"source_url":"concordance-sharp-ppl-acutus","term":"Sharp","headwords":["Sharp","Sharpen","Acutely"],"latin":["Acutus","Acuminare","Acute"],"header_pairs":[{"english":["Sharp"],"latin":["Acutus"]},{"english":["Sharpen"],"latin":["Acuminare"]},{"english":["Acutely"],"latin":["Acute"]}],"header_sentences":["See Point, and Salt."],"redirect_xref":null,"works":["AC","AE","AR","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"546","subsection":"end"},"text":"They wore a pointed cap...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1641","subsection":null},"text":"Spirits speak so acutely...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2799","subsection":"3"},"text":"A sharp sword. AR 52.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2799","subsection":"21"},"text":"Truth combating is represented by things which are sharpened, like swords...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4214","subsection":"2"},"text":"The more acutely they can (ratiocinate). AC 4214:5.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"353","subsection":"3"},"text":"Sensuous men can ratiocinate more acutely...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"52","subsection":null},"text":"Called sharp, because it penetrates the heart and soul.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"647","subsection":null},"text":"A sharp sickle () = the Divine truth of the Word.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"208","subsection":null},"text":"Spirits abhor sharp things. Explained.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"929","subsection":null},"text":"Everything sharp = deceit, or cunning.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"934","subsection":null},"text":"Swords and sharp points appear whenever a Soul speaks otherwise than he thinks. Explained.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1057","subsection":null},"text":"Spiritual things are represented by the sharper things...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2621","subsection":null},"text":"(David) is sharp, or pernicious.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5962","subsection":null},"text":"Dippel could not view Things acutely, although he had written acutely...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5962","subsection":"end"},"text":"The malice of the infernals is so acute...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"73","subsection":null},"text":"Called sharp, two-edged because it disperses completely.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"560","subsection":"3"},"text":"Interior falsities are there represented by sharp things. Enumerated.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"780","subsection":"8"},"text":"Sharp above the wolves of evening () = the cunning of deceiving by fallacies.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"908","subsection":"2"},"text":"Sharp () = accurate, exquisite, and completely. Illustrated.","comment":null,"footnote":null}],"slug":"sharp","url":"/meta/potts/sharp/"}