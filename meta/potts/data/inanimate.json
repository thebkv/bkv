{"key":"05562c56087ee940","source_file":"Potts In.json","source_id":227,"source_url":"concordance-inanimate-ppl-inanimatus","term":"Inanimate","headwords":["Inanimate"],"latin":["Inanimatus"],"header_pairs":[{"english":["Inanimate"],"latin":["Inanimatus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","SE"],"contexts":[{"reference":{"work":"AC","section":"9","subsection":null},"text":"He produces goods... which are inanimate, because he supposes they are from himself.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"29","subsection":null},"text":"This state is here represented by the inanimate things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"30","subsection":"2"},"text":"Scientific and intellectual faith is represented (here) by the inanimate things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4950","subsection":null},"text":"Something inanimate in which they believe.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9293","subsection":null},"text":"The deeds of a man... abstractedly from will... are... inanimate. HH 472:end.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"137","subsection":null},"text":"Compulsory worship is... inanimate...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3215","subsection":null},"text":"The deceitful murderer then appeared like an inanimate mass.","comment":null,"footnote":null}],"slug":"inanimate","url":"/meta/potts/inanimate/"}