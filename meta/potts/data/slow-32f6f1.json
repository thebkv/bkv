{"key":"32f6f1b74b4dff4a","source_file":"Potts Sh - So.json","source_id":33893,"source_url":"concordance-slow-ppl-lentus","term":"Slow","headwords":["Slow","Slowly","Sluggishness"],"latin":["Lentus","Lente","Lentor"],"header_pairs":[{"english":["Slow"],"latin":["Lentus"]},{"english":["Slowly"],"latin":["Lente"]},{"english":["Sluggishness"],"latin":["Lentor"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","SE"],"contexts":[{"reference":{"work":"AC","section":"4054","subsection":"2"},"text":"Their presence was perceived by a sluggishness.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4381","subsection":null},"text":"I will proceed slowly () = a successive state of preparation.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6921","subsection":null},"text":"Material things are like weights which induce sluggishness.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7270","subsection":"3"},"text":"Divine truth thus becomes slower.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9334","subsection":"2"},"text":"Man is regenerated slowly.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9336","subsection":null},"text":"Little by little = by degrees, thus slowly.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2009","subsection":null},"text":"How slow is the thought of man. Explained.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5629","subsection":null},"text":"Therefore the Dutch are slower.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1057","subsection":"end"},"text":"Hence they have alacrity in worldly things, and sluggishness in spiritual ones.","comment":null,"footnote":null}],"slug":"slow-32f6f1","url":"/meta/potts/slow-32f6f1/"}