{"key":"c9b5fcb56dcb8dd7","source_file":"Potts Bl - Bu.json","source_id":39097,"source_url":"concordance-burn-ppl-flagrare","term":"Burn","headwords":["Burn"],"latin":["Flagrare"],"header_pairs":[{"english":["Burn"],"latin":["Flagrare"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","HH","SE","TCR"],"contexts":[{"reference":{"work":"HH","section":"283","subsection":null},"text":"Burn to injure them.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"290","subsection":"2"},"text":"Inwardly they burn with envy, hatred...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"358","subsection":null},"text":"Zeal is like the fire of love blazing up.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"358","subsection":null},"text":"Zeal is not the highest degree of love, but is love blazing up.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"358","subsection":"3"},"text":"The reason love is said to burn like fire...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"45","subsection":null},"text":"He burns with anger against his god...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"309","subsection":null},"text":"To be inflamed with hatred, and to burn with revenge.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4496","subsection":"end"},"text":"He was amazed that he had so suddenly burned with venereal heat...","comment":null,"footnote":null}],"slug":"burn-c9b5fc","url":"/meta/potts/burn-c9b5fc/"}