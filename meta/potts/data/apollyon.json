{"key":"649160ec1b44dcb3","source_file":"Potts An - Az.json","source_id":21864,"source_url":"concordance-apollyon-ppl-apollyon","term":"Apollyon","headwords":["Apollyon"],"latin":["Apollyon"],"header_pairs":[{"english":["Apollyon"],"latin":["Apollyon"]}],"header_sentences":["See Abaddon."],"redirect_xref":null,"works":["AC","BE"],"contexts":[{"reference":{"work":"AC","section":"7643","subsection":"10"},"text":"Apollyon is reasoning from falsities appearing as from truth, especially if by those who are believed to be wise it is confirmed by philosophical things perversely applied, for the blind admiration of wisdom induces faith in them.","comment":null,"footnote":null},{"reference":{"work":"BE","section":"93","subsection":null},"text":"Under Apollo, see this reference.","comment":null,"footnote":null}],"slug":"apollyon","url":"/meta/potts/apollyon/"}