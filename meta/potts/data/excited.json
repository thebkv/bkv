{"key":"904f9f9ace7e2b78","source_file":"Potts Et - Ez.json","source_id":30190,"source_url":"concordance-excited-ppl-percitus","term":"Excited","headwords":["Excited"],"latin":["Percitus"],"header_pairs":[{"english":["Excited"],"latin":["Percitus"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","HH","SE","WE"],"contexts":[{"reference":{"work":"HH","section":"562","subsection":null},"text":"He was excited by such hatred from anger...","comment":null,"footnote":null},{"reference":{"work":"WE","section":"941","subsection":null},"text":"Occurs.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2666","subsection":null},"text":"(Adulterers) are stimulated by the love of self.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2679","subsection":null},"text":"They were moved with the greatest fear...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2712","subsection":null},"text":"Moved with such delight...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3061","subsection":null},"text":"Moved with such anxiety...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3187","subsection":"end"},"text":"For women with the love of whom they were excited...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4225","subsection":"end"},"text":"Therefore they are not excited with such love...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4530","subsection":null},"text":"She was moved with such hatred...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5047","subsection":null},"text":"Such as are excited by the desire of exercising command... SE 5049.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"991","subsection":"6"},"text":"Therefore they are excited by a deadly and diabolical hatred against Heaven.","comment":null,"footnote":null}],"slug":"excited","url":"/meta/potts/excited/"}