{"key":"3ba311a01d8c11e8","source_file":"Potts To - Ty.json","source_id":10375,"source_url":"concordance-transmigrate-ppl-transmigrare","term":"Transmigrate","headwords":["Transmigrate","Transmigration"],"latin":["Transmigrare","Transmigratio"],"header_pairs":[{"english":["Transmigrate"],"latin":["Transmigrare"]},{"english":["Transmigration"],"latin":["Transmigratio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"8850","subsection":"end"},"text":"They thus transmigrate from the world into Heaven. HH 312:4. ISB 3:2.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"160","subsection":"2"},"text":"After death all these transmigrate into this (Spiritual) World.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2542","subsection":null},"text":"Man would at once have transmigrated into Heaven.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4232","subsection":null},"text":"My approach to other Societies appeared like a transmigration...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"403","subsection":"18"},"text":"The transmigration of Judah ().","comment":null,"footnote":null},{"reference":{"work":"AE","section":"659","subsection":null},"text":"Instead of death, the Angels perceive the transmigration of man from one world into the other.","comment":null,"footnote":null}],"slug":"transmigrate","url":"/meta/potts/transmigrate/"}