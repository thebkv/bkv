{"key":"250e49352ca570c7","source_file":"Potts Bl - Bu.json","source_id":30218,"source_url":"concordance-breathe-into-ppl-insufflare","term":"Breathe into","headwords":["Breathe into","Inflation"],"latin":["Insufflare","Insufflatio"],"header_pairs":[{"english":["Breathe into"],"latin":["Insufflare"]},{"english":["Inflation"],"latin":["Insufflatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","SE"],"contexts":[{"reference":{"work":"AC","section":"1506","subsection":"end"},"text":"To such a degree does the love of self inflate itself...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5664","subsection":null},"text":"1.2. [3]. The love of self and of the world which puffs them up...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8593","subsection":"2"},"text":"By inflations of his depraved affections...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"338","subsection":"7"},"text":"Nor was it possible to breathe into them any other life than their own.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3110","subsection":"end"},"text":"They were perceived only by such a method of blowing into...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3113","subsection":null},"text":"Those who blew him out... The reason he was so blown out...","comment":null,"footnote":null}],"slug":"breathe-into","url":"/meta/potts/breathe-into/"}