{"key":"408304571c3e3743","source_file":"Potts Lo - Ly.json","source_id":3762,"source_url":"concordance-loose-to-ppl-laxare","term":"Loose, To","headwords":["Loose, To"],"latin":["Laxare","Relaxare"],"header_pairs":[{"english":["Loose, To"],"latin":["Laxare","Relaxare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL","DLW","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1675","subsection":"7"},"text":"In proportion as the bonds are loosed... AC 2219:4. SE 2943:2. SE 4348.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7375","subsection":null},"text":"In proportion as the reins are loosed... AC 8678. HH 559. CL 262:2. CL 264:end. TCR 822.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"259","subsection":null},"text":"Breaking down the barriers.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"17","subsection":null},"text":"That their minds may be relaxed.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"462","subsection":"2"},"text":"Not relaxing anything.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"438","subsection":null},"text":"Would let the mind run loose into evils.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2310","subsection":null},"text":"When anything is relaxed to them...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2323","subsection":null},"text":"The bridle is relaxed to their cupidities, but rarely to their Falsities.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2737","subsection":"end"},"text":"If anything were relaxed, everyone would rush...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3497","subsection":"2"},"text":"The motive fibres would be so relaxed...","comment":null,"footnote":null}],"slug":"loose-to-408304","url":"/meta/potts/loose-to-408304/"}