{"key":"17f9a33fea074b8d","source_file":"Potts Li.json","source_id":30586,"source_url":"concordance-livid-ppl-lividus","term":"Livid","headwords":["Livid","Bruise"],"latin":["Lividus","Livor"],"header_pairs":[{"english":["Livid"],"latin":["Lividus"]},{"english":["Bruise"],"latin":["Livor"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","DLove","SE"],"contexts":[{"reference":{"work":"AC","section":"406","subsection":null},"text":"See Lamech.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"427","subsection":null},"text":"A wound, and a bruise () = that there was no longer anything whole. AC 431.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"431","subsection":null},"text":"A wound = that faith was desolated; a bruise, that charity was devastated. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"456","subsection":"2"},"text":"There appears in their faces black and blue.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4826","subsection":null},"text":"His face livid like that of a corpse.","comment":null,"footnote":null},{"reference":{"work":"DLove","section":"17","subsection":"4"},"text":"With some the interiors appeared livid from the love of the world.","comment":null,"footnote":null}],"slug":"livid","url":"/meta/potts/livid/"}