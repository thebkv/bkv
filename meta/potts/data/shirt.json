{"key":"7bb0478ae2d36e99","source_file":"Potts Sh - So.json","source_id":7916,"source_url":"concordance-shirt-ppl-indusium","term":"Shirt","headwords":["Shirt"],"latin":["Indusium"],"header_pairs":[{"english":["Shirt"],"latin":["Indusium"]}],"header_sentences":[],"redirect_xref":null,"works":["SE","TCR"],"contexts":[{"reference":{"work":"TCR","section":"695","subsection":"end"},"text":"The things of nature are like indusia (or garments next the skin) enveloping spiritual things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1306","subsection":null},"text":"Occurs. SE 1333. SE 1564. SE 3801. SE 4863. SE 5459. SE 5506:4. SE 6018. DMin 4757.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6018","subsection":"2"},"text":"When naked, I communicated with the Celestial Kingdom; when I lay in a shirt, with the Spiritual Kingdom.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6036","subsection":null},"text":"Like those buried in shrouds.","comment":null,"footnote":null}],"slug":"shirt","url":"/meta/potts/shirt/"}