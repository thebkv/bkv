{"key":"4ae2fd07a5f271a9","source_file":"Potts To - Ty.json","source_id":47627,"source_url":"concordance-turns-by-ppl-invicem","term":"Turns, By","headwords":["Turns, By"],"latin":["Invicem"],"header_pairs":[{"english":["Turns, By"],"latin":["Invicem"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","DP","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1013","subsection":"2"},"text":"Only in body are they distinct from one another.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1159","subsection":"3"},"text":"Houses not far remote from one another.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4250","subsection":"2"},"text":"They are then discriminated from one another.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9261","subsection":"2"},"text":"As soon as they differ they are separated from one another.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"33","subsection":null},"text":"They are not separated from one another.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"69","subsection":"end"},"text":"Two opposites ordinated in a like situation against one another.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"345","subsection":null},"text":"He alone can separate them from one another. Signified.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"508","subsection":null},"text":"They shall send gifts one to another ()... One to another = mutually. AE 661.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"357","subsection":null},"text":"That ye love one another ().","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"367","subsection":"3"},"text":"When they are separated from one another.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"666","subsection":"end"},"text":"I saw them withdrawing from one another.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4793","subsection":null},"text":"They do good to one another; but from a friendship which counterfeits charity.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"783","subsection":"5"},"text":"They are soon separated from one another.","comment":null,"footnote":null}],"slug":"turns-by","url":"/meta/potts/turns-by/"}