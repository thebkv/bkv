{"key":"0d4b8e61b642f8d0","source_file":"Potts Se.json","source_id":33753,"source_url":"concordance-serene-ppl-serenus","term":"Serene","headwords":["Serene","Serene, To be","Serenity"],"latin":["Serenus","Serenare","Serenitas"],"header_pairs":[{"english":["Serene"],"latin":["Serenus"]},{"english":["Serene, To be"],"latin":["Serenare"]},{"english":["Serenity"],"latin":["Serenitas"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"842","subsection":"2"},"text":"There then arises as it were a serenity, or silence (there).","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5246","subsection":"3"},"text":"When (the falsities and evils) are removed, there appears a serenity.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6603","subsection":"end"},"text":"According to the serenity or obscurity of the atmosphere.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8694","subsection":"3"},"text":"The mind then rests, and is serene...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10686","subsection":"end"},"text":"After temptations he has serenity...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"156","subsection":null},"text":"[155a]. [end]. This general bliss (which the husbands have from their wives there) is like the serenity of peace.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"71","subsection":"end"},"text":"The tumult ceased, and there was a tranquillity and serenity. SE 2127.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"77","subsection":null},"text":"In the early and serene light before full waking...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"304","subsection":"2"},"text":"Compared to the serenity after tempests...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2089","subsection":null},"text":"Turbulent atmospheres and waters gradually brought to serenity... So that that sphere was made serene...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4270","subsection":null},"text":"Like a serene aura around some one...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":"7"},"text":"The Jews possessed serenity, because they did not Know Him, and lived securely...","comment":null,"footnote":null}],"slug":"serene","url":"/meta/potts/serene/"}