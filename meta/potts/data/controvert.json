{"key":"4154fefd766e537f","source_file":"Potts Co.json","source_id":54183,"source_url":"concordance-controvert-ppl-controvertere","term":"Controvert","headwords":["Controvert","Controversy"],"latin":["Controvertere","Controversia"],"header_pairs":[{"english":["Controvert"],"latin":["Controvertere"]},{"english":["Controversy"],"latin":["Controversia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"2120","subsection":null},"text":"Heresies and controversies. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2435","subsection":"2"},"text":"(The controversy about the primogeniture.) AC 3863:2. AC 4925:4. AC 5351:3. TCR 336.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3428","subsection":null},"text":"In the thing itself about which they debate there are innumerable things which cannot be seen so long as the thing itself is not acknowledged...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"270","subsection":"2"},"text":"The Angels of that Heaven never debate whether it is so, or is not so.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1937","subsection":null},"text":"(Skilful debating among Spirits.)","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1953","subsection":null},"text":"They who labour much in controversies...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1955","subsection":null},"text":"In proportion as the mind is intent upon controversies, the truth perishes...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4391","subsection":null},"text":"Heresies and controversies. Signified.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"365","subsection":"4"},"text":"This is the origin of all dissensions controversies, and heresies in the Church.","comment":null,"footnote":null}],"slug":"controvert","url":"/meta/potts/controvert/"}