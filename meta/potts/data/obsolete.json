{"key":"ca292f286113a72e","source_file":"Potts O.json","source_id":5849,"source_url":"concordance-obsolete-ppl-obsoletus","term":"Obsolete","headwords":["Obsolete","Obsolete, To become"],"latin":["Obsoletus","Obsolescere"],"header_pairs":[{"english":["Obsolete"],"latin":["Obsoletus"]},{"english":["Obsolete, To become"],"latin":["Obsolescere"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","DWis","SE","TCR"],"contexts":[{"reference":{"work":"CL","section":"433","subsection":"2"},"text":"Sirens, who are obsolete venereal lusts.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"511","subsection":"2"},"text":"After conjugial love, and also scortatory love have become obsolete...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"435","subsection":"2"},"text":"The man is then like a tree the root of which is worn out.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"499","subsection":"2"},"text":"Rejects the worn out things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1012","subsection":"end"},"text":"The obsolete blood is attracted into the gall-bladder.","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"10","subsection":null},"text":"3. Into which the blood... sifts out its obsolete things.","comment":null,"footnote":null}],"slug":"obsolete","url":"/meta/potts/obsolete/"}