{"key":"e4f89ce426eb5322","source_file":"Potts Sh - So.json","source_id":52067,"source_url":"concordance-sorrow-ppl-maestitia","term":"Sorrow","headwords":["Sorrow"],"latin":["Maestitia","Maeror"],"header_pairs":[{"english":["Sorrow"],"latin":["Maestitia","Maeror"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DLW"],"contexts":[{"reference":{"work":"AC","section":"5551","subsection":null},"text":"In sorrow to the grave () = without hope of resuscitation; for when there is no longer any hope, there is sorrow.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6500","subsection":null},"text":"Sorrow. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6510","subsection":null},"text":"That the states of sorrow had been passed through. Signified.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"188","subsection":"2"},"text":"The Angels are in sorrow on account of the darkness on Earth...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"992","subsection":"3"},"text":"The Angels feel no sadness after the act.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1004","subsection":"4"},"text":"From this endeavour man puts off all senile sadness, etc.","comment":null,"footnote":null}],"slug":"sorrow-e4f89c","url":"/meta/potts/sorrow-e4f89c/"}