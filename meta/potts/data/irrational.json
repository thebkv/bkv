{"key":"29e602ecc3bcfd9c","source_file":"Potts Ir - Iv.json","source_id":1200,"source_url":"concordance-irrational-ppl-irrationalis","term":"Irrational","headwords":["Irrational"],"latin":["Irrationalis"],"header_pairs":[{"english":["Irrational"],"latin":["Irrationalis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"3108","subsection":"end"},"text":"This closes the Rational, and makes man irrational.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4156","subsection":"3"},"text":"He can never be called rational but rather irrational...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"455","subsection":null},"text":"Evil Spirits who have been made irrational by...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"72","subsection":null},"text":"In proportion as he denies these things, he is irrational.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"409","subsection":null},"text":"This cannot be called otherwise than irrational...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"241","subsection":null},"text":"There is nothing so irrational but that it may be reduced into what is rational.","comment":null,"footnote":null}],"slug":"irrational","url":"/meta/potts/irrational/"}