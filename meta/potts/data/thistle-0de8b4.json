{"key":"0de8b4149993a59d","source_file":"Potts Ta - Ti.json","source_id":30479,"source_url":"concordance-thistle-ppl-carduus","term":"Thistle","headwords":["Thistle"],"latin":["Carduus"],"header_pairs":[{"english":["Thistle"],"latin":["Carduus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","TCR"],"contexts":[{"reference":{"work":"AC","section":"272","subsection":null},"text":"The thorn and the thistle () = curse and vastation. AC 273, Explained, Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"439","subsection":"end"},"text":"Thorns, briers, thistles, and thistles = the falsities of evil, from their stings.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"78","subsection":"5"},"text":"With those in Hell, there appear... briers, nettles, thorns, and thistles...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"654","subsection":"56"},"text":"The thistle shall possess them () = that evil will pervert them. ( = that falsity will destroy all truth, AE 799:14.)","comment":null,"footnote":null},{"reference":{"work":"AE","section":"714","subsection":"18"},"text":"Under Thorn, see this reference.","comment":null,"footnote":null}],"slug":"thistle-0de8b4","url":"/meta/potts/thistle-0de8b4/"}