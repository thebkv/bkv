{"key":"ab9126ae28d5fa92","source_file":"Potts Co.json","source_id":64057,"source_url":"concordance-coruscate-ppl-coruscare","term":"Coruscate","headwords":["Coruscate","Coruscation"],"latin":["Coruscare","Coruscatio"],"header_pairs":[{"english":["Coruscate"],"latin":["Coruscare"]},{"english":["Coruscation"],"latin":["Coruscatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1527","subsection":null},"text":"Like bright stars, gleaming according to the quality of their charity and faith.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9865","subsection":"2"},"text":"The colours there coruscate according to the amount of good...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10600","subsection":null},"text":"This is signified by the glittering of the skin of Moses' face. AC 10691. AC 10703. AC 10705.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10691","subsection":null},"text":"To glitter = to shine forth.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"118","subsection":null},"text":"He appears as a Moon, of a similar brightness, but coruscating more than our moon. HH 118:2.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"178","subsection":null},"text":"The most intelligent have garments which coruscate as with flame... HH 179, Explained.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"185","subsection":null},"text":"Where all things coruscate...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"566","subsection":"4"},"text":"Like a coruscating beam...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"42","subsection":"2"},"text":"The coruscation of our Heaven.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4639","subsection":null},"text":"The Sun in the Third Heaven appears... with an intensely flashing flame, the flashing of which is indescribable.","comment":null,"footnote":null}],"slug":"coruscate","url":"/meta/potts/coruscate/"}