{"key":"e2130576a3b66336","source_file":"Potts Rh - Ry.json","source_id":19578,"source_url":"concordance-rule-ppl-regula","term":"Rule","headwords":["Rule"],"latin":["Regula"],"header_pairs":[{"english":["Rule"],"latin":["Regula"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"7236","subsection":"end"},"text":"A general rule in the world...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7270","subsection":"end"},"text":"Evident from a rule not unknown to the learned in the world.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7291","subsection":"end"},"text":"It is a general rule, that... SE 3972.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7343","subsection":"2"},"text":"Evident from the general rule, that... AC 9407:2.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"798","subsection":null},"text":"A universal rule concerning the life after death, that...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2329","subsection":null},"text":"According to the rule, that...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2605","subsection":null},"text":"There has this day been confirmed from Heaven this rule, that...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3662","subsection":null},"text":"Regular, occurs. SE 3666.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3891","subsection":"end"},"text":"Why does he want to reason when he does not know the rules?","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4264","subsection":null},"text":"Man thinks and speaks... according to all the most arcane analytical rules... yet thinks not a whit about rules... The case is the same with charity. Explained.","comment":null,"footnote":null}],"slug":"rule-e21305","url":"/meta/potts/rule-e21305/"}