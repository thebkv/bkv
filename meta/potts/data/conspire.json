{"key":"736ad1a123ce9c80","source_file":"Potts Co.json","source_id":47304,"source_url":"concordance-conspire-ppl-conspirare","term":"Conspire","headwords":["Conspire","Conspiracy"],"latin":["Conspirare","Conspiratio"],"header_pairs":[{"english":["Conspire"],"latin":["Conspirare"]},{"english":["Conspiracy"],"latin":["Conspiratio"]}],"header_sentences":["See Plot."],"redirect_xref":null,"works":["AC","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"589","subsection":"end"},"text":"Conspiring with the foul love of self.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1983","subsection":"3"},"text":"The interiors conspire with the exteriors...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5764","subsection":null},"text":"In Hell all companions combine together for evil.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"266","subsection":"2"},"text":"To such wisdom of the Angels, this also conspires...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"458","subsection":null},"text":"In the Heaven of Spirits a conspiracy was made to suffocate me. General article.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2489","subsection":null},"text":"Everything therein conspires to evil. SE 2668. Occurs. SE 2765. SE 3072. SE 5211. SE 5212. SE 5426.","comment":null,"footnote":null}],"slug":"conspire","url":"/meta/potts/conspire/"}