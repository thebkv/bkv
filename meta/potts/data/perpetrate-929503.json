{"key":"929503a9b5af694d","source_file":"Potts Pa - Pe.json","source_id":34660,"source_url":"concordance-perpetrate-ppl-patrare","term":"Perpetrate","headwords":["Perpetrate","Perpetration"],"latin":["Patrare","Patratio"],"header_pairs":[{"english":["Perpetrate"],"latin":["Patrare"]},{"english":["Perpetration"],"latin":["Patratio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"696","subsection":null},"text":"Perpetrates such torment.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"816","subsection":"2"},"text":"Where he had perpetrated such a deed.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"817","subsection":null},"text":"What he had perpetrated in the world... AC 817.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1008","subsection":"2"},"text":"All things he has ever done there.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9125","subsection":null},"text":"The perpetration of evil in secret. Signified.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"374","subsection":"end"},"text":"Adulteries are perpetrated more within the Church than out of it.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"462","subsection":null},"text":"[462a]. Those who deny the crimes which they have perpetrated in the world.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"113","subsection":null},"text":"He would perpetrate them from freedom...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3680","subsection":null},"text":"Something which they supposed I had perpetrated...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3851","subsection":"end"},"text":"By perpetrating whatever they could; while I... merely reflected upon the things which they were perpetrating.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4543","subsection":null},"text":"He had actually perpetrated something of the kind.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4756","subsection":null},"text":"How they are reduced into terror for the evils which they had perpetrated...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4996","subsection":null},"text":"Among the direful things he was perpetrating...","comment":null,"footnote":null}],"slug":"perpetrate-929503","url":"/meta/potts/perpetrate-929503/"}