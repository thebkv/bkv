{"key":"03642c8a644ffa23","source_file":"Potts De.json","source_id":34946,"source_url":"concordance-destine-to-ppl-destinare","term":"Destine, To","headwords":["Destine, To"],"latin":["Destinare"],"header_pairs":[{"english":["Destine, To"],"latin":["Destinare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLord","SE"],"contexts":[{"reference":{"work":"AC","section":"3072","subsection":null},"text":"Her thou hast appointed for thy son Isaac () = the conjunction of truth Divine with Divine good in the Rational. To appoint for a woman = to conjoin by a covenant of marriage.","comment":null,"footnote":null},{"reference":{"work":"DLord","section":"18","subsection":"2"},"text":"(The notion) that He took away the foreseen or destined damnation.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3383","subsection":null},"text":"Such was his purpose.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4452","subsection":null},"text":"To what Hell these Sirens are destined.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4459","subsection":null},"text":"Until they come to their proper and destined place.","comment":null,"footnote":null}],"slug":"destine-to","url":"/meta/potts/destine-to/"}