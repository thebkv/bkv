{"key":"f1b23272df9a47ae","source_file":"Potts Ma - Me.json","source_id":295,"source_url":"concordance-machine-ppl-machina","term":"Machine","headwords":["Machine"],"latin":["Machina"],"header_pairs":[{"english":["Machine"],"latin":["Machina"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2891","subsection":null},"text":"That thus they would be machines... AC 2946.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3647","subsection":null},"text":"They were like machines...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9293","subsection":null},"text":"Not unlike the movements of a machine...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"233","subsection":"6"},"text":"They stand like dumb machines.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"371","subsection":"end"},"text":"This reciprocal conjunction may be compared to the conjunction of... wheels with a machine.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"683","subsection":null},"text":"Like the sound of... a machine, in which there is no use.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"897","subsection":"end"},"text":"Like a wooden machine.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2043","subsection":null},"text":"Thus that man... would be like a machine...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3633","subsection":"end"},"text":"Spirits see him as an inanimate machine.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4064","subsection":null},"text":"The whole man with his brains, etc., or the whole animated machine...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4722","subsection":null},"text":"As (Polhem) had continually meditated how to construct moving machines... he had confirmed himself in (the idea) that there is no God...","comment":null,"footnote":null}],"slug":"machine","url":"/meta/potts/machine/"}