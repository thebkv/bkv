{"key":"09e1c858c58ca1f5","source_file":"Potts Co.json","source_id":1210,"source_url":"concordance-codex-ppl-codex","term":"Codex","headwords":["Codex"],"latin":["Codex"],"header_pairs":[{"english":["Codex"],"latin":["Codex"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","DSS","TCR"],"contexts":[{"reference":{"work":"AC","section":"4495","subsection":null},"text":"Because they are in the holy codex...","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"20","subsection":null},"text":"All their manuscripts and books were written by correspondences.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"95","subsection":"end"},"text":"These words are omitted in some of the codexes.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"33","subsection":null},"text":"Codicillus, occurs.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"137","subsection":"5"},"text":"As many as the verses in the holy book...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"431","subsection":null},"text":"They would fill a book...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"483","subsection":null},"text":"Like an empty codex...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"487","subsection":"5"},"text":"The codex which you call the holy Word...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"503","subsection":"6"},"text":"What is the Word without it but an empty codex?","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"519","subsection":null},"text":"Like the barks and rinds around rotten wood...","comment":null,"footnote":null}],"slug":"codex","url":"/meta/potts/codex/"}