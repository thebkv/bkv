{"key":"4022c6480e0057f8","source_file":"Potts Wi.json","source_id":32867,"source_url":"concordance-wither-ppl-marcescere","term":"Wither","headwords":["Wither"],"latin":["Marcescere","Emarcescere"],"header_pairs":[{"english":["Wither"],"latin":["Marcescere","Emarcescere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"6078","subsection":"5"},"text":"The spiritual life then... as it were withers.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8699","subsection":null},"text":"In wearing away thou wilt wear away () perish... be consumed by degrees, and thus wither.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"316","subsection":"end"},"text":"Like tulips which... wither.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2665","subsection":null},"text":"In old age the body wastes away of itself...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"627","subsection":"9"},"text":"The reed and flag shall wither () = that ultimate truth... will vanish.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"730","subsection":"15"},"text":"Lebanon hath withered away ()... The devastation and desolation is signified by... to wither away...","comment":null,"footnote":null}],"slug":"wither-4022c6","url":"/meta/potts/wither-4022c6/"}