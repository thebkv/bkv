{"key":"f1eab9fb86a7071c","source_file":"Potts Di.json","source_id":21004,"source_url":"concordance-disunite-ppl-disunire","term":"Disunite","headwords":["Disunite","Disunion"],"latin":["Disunire","Disunio"],"header_pairs":[{"english":["Disunite"],"latin":["Disunire"]},{"english":["Disunion"],"latin":["Disunio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL"],"contexts":[{"reference":{"work":"AC","section":"1594","subsection":null},"text":"Disunion. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1594","subsection":null},"text":"That which disunites the external man from the internal, is unknown... He does not believe that the love of self and its cupidities are the things which disunite... AC 1594:3.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1607","subsection":"end"},"text":"He expelled all evil, which alone disunites.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2057","subsection":"3"},"text":"Thus they destroy everything unanimous... hence disunion, and consequently destruction.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4997","subsection":null},"text":"Evil itself consists in disunion.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"215","subsection":"end"},"text":"From the disunion of their souls and minds they continually think themselves two.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"216","subsection":"4"},"text":"They are then disunited as to marriage love.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"236","subsection":null},"text":"That spiritual cold in marriages is a disunion of souls, and a disjunction of minds...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"242","subsection":"end"},"text":"This we perceive from the internal disunion of their souls.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"331","subsection":null},"text":"Whence comes disunion, and not union.","comment":null,"footnote":null}],"slug":"disunite","url":"/meta/potts/disunite/"}