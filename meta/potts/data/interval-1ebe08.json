{"key":"1ebe0865b072e319","source_file":"Potts In.json","source_id":68643,"source_url":"concordance-interval-ppl-intervallum","term":"Interval","headwords":["Interval"],"latin":["Intervallum"],"header_pairs":[{"english":["Interval"],"latin":["Intervallum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","Coro","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"59","subsection":null},"text":"The Lord gives him food... and this at intervals.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"482","subsection":null},"text":"They have a like signification in the least intervals (of time) as in the greatest. AC 482:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"957","subsection":"end"},"text":"These penalties are repeated at intervals...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"249","subsection":null},"text":"The Spirits with them are removed... at intervals.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"448","subsection":null},"text":"After intervals of time he is taken out (of Hell).","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"20","subsection":null},"text":"In the intervals of the vastation and consummation of the Church...","comment":null,"footnote":null}],"slug":"interval-1ebe08","url":"/meta/potts/interval-1ebe08/"}