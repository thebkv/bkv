{"key":"4e1c025ae7f06736","source_file":"Potts In.json","source_id":24422,"source_url":"concordance-ingenerate-ppl-ingenerare","term":"Ingenerate","headwords":["Ingenerate","Ingeneration"],"latin":["Ingenerare","Ingeneratio"],"header_pairs":[{"english":["Ingenerate"],"latin":["Ingenerare"]},{"english":["Ingeneration"],"latin":["Ingeneratio"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","DLW","TCR"],"contexts":[{"reference":{"work":"DLW","section":"269","subsection":null},"text":"That the things made to be of the love... are ingenerated in the offspring.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"269","subsection":"2"},"text":"Concerning the ingeneration of the love of evil...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"270","subsection":null},"text":"Both ingenerated and superinduced...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"587","subsection":null},"text":"The evils into which a man is born, have been ingenerated into the will of the natural man.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1093","subsection":"4"},"text":"The light is the truth of faith, and the heat is the good of love; both... ingenerated in the Societies with which the man's love acts as one.","comment":null,"footnote":null}],"slug":"ingenerate","url":"/meta/potts/ingenerate/"}