{"key":"e61bac91a7b0ef66","source_file":"Potts Co.json","source_id":65466,"source_url":"concordance-couple-ppl-copula","term":"Couple","headwords":["Couple"],"latin":["Copula","Copulari","Copulatio"],"header_pairs":[{"english":["Couple"],"latin":["Copula","Copulari","Copulatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"55","subsection":"2"},"text":"When the understanding is coupled to the will. AC 672.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"725","subsection":"end"},"text":"There is no truth which is not coupled to good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1096","subsection":"3"},"text":"The copula is then broken.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8983","subsection":"2"},"text":"Not a marriage, but a coupling as of a concubine with a man; which coupling does not correspond to the heavenly marriage.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"299","subsection":"2"},"text":"Lest she should be dragged into a connection with an unloved man.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"320","subsection":"2"},"text":"Conjugial conjunctions, and extra-conjugial couplings.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3217","subsection":null},"text":"(The notion that) the devil was created... as a couple between heavenly and corporeal things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3468","subsection":null},"text":"Coupled with their lasciviousness...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6110","subsection":"5"},"text":"(The copulation of cats.)","comment":null,"footnote":null}],"slug":"couple","url":"/meta/potts/couple/"}