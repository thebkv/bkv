{"key":"6f82ef85f3ea648c","source_file":"Potts Re.json","source_id":43761,"source_url":"concordance-reproduce-ppl-reproducere","term":"Reproduce","headwords":["Reproduce","Reproduction"],"latin":["Reproducere","Reproductio"],"header_pairs":[{"english":["Reproduce"],"latin":["Reproducere"]},{"english":["Reproduction"],"latin":["Reproductio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DWis","HH"],"contexts":[{"reference":{"work":"AC","section":"4205","subsection":"2"},"text":"Are reproduced when a like delight recurs.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4205","subsection":null},"text":"Is reproduced when a like affection recurs. (See AC 4301:4. AC 5489.) AC 5893:2. NJHD 121:4, References.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7835","subsection":"end"},"text":"When the truth is reproduced, the affection... is reproduced.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"461","subsection":"3"},"text":"The natural objects in the memory cannot be reproduced (there). HH 464. HH 464:2. HH 563:end.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"132","subsection":"6"},"text":"How can man... reproduce anything of love and wisdom unless he feels it as his own?","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"5","subsection":"end"},"text":"Their reproduction is reminiscence.","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"5","subsection":null},"text":"10. 2. Affection produces thought, and thought reproduces affection.","comment":null,"footnote":null}],"slug":"reproduce","url":"/meta/potts/reproduce/"}