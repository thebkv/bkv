{"key":"86320418cc8f684d","source_file":"Potts Ea - Es.json","source_id":18333,"source_url":"concordance-ebony-ppl-ebenus","term":"Ebony","headwords":["Ebony"],"latin":["Ebenus"],"header_pairs":[{"english":["Ebony"],"latin":["Ebenus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1172","subsection":null},"text":"Horns of ivory and ebony () = the exterior goods which are of worship or of rituals.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2492","subsection":"2"},"text":"Under Deceit, see this reference.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2596","subsection":null},"text":"Under China, see this reference.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5563","subsection":"end"},"text":"Such have skulls as it were of ebony...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"354","subsection":"2"},"text":"Their heads appear... as it were of ebony, even to the nose...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"344","subsection":null},"text":"(This substitute for Mohammed) sent me an ebony spoon... as a sign that it was from him.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3971","subsection":null},"text":"A horse which was of ebony or of marble...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5662","subsection":null},"text":"a [2]. The man then appears as if of ebony...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5835","subsection":null},"text":"His intelligence was likened to be as it were of ebony inwardly...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1146","subsection":"2"},"text":"(The Rational) is here signified by the ebony which the islands will bring (); for islands = those in the Church who are natural, but still are rational.","comment":null,"footnote":null}],"slug":"ebony","url":"/meta/potts/ebony/"}