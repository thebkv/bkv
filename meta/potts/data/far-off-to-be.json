{"key":"840f850962c093ce","source_file":"Potts Fa - Fe.json","source_id":30610,"source_url":"concordance-far-off-to-be-ppl-elongare","term":"Far off, To be","headwords":["Far off, To be","Removal to a distance"],"latin":["Elongare","Elongatio"],"header_pairs":[{"english":["Far off, To be"],"latin":["Elongare"]},{"english":["Removal to a distance"],"latin":["Elongatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"2685","subsection":null},"text":"To be far off () = to be absent.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7457","subsection":null},"text":"That they would quite remove themselves. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7461","subsection":null},"text":"Not to go far away () = not to be far off.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9261","subsection":null},"text":"Thou shalt set thyself far away () = aversion.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9261","subsection":null},"text":"This is from the removals to a distance which appear in the Spiritual World...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10546","subsection":null},"text":"By removing far from the camp () = remote from those externals...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3606","subsection":null},"text":"Elongata. AE 1024.","comment":null,"footnote":null}],"slug":"far-off-to-be","url":"/meta/potts/far-off-to-be/"}