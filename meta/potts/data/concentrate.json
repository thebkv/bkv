{"key":"b421a2fd3029c7ee","source_file":"Potts Co.json","source_id":22057,"source_url":"concordance-concentrate-ppl-concentrare","term":"Concentrate","headwords":["Concentrate"],"latin":["Concentrare"],"header_pairs":[{"english":["Concentrate"],"latin":["Concentrare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DLW","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"1871","subsection":null},"text":"When they are concentrated in the cylinder...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2057","subsection":"3"},"text":"They concentrate all delight in themselves...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5985","subsection":null},"text":"A subject is one in whom the thoughts and speech of a number are concentrated...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6388","subsection":"2"},"text":"They concentrate the influx of happiness from Heaven in themselves...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"2","subsection":"2"},"text":"They who have not made that idea one, and concentrated it in the Lord...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"255","subsection":"3"},"text":"Thus they concentrate their thoughts, which the Spirit utters.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"23","subsection":null},"text":"All things of human reason... as it were concentrate in this...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"161","subsection":"end"},"text":"When the wife only is loved, the love is concentrated.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"29","subsection":"2"},"text":"Concentrated on the point of a hair...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"67","subsection":null},"text":"Everything of order has been... concentrated in man.","comment":null,"footnote":null}],"slug":"concentrate","url":"/meta/potts/concentrate/"}