{"key":"c2db508de93a6046","source_file":"Potts Do - Dy.json","source_id":28355,"source_url":"concordance-drive-ppl-adigere","term":"Drive","headwords":["Drive"],"latin":["Adigere"],"header_pairs":[{"english":["Drive"],"latin":["Adigere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"1763","subsection":"2"},"text":"They are compelled to speak by others.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4281","subsection":null},"text":"They were compelled by external means...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7276","subsection":null},"text":"That they would be driven by the Divine power. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7290","subsection":null},"text":"They who were in external worship were driven by external means...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7290","subsection":"2"},"text":"Miracles are hurtful... for they drive men to believe...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7392","subsection":null},"text":"That they should not be driven to reason from mere falsities. Signified.","comment":null,"footnote":null}],"slug":"drive","url":"/meta/potts/drive/"}