{"key":"b9aa16142c740dda","source_file":"Potts Et - Ez.json","source_id":6840,"source_url":"concordance-everywhere-ppl-ubivis","term":"Everywhere","headwords":["Everywhere"],"latin":["Ubivis"],"header_pairs":[{"english":["Everywhere"],"latin":["Ubivis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","SE"],"contexts":[{"reference":{"work":"AC","section":"9491","subsection":null},"text":"From within and from without thou shalt overlay it = everywhere.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9640","subsection":null},"text":"Thus shalt thou do with all the boards of the Habitation = so everywhere.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"8","subsection":null},"text":"The Divine is everywhere, and yet not in space.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6045","subsection":null},"text":"The Divine proceeding is everywhere, as the heat and light from the sun are everywhere. Ath 82:end.","comment":null,"footnote":null}],"slug":"everywhere","url":"/meta/potts/everywhere/"}