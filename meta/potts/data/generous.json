{"key":"4e3ee2e604fa3392","source_file":"Potts Ga - Gn.json","source_id":18047,"source_url":"concordance-generous-ppl-generosus","term":"Generous","headwords":["Generous","Generosity"],"latin":["Generosus","Generositas"],"header_pairs":[{"english":["Generous"],"latin":["Generosus"]},{"english":["Generosity"],"latin":["Generositas"]}],"header_sentences":[],"redirect_xref":null,"works":["AR","CL","Coro","DP","SE","TCR"],"contexts":[{"reference":{"work":"DP","section":"254","subsection":"2"},"text":"Like generous wine after fermentation.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"611","subsection":"5"},"text":"There then appears a horse, generous...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"3","subsection":"3"},"text":"Upon their tables there will be generous and noble wines.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"164","subsection":null},"text":"The virtues which pertain to the moral wisdom of men, are... generosity, etc.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"328","subsection":"2"},"text":"Stables in which there are generous horses.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"502","subsection":"2"},"text":"All the hills flowed with generous musts.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2275","subsection":null},"text":"The horses were generous, as they are called.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3971","subsection":null},"text":"They sat on a great horse, black and generous.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4706","subsection":null},"text":"A horse was seen, generous, and running swiftly...","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"40","subsection":"2"},"text":"He is like a tribune riding upon a generous horse.","comment":null,"footnote":null}],"slug":"generous","url":"/meta/potts/generous/"}