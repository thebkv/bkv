{"key":"2b8ed0b437f34c93","source_file":"Potts Ph - Po.json","source_id":24452,"source_url":"concordance-powder-ppl-pollen","term":"Powder","headwords":["Powder"],"latin":["Pollen"],"header_pairs":[{"english":["Powder"],"latin":["Pollen"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","TCR"],"contexts":[{"reference":{"work":"AC","section":"10464","subsection":null},"text":"To grind to powder (), that is, into what is most minute, = to form falsity from infernal delight; thus (it = ) infernal falsity.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"65","subsection":null},"text":"Soil (is from) what is vegetable and animal broken up into the most minute powder.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"362","subsection":null},"text":"Like a pearl reduced to powder.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"585","subsection":"end"},"text":"See Dust.","comment":null,"footnote":null}],"slug":"powder","url":"/meta/potts/powder/"}