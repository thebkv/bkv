{"key":"ba0938c0b8a1a68c","source_file":"Potts Sh - So.json","source_id":36272,"source_url":"concordance-snatch-away-ppl-surripere","term":"Snatch away","headwords":["Snatch away"],"latin":["Surripere"],"header_pairs":[{"english":["Snatch away"],"latin":["Surripere"]}],"header_sentences":[],"redirect_xref":null,"works":["SE","TCR"],"contexts":[{"reference":{"work":"TCR","section":"121","subsection":"3"},"text":"The footstool of the Angels snatched away.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3498","subsection":null},"text":"On the Dutch who deceitfully snatch away the goods of others. AC 5573.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3499","subsection":null},"text":"Wanted to snatch away their ideas.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3499","subsection":null},"text":"That they may pilfer their goods.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3499","subsection":"end"},"text":"They now withdraw privily.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3500","subsection":"end"},"text":"As they can pilfer nothing from them, they have no commerce with them.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3573","subsection":null},"text":"Evil Spirits snatch away truth and good. Explained.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3701","subsection":"end"},"text":"They snatch themselves away from sight.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3883","subsection":null},"text":"They know how to snatch away an idea.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3935","subsection":null},"text":"When I secretly took away the things they had used to destroy me.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3980","subsection":null},"text":"When good works were snatched away from them.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4239","subsection":null},"text":"Some would snatch away those being punished.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4248","subsection":null},"text":"They would snatch away my thought.","comment":null,"footnote":null}],"slug":"snatch-away","url":"/meta/potts/snatch-away/"}