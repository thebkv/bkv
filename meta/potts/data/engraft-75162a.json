{"key":"75162ac5e42797c7","source_file":"Potts Ea - Es.json","source_id":49962,"source_url":"concordance-engraft-ppl-inoculare","term":"Engraft","headwords":["Engraft","Engrafting"],"latin":["Inoculare","Inoculatio"],"header_pairs":[{"english":["Engraft"],"latin":["Inoculare"]},{"english":["Engrafting"],"latin":["Inoculatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","CL","DP","TCR"],"contexts":[{"reference":{"work":"DP","section":"296","subsection":"2"},"text":"Under Engraft, see these references. DP 332:2. TCR 584:2. Inv 4.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"531","subsection":"2"},"text":"Religion... is the initiament and graft of marriage love.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"8","subsection":"3"},"text":"If a thorn is engrafted on a vine, the influx is inverted, and proceeds according to the form of the thorn.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"448","subsection":null},"text":"They are like branches engrafted into branches.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1093","subsection":"3"},"text":"Thoughts from the love of evil... tend towards Hell... and as it were engraft themselves into homogeneous Societies.","comment":null,"footnote":null}],"slug":"engraft-75162a","url":"/meta/potts/engraft-75162a/"}