{"key":"e365596202943d6b","source_file":"Potts In.json","source_id":5649,"source_url":"concordance-indulge-ppl-indulgere","term":"Indulge","headwords":["Indulge","Indulgence"],"latin":["Indulgere","Indulgentia"],"header_pairs":[{"english":["Indulge"],"latin":["Indulgere"]},{"english":["Indulgence"],"latin":["Indulgentia"]}],"header_sentences":[],"redirect_xref":null,"works":["5M","AC","AE","CL","DP","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"605","subsection":"end"},"text":"In those ancient times they did not indulge so much in knowledges...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1514","subsection":null},"text":"They who have indulged in simulatory practices...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1547","subsection":null},"text":"In proportion as a man indulges in pleasures...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8981","subsection":"3"},"text":"They had indulged in worldly loves.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9303","subsection":null},"text":"In His love, and in His indulgence He delivered them ().","comment":null,"footnote":null},{"reference":{"work":"HH","section":"249","subsection":null},"text":"They who have indulged much in phantasies...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"362","subsection":null},"text":"They who indulge in pleasures...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"462","subsection":"2"},"text":"In proportion as they indulge their taste... HH 488:5.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"147","subsection":"2"},"text":"With those who have indulged much in the delights of evil...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"267","subsection":"4"},"text":"They who have indulged their imagination too much...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"505","subsection":"end"},"text":"Dogs of indulgences.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"426","subsection":null},"text":"The concupiscences of the flesh, in which they indulge...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1573","subsection":null},"text":"On those who indulge too much in domestic cares.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2169","subsection":"end"},"text":"Occurs. SE 3462:end. AE 1061:2.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2502","subsection":"2"},"text":"They who begin to indulge in idleness...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2505","subsection":null},"text":"They who solely indulge themselves... SE 2568:end.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4421","subsection":null},"text":"If a father... indulges a wrong-doing son or daughter...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"724","subsection":"25"},"text":"From the heavenly life thence, it is called... the indulgence of your soul ().","comment":null,"footnote":null},{"reference":{"work":"5M","section":"8","subsection":null},"text":"From the indulgence of the imagination...","comment":null,"footnote":null}],"slug":"indulge","url":"/meta/potts/indulge/"}