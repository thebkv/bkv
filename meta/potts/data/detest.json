{"key":"8fa01944530c5b2a","source_file":"Potts De.json","source_id":37735,"source_url":"concordance-detest-ppl-detestari","term":"Detest","headwords":["Detest","Detestation","Detestable"],"latin":["Detestari","Detestatio","Detestabilis"],"header_pairs":[{"english":["Detest"],"latin":["Detestari"]},{"english":["Detestation"],"latin":["Detestatio"]},{"english":["Detestable"],"latin":["Detestabilis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"916","subsection":"end"},"text":"Nowhere is there a more detestable life than in the Christian world.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8148","subsection":"end"},"text":"This kind of evil and falsity... is more detestable than all the rest...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"753","subsection":null},"text":"What is more detestable? (Repeated many times.)","comment":null,"footnote":null},{"reference":{"work":"CL","section":"464","subsection":null},"text":"Concubinage conjointly with a wife... is detestable. General article.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"484","subsection":null},"text":"That detestable saying...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"485","subsection":null},"text":"Predestination, which is detestable. TCR 628.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"509","subsection":null},"text":"Which make man detestable before God...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"453","subsection":null},"text":"They detest the blackness of their bodies.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1866","subsection":null},"text":"Their faces were detestable...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3946","subsection":null},"text":"They detest wives and females...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"827","subsection":"5"},"text":"Images of the abominations of detestations () = all things of it, thus doctrinal things, whose goods and truths are profaned: abominations = goods profaned; and detestations, truths profaned.","comment":null,"footnote":null}],"slug":"detest","url":"/meta/potts/detest/"}