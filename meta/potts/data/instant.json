{"key":"a7e69f187aeb9282","source_file":"Potts In.json","source_id":37400,"source_url":"concordance-instant-ppl-instans","term":"Instant","headwords":["Instant","Instantaneous"],"latin":["Instans","Instantaneus"],"header_pairs":[{"english":["Instant"],"latin":["Instans"]},{"english":["Instantaneous"],"latin":["Instantaneus"]}],"header_sentences":["See Urge."],"redirect_xref":null,"works":["AC","AE","CL","DSS","TCR"],"contexts":[{"reference":{"work":"AC","section":"5188","subsection":"3"},"text":"Seeing in an instant.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6923","subsection":"end"},"text":"Their judgment was instantaneous.","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"63","subsection":"end"},"text":"The evolution (of the internal senses of the Word) is instantaneous.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"389","subsection":null},"text":"Hence whatever proceeds from the Lord is in an instant from primes in ultimates.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"31","subsection":"3"},"text":"Days, years, and ages... are to God an instant.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"614","subsection":"2"},"text":"The remission of sins is not instantaneous...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1211","subsection":"4"},"text":"Creation there is instantaneous; and the duration is... sometimes momentaneous. AE 1226:2.","comment":null,"footnote":null}],"slug":"instant","url":"/meta/potts/instant/"}