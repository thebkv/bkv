{"key":"53c2b9c57d4a0821","source_file":"Potts V.json","source_id":10695,"source_url":"concordance-verge-to-ppl-vergere","term":"Verge, To","headwords":["Verge, To"],"latin":["Vergere"],"header_pairs":[{"english":["Verge, To"],"latin":["Vergere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","HH"],"contexts":[{"reference":{"work":"AC","section":"8226","subsection":null},"text":"To verge to morning () = the presence of the Lord. Explained.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"151","subsection":"2"},"text":"All the direction of their interiors... verges and strives thither.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"275","subsection":null},"text":"Like the decrease of light verging to shade. DLW 199.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"283","subsection":"end"},"text":"Evils verge and look downwards or outwards when the man shuns his evils as sins...","comment":null,"footnote":null}],"slug":"verge-to","url":"/meta/potts/verge-to/"}