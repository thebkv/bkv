{"key":"03c56a3cebd9c18d","source_file":"Potts La - Le.json","source_id":35648,"source_url":"concordance-let-down-ppl-demittere","term":"Let down","headwords":["Let down"],"latin":["Demittere"],"header_pairs":[{"english":["Let down"],"latin":["Demittere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DLW","DP"],"contexts":[{"reference":{"work":"AC","section":"3091","subsection":null},"text":"To let down () = submission.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6854","subsection":null},"text":"It is said of the Lord that He lets Himself down, when He comes to Judgment. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8606","subsection":null},"text":"When he let down his hand () = when the faith with them was looking downwards...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"348","subsection":null},"text":"Goods and truths let down through the Heavens... DP 288.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"79","subsection":"3"},"text":"They were let down from Heaven, and were let into their evils.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"43","subsection":"end"},"text":"The Angel let down the parchment.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"534","subsection":"end"},"text":"The book shall be let down by us from Heaven...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"315","subsection":"13"},"text":"Occurs. AE 537:16.","comment":null,"footnote":null}],"slug":"let-down-03c56a","url":"/meta/potts/let-down-03c56a/"}