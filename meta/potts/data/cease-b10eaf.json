{"key":"b10eaf673320acbd","source_file":"Potts Ca - Ce.json","source_id":16828,"source_url":"concordance-cease-ppl-desinere","term":"Cease","headwords":["Cease"],"latin":["Desinere"],"header_pairs":[{"english":["Cease"],"latin":["Desinere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","DP","TCR"],"contexts":[{"reference":{"work":"AC","section":"726","subsection":"end"},"text":"Being cannot be predicated of those things which cease to be, but of those which never cease to be.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"840","subsection":null},"text":"When temptation ceases...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1356","subsection":null},"text":"At last they cease in mere externals...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1648","subsection":null},"text":"They cease in unities...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1692","subsection":"end"},"text":"The sea would never cease...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4283","subsection":null},"text":"That temptation ceased, Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4284","subsection":null},"text":"That temptation would not cease, Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6587","subsection":null},"text":"Under Cease, see this reference.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"26","subsection":null},"text":"Angelic speech thus... closes in one...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"259","subsection":"end"},"text":"Under Boundary, see this reference.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"260","subsection":null},"text":"Not only would the action cease...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"303","subsection":null},"text":"Under Atmosphere, see this reference.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"304","subsection":null},"text":"Proceed to ultimates... in order that they may cease and subsist.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"318","subsection":null},"text":"The propagation (of seeds) never ceases.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"344","subsection":null},"text":"The bird... would vanish or cease, together with its affection.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"178","subsection":null},"text":"Love with reason ceases in effect.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"351","subsection":"2"},"text":"The human mind... is a spiritual organism ceasing in a natural one.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"760","subsection":null},"text":"This last time of the Christian Church is the very night in which former Churches have ceased.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"762","subsection":null},"text":"Every year... ceases in winter... The sun... ceases in the north.","comment":null,"footnote":null}],"slug":"cease-b10eaf","url":"/meta/potts/cease-b10eaf/"}