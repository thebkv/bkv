{"key":"502d40e6a0199b19","source_file":"Potts Et - Ez.json","source_id":36025,"source_url":"concordance-expert-ppl-solers","term":"Expert","headwords":["Expert","Expertly","Skilfully","Expertness"],"latin":["Solers","Solerter","Solertia"],"header_pairs":[{"english":["Expert"],"latin":["Solers"]},{"english":["Expertly","Skilfully"],"latin":["Solerter"]},{"english":["Expertness"],"latin":["Solertia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1637","subsection":null},"text":"Spirits speak so skillfully in man's vernacular...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8378","subsection":"end"},"text":"Hence comes stupidity in the things of thought and judgment; and shrewdness in those of the body and the world.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10236","subsection":"7"},"text":"The sensuous man is expert above others in ratiocinating, and in acting for the sake of gains and honours... HH 353:3.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"385","subsection":null},"text":"Certain Spirits... infested me with a peculiar expertness...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"164","subsection":null},"text":"The virtues which belong to the moral wisdom of the men, are expertness, etc.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2744","subsection":null},"text":"And this with such expertness, that...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5956","subsection":null},"text":"On expertness in calculating in the Spiritual World.","comment":null,"footnote":null}],"slug":"expert-502d40","url":"/meta/potts/expert-502d40/"}