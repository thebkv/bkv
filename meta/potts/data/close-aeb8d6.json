{"key":"aeb8d6db587a55a1","source_file":"Potts Ci - Cl.json","source_id":10476,"source_url":"concordance-close-ppl-arctus","term":"Close","headwords":["Close","Closely","Keep away"],"latin":["Arctus","Arcte","Arcere"],"header_pairs":[{"english":["Close"],"latin":["Arctus"]},{"english":["Closely"],"latin":["Arcte"]},{"english":["Keep away"],"latin":["Arcere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","HH","LJ","TCR"],"contexts":[{"reference":{"work":"AC","section":"653","subsection":null},"text":"The Spirits who excite cupidities are entirely kept away from the man.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5835","subsection":null},"text":"Close conjunction. Signified. (See Conjoin.)","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8356","subsection":"end"},"text":"When evil begins to keep away the influx of good...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8838","subsection":null},"text":"Thus they may be kept away from the Divine. Signified.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"295","subsection":"end"},"text":"In proportion as man cannot be kept from evil by good Spirits...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"449","subsection":"2"},"text":"Thus are evil Spirits kept away from the spirit of man when he is first being introduced into eternal life.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"531","subsection":"2"},"text":"Unless the civil laws... restrained him...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"579","subsection":"2"},"text":"Genii... are kept away by the Lord from every man of whose reformation there is any hope.","comment":null,"footnote":null},{"reference":{"work":"LJ","section":"12","subsection":null},"text":"A closer... conjunction.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"262","subsection":"end"},"text":"He successively shuts up the spiritual mind closer and closer...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"442","subsection":null},"text":"Charity and faith in the Lord are closely conjoined.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"607","subsection":null},"text":"The conjunction... between men, and Angels and Spirits, is so close...","comment":null,"footnote":null}],"slug":"close-aeb8d6","url":"/meta/potts/close-aeb8d6/"}