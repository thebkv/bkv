{"key":"6f1137beae47586c","source_file":"Potts In.json","source_id":72468,"source_url":"concordance-invite-ppl-invitare","term":"Invite","headwords":["Invite","Invitation"],"latin":["Invitare","Invitatio"],"header_pairs":[{"english":["Invite"],"latin":["Invitare"]},{"english":["Invitation"],"latin":["Invitatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DeConsum","TCR","TCRAdd"],"contexts":[{"reference":{"work":"AC","section":"2330","subsection":null},"text":"An invitation. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3140","subsection":null},"text":"An invitation of the Divine with itself, Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3140","subsection":"end"},"text":"It is truth Divine which... is invited.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"377","subsection":"2"},"text":"Hence an invitation to love by a wife cools the whole man; but an invitation to love by a concubine not so...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"358","subsection":null},"text":"Invitation, or calling, is universal.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"366","subsection":"2"},"text":"The good... invite God...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"331","subsection":"5"},"text":"The invitation of all to the Church. Treated of.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"948","subsection":"2"},"text":"The New Church, into which are invited those who are of the former Church...","comment":null,"footnote":null},{"reference":{"work":"DeConsum","section":"1","subsection":null},"text":"De Consummatione Saeculi. An invitation to the universal world to the New Church. Coro 4. Inv 9.","comment":null,"footnote":null},{"reference":{"work":"TCRAdd","section":"1","subsection":null},"text":"The Angels said that they would invite me sometimes to their meetings.","comment":null,"footnote":null}],"slug":"invite","url":"/meta/potts/invite/"}