{"key":"fd27350a2ad3db03","source_file":"Potts Pa - Pe.json","source_id":2860,"source_url":"concordance-palaestra-ppl-palaestra","term":"Palaestra","headwords":["Palaestra","Wrestling"],"latin":["Palaestra","Palaestricus"],"header_pairs":[{"english":["Palaestra"],"latin":["Palaestra"]},{"english":["Wrestling"],"latin":["Palaestricus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL","DLove","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"4741","subsection":"end"},"text":"Believes them to be taken from the school of wisdom.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"566","subsection":"4"},"text":"You said that we have not any truth in our schools.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"839","subsection":"5"},"text":"A plain elevated like a wrestling-ground. They... entered into the wrestling-ground.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"6","subsection":"4"},"text":"Follow me to the ways of exit from this place of sports.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"17","subsection":"4"},"text":"There are wrestling contests among the boys...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"694","subsection":"6"},"text":"The games, so called, were spiritual exercises and trials of skill.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3212","subsection":null},"text":"Concerning a palaestra.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4547","subsection":null},"text":"On the right are the brothels of the lascivious.","comment":null,"footnote":null},{"reference":{"work":"DLove","section":"17","subsection":null},"text":"Use is as the plain or theatre of the exercise of the love.","comment":null,"footnote":null}],"slug":"palaestra","url":"/meta/potts/palaestra/"}