{"key":"604893307c21f970","source_file":"Potts In.json","source_id":35601,"source_url":"concordance-insist-ppl-insistere","term":"Insist","headwords":["Insist"],"latin":["Insistere"],"header_pairs":[{"english":["Insist"],"latin":["Insistere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"9166","subsection":"5"},"text":"The truth Divine in Heaven stands upon the literal sense.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10396","subsection":"4"},"text":"That nation was received because it insisted.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10430","subsection":null},"text":"That it is not to be so obstinately insisted upon. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10430","subsection":null},"text":"That nation was received, because it had obstinately insisted.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10612","subsection":null},"text":"It was so done because they had insisted. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10612","subsection":null},"text":"For they had insisted that they should be introduced into the Land of Canaan.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"291","subsection":null},"text":"It is insisted on by the men, that...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1259","subsection":"end"},"text":"He insisted that he was innocent.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3852","subsection":null},"text":"They seem to have nothing on which they may stand.","comment":null,"footnote":null}],"slug":"insist","url":"/meta/potts/insist/"}