{"key":"31fd0e7f3ceae875","source_file":"Potts Di.json","source_id":12914,"source_url":"concordance-discriminate-ppl-discriminare","term":"Discriminate","headwords":["Discriminate","Discrimination"],"latin":["Discriminare","Discriminatio"],"header_pairs":[{"english":["Discriminate"],"latin":["Discriminare"]},{"english":["Discrimination"],"latin":["Discriminatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","LJCont","SE"],"contexts":[{"reference":{"work":"AC","section":"1378","subsection":null},"text":"From the discriminations of sound learned by use...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1624","subsection":null},"text":"A brightness which was varied and discriminated by another brightness...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3862","subsection":"6"},"text":"In the discriminations of light there is everything which belongs to the life of truth...","comment":null,"footnote":null},{"reference":{"work":"LJCont","section":"64","subsection":"end"},"text":"If the Lord alone is not worshipped, there takes place a discrimination, which takes away the communion...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3906","subsection":null},"text":"The innumerable differences which discriminate Societies.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"790","subsection":"8"},"text":"Genuine truths are there discriminated and separated from falsities.","comment":null,"footnote":null}],"slug":"discriminate","url":"/meta/potts/discriminate/"}