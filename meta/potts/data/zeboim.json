{"key":"3771a9b434b87917","source_file":"Potts Z.json","source_id":1085,"source_url":"concordance-zeboim-ppl-zeboim","term":"Zeboim","headwords":["Zeboim"],"latin":["Zeboim"],"header_pairs":[{"english":["Zeboim"],"latin":["Zeboim"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"1212","subsection":null},"text":"See Sodom. AC 1666.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1663","subsection":null},"text":"Shemeber king of Zeboim, etc. () = so many kinds of cupidities of evil, and of persuasions of falsity, against which the Lord fought... It is the most general, or most universal kinds of evils and falsities, that are here signified.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"578","subsection":"3"},"text":"Mentioned.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"653","subsection":"end"},"text":"Admah and Zeboim () = the Knowledges of evil and falsity.","comment":null,"footnote":null}],"slug":"zeboim","url":"/meta/potts/zeboim/"}