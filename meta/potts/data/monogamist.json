{"key":"13a1e214ed68314d","source_file":"Potts Mi - My.json","source_id":20389,"source_url":"concordance-monogamist-ppl-monogamus","term":"Monogamist","headwords":["Monogamist","Monogamous"],"latin":["Monogamus","Monogamicus"],"header_pairs":[{"english":["Monogamist"],"latin":["Monogamus"]},{"english":["Monogamous"],"latin":["Monogamicus"]}],"header_sentences":["See Wife."],"redirect_xref":null,"works":["CL"],"contexts":[{"reference":{"work":"CL","section":"70","subsection":null},"text":"For monogamous marriages correspond to the marriage of the Lord and the Church...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"77","subsection":"4"},"text":"We counsel you to live monogamists...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"77","subsection":"5"},"text":"Therefore all of us in this Heaven are monogamists...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"141","subsection":null},"text":"That chastity is predicated solely of monogamous marriages, or those of one man with one wife. Explained.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"369","subsection":null},"text":"That spiritual jealousy exists with monogamists, and natural with polygamists. Explained.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"369","subsection":null},"text":"In the Christian world, where there are monogamous marriages...","comment":null,"footnote":null}],"slug":"monogamist","url":"/meta/potts/monogamist/"}