{"key":"933b336138150d9b","source_file":"Potts Mi - My.json","source_id":2163,"source_url":"concordance-mild-ppl-mitis","term":"Mild","headwords":["Mild","Mild, To become"],"latin":["Mitis","Mitescere"],"header_pairs":[{"english":["Mild"],"latin":["Mitis"]},{"english":["Mild, To become"],"latin":["Mitescere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DP","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"987","subsection":null},"text":"The gentle beasts correspond to good affections. HH 110.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1007","subsection":"end"},"text":"Why such mild words are here used.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3909","subsection":null},"text":"Every natural affection, when it ascends towards interior things... becomes milder... AC 3909.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4681","subsection":null},"text":"The signification of this word becomes mild as it ascends...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5032","subsection":"2"},"text":"(Those in natural good) are mild and upright hereditarily...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5032","subsection":"end"},"text":"They had done good like gentle animals...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6489","subsection":"end"},"text":"He is bent... into a milder Hell... AC 8391:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6516","subsection":"end"},"text":"A milder (pronunciation).","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7426","subsection":null},"text":"Two kinds of men in Venus... one, gentle and humane...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8311","subsection":null},"text":"If falsities are applied to good, they become mild...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9192","subsection":"7"},"text":"As the falsities thence are mild and flexible...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"359","subsection":null},"text":"Learn of Me, because I am meek... ().","comment":null,"footnote":null},{"reference":{"work":"HH","section":"578","subsection":"end"},"text":"Therefore their Hells are milder.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"586","subsection":"2"},"text":"In the milder Hells, appear...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"86","subsection":"end"},"text":"With the good, the evils in the circumferences become mild...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"487","subsection":null},"text":"That adulteries committed by these are mild.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"473","subsection":"end"},"text":"The mild beasts receive (influx) through Heaven...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5932","subsection":"end"},"text":"This Hell was among the milder ones.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"304","subsection":"44"},"text":"Blessed are the meek... The meek = those who are in the good of charity.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1006","subsection":"2"},"text":"Adulteries originating from the milder evils and derivative falsities are milder.","comment":null,"footnote":null}],"slug":"mild","url":"/meta/potts/mild/"}