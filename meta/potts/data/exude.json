{"key":"deeed2cfb15ba089","source_file":"Potts Et - Ez.json","source_id":46008,"source_url":"concordance-exude-ppl-exundare","term":"Exude","headwords":["Exude"],"latin":["Exundare"],"header_pairs":[{"english":["Exude"],"latin":["Exundare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"814","subsection":null},"text":"Such a stench exudes...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6057","subsection":"2"},"text":"Love to the Lord and charity towards the neighbour pour forth from (the Angels). AC 6135:3. AC 8370:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7454","subsection":"3"},"text":"Such a sphere exudes from the spirit of man.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8210","subsection":"2"},"text":"The falsities which pour forth from evils...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8630","subsection":null},"text":"From every Society there continually emane, nay, pour forth, these spheres... CL 171.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9303","subsection":"5"},"text":"The sphere... which pours forth from him to a distance. HH 591. DLW 293. TCR 410:end. TCR 521.","comment":null,"footnote":null}],"slug":"exude","url":"/meta/potts/exude/"}