{"key":"6bc6e18fc3792117","source_file":"Potts Fl - Fu.json","source_id":33737,"source_url":"concordance-fox-ppl-vulpes","term":"Fox","headwords":["Fox"],"latin":["Vulpes","Vulpinus"],"header_pairs":[{"english":["Fox"],"latin":["Vulpes","Vulpinus"]}],"header_sentences":[],"redirect_xref":null,"works":["DP","SE","TCR"],"contexts":[{"reference":{"work":"DP","section":"311","subsection":"3"},"text":"They who are in their own prudence are like wolves and foxes.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"13","subsection":"end"},"text":"They become foxes in cunning.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"34","subsection":"3"},"text":"He becomes as to love like a fox.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"383","subsection":"end"},"text":"They cannot dwell together, any more than... a fox in a hencoop.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3191","subsection":"2"},"text":"See Adultery.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3867","subsection":null},"text":"They set huge dogs, foxes, etc., upon men...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4151","subsection":null},"text":"A cloak lined with fox skin.","comment":null,"footnote":null}],"slug":"fox","url":"/meta/potts/fox/"}