{"key":"7454b0df378292c5","source_file":"Potts Ma - Me.json","source_id":20151,"source_url":"concordance-march-ppl-incedere","term":"March","headwords":["March"],"latin":["Incedere"],"header_pairs":[{"english":["March"],"latin":["Incedere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","HH"],"contexts":[{"reference":{"work":"AC","section":"6419","subsection":null},"text":"See Daughter.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6419","subsection":null},"text":"To march upon a wall = to fight against falsity. Explained.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"358","subsection":null},"text":"Man has no need to march along devout, sad...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"328","subsection":"8"},"text":"His Divine power from which He fought, is signified by marching in the multitude of His strength ().","comment":null,"footnote":null},{"reference":{"work":"AE","section":"587","subsection":"6"},"text":"To speak, and to go () = to live.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"828","subsection":"2"},"text":"They go naked.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"864","subsection":"4"},"text":"For it is said that He goeth before His own sheep ().","comment":null,"footnote":null}],"slug":"march-7454b0","url":"/meta/potts/march-7454b0/"}