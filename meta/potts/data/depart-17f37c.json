{"key":"17f37c00b07180e2","source_file":"Potts De.json","source_id":26903,"source_url":"concordance-depart-ppl-discedere","term":"Depart","headwords":["Depart","Departure"],"latin":["Discedere","Discessus"],"header_pairs":[{"english":["Depart"],"latin":["Discedere"]},{"english":["Departure"],"latin":["Discessus"]}],"header_sentences":["See Journey, and Move away."],"redirect_xref":null,"works":["AC","AE","SE"],"contexts":[{"reference":{"work":"AC","section":"2559","subsection":null},"text":"When God made me depart from my father's house () = when He left behind what is scientific and the appearances thence, with their delights... To depart = to leave behind.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7972","subsection":null},"text":"The first state of departure, and its quality. Signified.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"192","subsection":null},"text":"The approach and the departure (of Spirits).","comment":null,"footnote":null},{"reference":{"work":"SE","section":"313","subsection":null},"text":"Some had departed [this life] a few years before.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"617","subsection":"18"},"text":"Depart from Me, workers of iniquity (). Explained.","comment":null,"footnote":null}],"slug":"depart-17f37c","url":"/meta/potts/depart-17f37c/"}