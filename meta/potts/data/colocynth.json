{"key":"9b6e200226ce0db5","source_file":"Potts Co.json","source_id":3516,"source_url":"concordance-colocynth-ppl-colocynthis","term":"Colocynth","headwords":["Colocynth","Gourds"],"latin":["Colocynthis"],"header_pairs":[{"english":["Colocynth","Gourds"],"latin":["Colocynthis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","TCR"],"contexts":[{"reference":{"work":"AC","section":"8408","subsection":"5"},"text":"Gourds from a wild vine () = falsification.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10105","subsection":"3"},"text":"A wild vine, and gourds = falsities and evils.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10235","subsection":"5"},"text":"The knops upon the brazen sea ().","comment":null,"footnote":null},{"reference":{"work":"AR","section":"411","subsection":"end"},"text":"The like is signified by the gourds put into the pottage...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"148","subsection":null},"text":"It is like the gourds which... they put into the pottage...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"618","subsection":"6"},"text":"The pottage into which they put bitter gourds = the Word falsified.","comment":null,"footnote":null}],"slug":"colocynth","url":"/meta/potts/colocynth/"}