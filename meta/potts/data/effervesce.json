{"key":"fda911c98bdbc492","source_file":"Potts Ea - Es.json","source_id":21231,"source_url":"concordance-effervesce-ppl-effervescere","term":"Effervesce","headwords":["Effervesce","Effervescence"],"latin":["Effervescere","Effervescentia"],"header_pairs":[{"english":["Effervesce"],"latin":["Effervescere"]},{"english":["Effervescence"],"latin":["Effervescentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","HH"],"contexts":[{"reference":{"work":"AC","section":"9492","subsection":null},"text":"Whence there appears there as it were an effervescence, and as it were a boiling up.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"134","subsection":"end"},"text":"To effervesce (is used in common conversation of the affections).","comment":null,"footnote":null},{"reference":{"work":"CL","section":"440","subsection":"end"},"text":"Are nothing but the effervescences of lusts...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1143","subsection":"5"},"text":"Their heat from that fire is like the effervescence from lees...","comment":null,"footnote":null}],"slug":"effervesce","url":"/meta/potts/effervesce/"}