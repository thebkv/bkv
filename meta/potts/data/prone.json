{"key":"09b64413408bb955","source_file":"Potts Pr - Py.json","source_id":28883,"source_url":"concordance-prone-ppl-pronus","term":"Prone","headwords":["Prone","Proneness"],"latin":["Pronus","Pronitas"],"header_pairs":[{"english":["Prone"],"latin":["Pronus"]},{"english":["Proneness"],"latin":["Pronitas"]}],"header_sentences":["See Proclivity."],"redirect_xref":null,"works":["AC","Coro","DSS","SE"],"contexts":[{"reference":{"work":"AC","section":"831","subsection":null},"text":"Such are very prone to adulteries.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"977","subsection":"2"},"text":"With an unregenerate man there is... cupidity, and thence a proneness to all evil.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1094","subsection":"2"},"text":"Such are very prone to adore every idol...","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"52","subsection":null},"text":"Their mind is prone to errors.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2351","subsection":null},"text":"Proneness to anger is turned into zeal.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2457","subsection":null},"text":"So that the man is no longer prone to that evil.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3598","subsection":"end"},"text":"After one actuality (of adultery) they are prone to cruelty.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"35","subsection":null},"text":"From these are derived... pronenesses to evils.","comment":null,"footnote":null}],"slug":"prone","url":"/meta/potts/prone/"}