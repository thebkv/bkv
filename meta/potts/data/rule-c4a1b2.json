{"key":"c4a1b27044175691","source_file":"Potts Rh - Ry.json","source_id":18305,"source_url":"concordance-rule-ppl-norma","term":"Rule","headwords":["Rule"],"latin":["Norma"],"header_pairs":[{"english":["Rule"],"latin":["Norma"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","BE","CL","DMin"],"contexts":[{"reference":{"work":"AC","section":"2235","subsection":null},"text":"It has the law for its rule.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6637","subsection":"2"},"text":"So that doctrine is the rule of life.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8899","subsection":null},"text":"The precepts of the decalogue are for rules both for those in the world and those in Heaven.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9192","subsection":null},"text":"All worship has for its rules doctrinals...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"147","subsection":null},"text":"It is a universal rule that...","comment":null,"footnote":null},{"reference":{"work":"BE","section":"84","subsection":"end"},"text":"It is a general rule of religion that...","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4744","subsection":"end"},"text":"Occurs.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"345","subsection":"end"},"text":"The rule... that the understanding must be under some blind obedience to faith.","comment":null,"footnote":null}],"slug":"rule-c4a1b2","url":"/meta/potts/rule-c4a1b2/"}