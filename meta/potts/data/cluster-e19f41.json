{"key":"e19f41863014a271","source_file":"Potts Ci - Cl.json","source_id":15435,"source_url":"concordance-cluster-ppl-glomus","term":"Cluster","headwords":["Cluster"],"latin":["Glomus","Glomerare"],"header_pairs":[{"english":["Cluster"],"latin":["Glomus","Glomerare"]}],"header_sentences":[],"redirect_xref":null,"works":["BE","CL","Inv","SE","TCR"],"contexts":[{"reference":{"work":"CL","section":"2","subsection":"end"},"text":"Each company clustered themselves into a ring...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"427","subsection":null},"text":"A conglobated heap or ball...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"427","subsection":"end"},"text":"The evil of adultery is a ball of concupiscences of evil.","comment":null,"footnote":null},{"reference":{"work":"BE","section":"56","subsection":null},"text":"Joined together as into one ball...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"174","subsection":"2"},"text":"Clusters of wicked heresies...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"178","subsection":"end"},"text":"(A spider's ball of eggs.)","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"361","subsection":"end"},"text":"Like a cluster of serpents in a cavern...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"539","subsection":"2"},"text":"Innumerable concupiscences inhere in every evil, as in a cluster...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2274","subsection":null},"text":"Clumps of cloud...","comment":null,"footnote":null},{"reference":{"work":"Inv","section":"8","subsection":null},"text":"Every concupiscence... is a cluster and heap of many; the man sees only this cluster.","comment":null,"footnote":null}],"slug":"cluster-e19f41","url":"/meta/potts/cluster-e19f41/"}