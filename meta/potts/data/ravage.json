{"key":"e77fe58cbcd998bc","source_file":"Potts Ra.json","source_id":11425,"source_url":"concordance-ravage-ppl-depopulari","term":"Ravage","headwords":["Ravage","Laying waste, A"],"latin":["Depopulari","Depopulatio"],"header_pairs":[{"english":["Ravage"],"latin":["Depopulari"]},{"english":["Laying waste, A"],"latin":["Depopulatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DFaith","TCR"],"contexts":[{"reference":{"work":"AC","section":"6405","subsection":null},"text":"A troop shall ravage him () = that works without judgment will drive away from the truth. Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6406","subsection":null},"text":"He shall ravage the heel () = inordination thence in the Natural. Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10227","subsection":"4"},"text":"To ravage the treasures and the wealth of the peoples () = to destroy the truths of intelligence and wisdom.","comment":null,"footnote":null},{"reference":{"work":"DFaith","section":"67","subsection":"end"},"text":"That thus all things of the worship of the Lord and of His Church are ravaged. Signified.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"454","subsection":null},"text":"These lusts ravage conjugial love...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"117","subsection":null},"text":"Plunder the goods of the inhabitants.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"588","subsection":null},"text":"He would plunder and slaughter all who do not favour him.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"403","subsection":null},"text":"Which the natural man has laid waste by his ratiocinations.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"403","subsection":"3"},"text":"A laying waste by the falsities of evil. Signified.","comment":null,"footnote":null}],"slug":"ravage","url":"/meta/potts/ravage/"}