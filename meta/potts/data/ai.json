{"key":"e4a3571737645c75","source_file":"Potts Aa - Am.json","source_id":37099,"source_url":"concordance-ai-ppl-aj","term":"Ai","headwords":["Ai"],"latin":["Aj"],"header_pairs":[{"english":["Ai"],"latin":["Aj"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"1401","subsection":null},"text":"The mountain that had Bethel on the sea and Ai on the east = the Lord's fourth state.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1453","subsection":null},"text":"Bethel on the sea and Ai on the east = that as yet His state was obscure, namely as to knowledges of celestial and spiritual things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1453","subsection":null},"text":"Ai = knowledges of worldly things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1557","subsection":null},"text":"Between Bethel and Ai = the celestial and the worldly things of knowledges... Ai = light from worldly things.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"435","subsection":"7"},"text":"Ai = doctrine of truth.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"655","subsection":"8"},"text":"Ai = knowledges of good; in the opposite, confirmations of evil.","comment":null,"footnote":null}],"slug":"ai","url":"/meta/potts/ai/"}