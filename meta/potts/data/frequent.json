{"key":"4a1afaae9ed11234","source_file":"Potts Fl - Fu.json","source_id":42292,"source_url":"concordance-frequent-ppl-frequentare","term":"Frequent","headwords":["Frequent","Frequent","Frequenting"],"latin":["Frequentare","Frequens","Frequentatio"],"header_pairs":[{"english":["Frequent"],"latin":["Frequentare"]},{"english":["Frequent"],"latin":["Frequens"]},{"english":["Frequenting"],"latin":["Frequentatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"831","subsection":null},"text":"They had frequented churches. AC 1094. AC 1175. AR 659:end. SE 5792 1.2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1063","subsection":"end"},"text":"Provided he frequents sacred things. SE 4854.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4327","subsection":null},"text":"By frequent use.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8253","subsection":null},"text":"To frequent places of worship. AC 8762. HH 222. DLife 25. AR 859:3.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"358","subsection":null},"text":"To frequent places of amusement.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"699","subsection":"2"},"text":"They frequent the Holy Supper from their youth.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1692","subsection":null},"text":"Like others, they frequent divine worship.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2777","subsection":"end"},"text":"They had frequented a place of worship.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2778","subsection":null},"text":"What is the use of the frequenting of preachings, and of the Holy Supper, merely as a ritual?","comment":null,"footnote":null}],"slug":"frequent","url":"/meta/potts/frequent/"}