{"key":"1c814733da4d6ddc","source_file":"Potts Ma - Me.json","source_id":52824,"source_url":"concordance-mention-ppl-mentio","term":"Mention","headwords":["Mention"],"latin":["Mentio"],"header_pairs":[{"english":["Mention"],"latin":["Mentio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","HH"],"contexts":[{"reference":{"work":"AC","section":"10076","subsection":null},"text":"The mention (of profanation) is not tolerated in Heaven.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"380","subsection":null},"text":"At the mere mention of blessedness thence they laugh...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"700","subsection":"35"},"text":"That there would no longer be external worship, but internal, is signified by, It shall not ascend upon the heart; nor shall they make mention of it... ().","comment":null,"footnote":null}],"slug":"mention-1c8147","url":"/meta/potts/mention-1c8147/"}