{"key":"e15e790853986c88","source_file":"Potts Ta - Ti.json","source_id":47000,"source_url":"concordance-tiger-ppl-tigris","term":"Tiger","headwords":["Tiger"],"latin":["Tigris"],"header_pairs":[{"english":["Tiger"],"latin":["Tigris"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","Coro","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2745","subsection":null},"text":"Women who do not love their husbands but hold them cheap... are represented by a tiger of a dark colour, etc.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8622","subsection":"end"},"text":"Inwardly they were deceitful tigers.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"13","subsection":"4"},"text":"They who believe themselves to be like the beasts, become... tigers as to cruelty.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"649","subsection":null},"text":"Like one who should flee from a wolf and fall upon a tiger.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2974","subsection":null},"text":"He wanted to suck my blood, as tigers are wont to do.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5498","subsection":null},"text":"Those in the Hell of assassins and poisoners appear like tigers and panthers...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6110","subsection":"80"},"text":"Hence (such) are among tigers, etc.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1200","subsection":"3"},"text":"In the Hells are seen tigers, etc.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"35","subsection":"2"},"text":"One man is like a sporting calf, another like a devouring tiger.","comment":null,"footnote":null}],"slug":"tiger","url":"/meta/potts/tiger/"}