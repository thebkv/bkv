{"key":"4adf19191e3006cb","source_file":"Potts Sp - Sq.json","source_id":47050,"source_url":"concordance-sponge-ppl-spongia","term":"Sponge","headwords":["Sponge","Spongy"],"latin":["Spongia","Spongiosus"],"header_pairs":[{"english":["Sponge"],"latin":["Spongia"]},{"english":["Spongy"],"latin":["Spongiosus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","Coro","DMin","HH","ISB","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"831","subsection":"2"},"text":"They are like sponges... SE 2743.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2490","subsection":null},"text":"They enter like water into sponges. SE 4822:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3563","subsection":"end"},"text":"Like a sponge which absorbs water both clear and foul. AC 9382:2.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"354","subsection":null},"text":"They (there) imbibe falsity as a sponge does water. DP 17. AE 118:2.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"479","subsection":"5"},"text":"Love is like spongy and porous wood...","comment":null,"footnote":null},{"reference":{"work":"ISB","section":"12","subsection":"3"},"text":"Like noble wine in a clean sponge.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"364","subsection":null},"text":"Man would (then) be, as to his flesh, a mere sponge.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6072","subsection":null},"text":"Idleness is like a sponge...","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4737","subsection":null},"text":"The excrescences on trees, which are like a sponge or other mouldiness.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"627","subsection":"end"},"text":"They placed the filled sponge on a reed (). Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"695","subsection":"end"},"text":"As a sponge imbibes water and oil.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"28","subsection":"2"},"text":"Man's mind would then be like a sponge, which imbibes water largely, but cannot evacuate it.","comment":null,"footnote":null}],"slug":"sponge","url":"/meta/potts/sponge/"}