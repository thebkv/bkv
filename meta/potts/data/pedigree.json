{"key":"95a872edccbcfafb","source_file":"Potts Pa - Pe.json","source_id":18467,"source_url":"concordance-pedigree-ppl-stemma","term":"Pedigree","headwords":["Pedigree"],"latin":["Stemma"],"header_pairs":[{"english":["Pedigree"],"latin":["Stemma"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","TCR"],"contexts":[{"reference":{"work":"CL","section":"250","subsection":"end"},"text":"In the Heavens... virgins given in marriage do not know of what pedigree they are.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"300","subsection":null},"text":"No one there retains the name he had received from his father or ancestors.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"320","subsection":null},"text":"Proclaim that they are noblemen from an ancient pedigree.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"724","subsection":"end"},"text":"Those who derive their pedigree from the Lord through regeneration.","comment":null,"footnote":null}],"slug":"pedigree","url":"/meta/potts/pedigree/"}