{"key":"3a1039b7f156a136","source_file":"Potts Wa - Wh.json","source_id":11538,"source_url":"concordance-wave-ppl-unda","term":"Wave","headwords":["Wave","Wave, To","Streaming, A"],"latin":["Unda","Undare","Undatio"],"header_pairs":[{"english":["Wave"],"latin":["Unda"]},{"english":["Wave, To"],"latin":["Undare"]},{"english":["Streaming, A"],"latin":["Undatio"]}],"header_sentences":["See Undulation."],"redirect_xref":null,"works":["AC","AE","HH"],"contexts":[{"reference":{"work":"AC","section":"2733","subsection":null},"text":"A gentle influx as it were waving...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6200","subsection":null},"text":"The material ideas of thought appeared in the midst of a kind of wave. Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6853","subsection":"end"},"text":"Immersion in falsities appears there like one immersed in waves. Described.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8733","subsection":"end"},"text":"With the celestial... what is of their will rolls itself... into what is like a wave...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9297","subsection":"end"},"text":"From the sphere that streams from them.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"240","subsection":"end"},"text":"The particulars of the thought and speech of the Angels... appear like a limpid stream or atmosphere ...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"342","subsection":"3"},"text":"See Sea.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"538","subsection":"12"},"text":"See Wave.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"822","subsection":"3"},"text":"This spiritual sphere manifests itself... as a streaming.","comment":null,"footnote":null}],"slug":"wave-3a1039","url":"/meta/potts/wave-3a1039/"}