{"key":"a7d3742664b7fd83","source_file":"Potts Ea - Es.json","source_id":39190,"source_url":"concordance-emigrate-ppl-emigrare","term":"Emigrate","headwords":["Emigrate"],"latin":["Emigrare"],"header_pairs":[{"english":["Emigrate"],"latin":["Emigrare"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","ISB","SE"],"contexts":[{"reference":{"work":"ISB","section":"11","subsection":"3"},"text":"When, by death, the soul emigrates from the natural world into its spiritual one...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3516","subsection":null},"text":"They would have emigrated with the wealth they had acquired.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1218","subsection":"3"},"text":"He does not know... that he has emigrated out of the world of his body into the World of his spirit.","comment":null,"footnote":null}],"slug":"emigrate","url":"/meta/potts/emigrate/"}