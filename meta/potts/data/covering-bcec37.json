{"key":"bcec3790de065078","source_file":"Potts Co.json","source_id":68133,"source_url":"concordance-covering-ppl-involucrum","term":"Covering","headwords":["Covering"],"latin":["Involucrum"],"header_pairs":[{"english":["Covering"],"latin":["Involucrum"]}],"header_sentences":[],"redirect_xref":null,"works":["DLW","DP","TCR"],"contexts":[{"reference":{"work":"DLW","section":"257","subsection":"6"},"text":"They constitute the cutaneous covering of the spiritual body.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"314","subsection":null},"text":"Occurs. DLW 408:2.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"402","subsection":"end"},"text":"The covering which is called the pleura.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"180","subsection":"2"},"text":"Thus does the sheath conjoin itself with all the internal things.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"60","subsection":null},"text":"There is a general covering about every member, which insinuates itself into every part... Thus the sheath of every muscle enters into its fibres... In like manner the coverings of the liver, etc.","comment":null,"footnote":null}],"slug":"covering-bcec37","url":"/meta/potts/covering-bcec37/"}