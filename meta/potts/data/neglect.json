{"key":"b7b19762a6675653","source_file":"Potts N.json","source_id":35271,"source_url":"concordance-neglect-ppl-neglectus","term":"Neglect","headwords":["Neglect","Neglect, To","Negligently"],"latin":["Neglectus","Neglegare","Negligenter"],"header_pairs":[{"english":["Neglect"],"latin":["Neglectus"]},{"english":["Neglect, To"],"latin":["Neglegare"]},{"english":["Negligently"],"latin":["Negligenter"]}],"header_sentences":["See Omit."],"redirect_xref":null,"works":["AE","AR","CL","LJPost","SE"],"contexts":[{"reference":{"work":"AR","section":"59","subsection":null},"text":"That (the Lord) has been neglected. Signified. AR 93.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"866","subsection":null},"text":"Death = neglect, non-acknowledgement, and rejection by the world.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"305","subsection":"end"},"text":"Thus arises... neglect for one's consort.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5956","subsection":null},"text":"In the Spiritual World... they at once see where there has been neglect (in business).","comment":null,"footnote":null},{"reference":{"work":"AE","section":"659","subsection":"7"},"text":"Among the dead, neglected () = among those with whom there is nothing of truth and good, and who are therefore rejected.","comment":null,"footnote":null},{"reference":{"work":"LJPost","section":"227","subsection":null},"text":"If they do their works negligently, they are severely punished.","comment":null,"footnote":null}],"slug":"neglect","url":"/meta/potts/neglect/"}