{"key":"7211b85d9c5cc03b","source_file":"Potts Ci - Cl.json","source_id":1754,"source_url":"concordance-circumvolution-ppl-circumvolutio","term":"Circumvolution","headwords":["Circumvolution"],"latin":["Circumvolutio"],"header_pairs":[{"english":["Circumvolution"],"latin":["Circumvolutio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"4040","subsection":null},"text":"There appear in the brain... wonderful circumvolutions and gyres... AC 4041. AC 6607.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7381","subsection":"3"},"text":"By apparent circumvolutions the sun appears to make day and night...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7381","subsection":"4"},"text":"But the Sun of Heaven... does not make circumgyrations and circumvolutions.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1664","subsection":null},"text":"He was revolved... SE 1696. SE 1763. SE 1806.","comment":null,"footnote":null}],"slug":"circumvolution","url":"/meta/potts/circumvolution/"}