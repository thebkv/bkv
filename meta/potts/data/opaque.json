{"key":"aa965b308210c798","source_file":"Potts O.json","source_id":20028,"source_url":"concordance-opaque-ppl-opacus","term":"Opaque","headwords":["Opaque"],"latin":["Opacus"],"header_pairs":[{"english":["Opaque"],"latin":["Opacus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"816","subsection":"end"},"text":"They wander about in dark places.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1524","subsection":null},"text":"An obscurity like a shady cloud.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1869","subsection":"2"},"text":"The smaller things of nature (are seen) as something opaque...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4967","subsection":"2"},"text":"The light with them becomes opaque, like the light of evening or night.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6388","subsection":"end"},"text":"Objects which absorb the rays of light appear opaque.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6406","subsection":"2"},"text":"Things which are inordinate are dark and opaque...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"584","subsection":null},"text":"All the Hells, when looked into, appear dark and dusky.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"586","subsection":"2"},"text":"In some of the Hells there are dark forests. HH 587:end.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"34","subsection":"end"},"text":"Like the influx of light into the opaque things of the earth...","comment":null,"footnote":null}],"slug":"opaque","url":"/meta/potts/opaque/"}