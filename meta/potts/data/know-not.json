{"key":"c4bb6ab214a319a8","source_file":"Potts K.json","source_id":31467,"source_url":"concordance-know-not-ppl-nescire","term":"Know not","headwords":["Know not"],"latin":["Nescire"],"header_pairs":[{"english":["Know not"],"latin":["Nescire"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DSS","SE"],"contexts":[{"reference":{"work":"AC","section":"1769","subsection":null},"text":"He did not know that he was in the other life. AC 2748.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1883","subsection":"end"},"text":"They do not know whether they are in the body or out of the body.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1906","subsection":"2"},"text":"This (is done) when the man does not know. AC 2875.","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"41","subsection":"end"},"text":"These (Divine truths), together with the light of Heaven, inflow with some even when they do not know.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4345","subsection":null},"text":"He did not know his own name, and was indignant. SE 4385.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"194","subsection":null},"text":"Not to know () = ignorance.","comment":null,"footnote":null}],"slug":"know-not","url":"/meta/potts/know-not/"}