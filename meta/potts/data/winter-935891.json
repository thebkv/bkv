{"key":"9358915d1533731c","source_file":"Potts Wi.json","source_id":25499,"source_url":"concordance-winter-ppl-bruma","term":"Winter","headwords":["Winter"],"latin":["Bruma","Brumale"],"header_pairs":[{"english":["Winter"],"latin":["Bruma","Brumale"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","DLW","DLove","TCR"],"contexts":[{"reference":{"work":"DLW","section":"102","subsection":null},"text":"(The winter in the Heavens) is not like the winter in the frigid zones, but is like the winter in the hot zones.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"304","subsection":"end"},"text":"(The love) goes off into the cold of winter.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"367","subsection":"2"},"text":"When charity is separated from faith... the man's state becomes like that of the world in time of winter...","comment":null,"footnote":null},{"reference":{"work":"DLove","section":"20","subsection":"2"},"text":"Man grows warm... even in mid-winter.","comment":null,"footnote":null}],"slug":"winter-935891","url":"/meta/potts/winter-935891/"}