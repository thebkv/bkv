{"key":"da4e8fb3b9f34170","source_file":"Potts Co.json","source_id":50338,"source_url":"concordance-contagion-ppl-contagio","term":"Contagion","headwords":["Contagion","Contagious"],"latin":["Contagio","Contagiosus"],"header_pairs":[{"english":["Contagion"],"latin":["Contagio"]},{"english":["Contagious"],"latin":["Contagiosus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","SE"],"contexts":[{"reference":{"work":"AC","section":"6503","subsection":null},"text":"Lest it be infected by any contagion. Signified... To embalm = a means of preservation from contagion... The means of preserving spiritual good from contagion. Treated of.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6666","subsection":"end"},"text":"All evil is contagious... TCR 120:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10130","subsection":"10"},"text":"This contagion is what is signified by the touch of unclean things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10134","subsection":"9"},"text":"Evils grow daily, and in proportion as they grow, one infects another as with a contagion, especially parents their children...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"215","subsection":"3"},"text":"From them, the lust of commanding spread as a contagion to many...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"328","subsection":"7"},"text":"Hence the contagion of evil...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1682","subsection":null},"text":"Thus that people was preserved from the contagions of evils. SE 5016. SE 5480. SE 5503.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1787","subsection":null},"text":"Had infected others with their contagion...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5202","subsection":null},"text":"The contagion increased everywhere.","comment":null,"footnote":null}],"slug":"contagion","url":"/meta/potts/contagion/"}