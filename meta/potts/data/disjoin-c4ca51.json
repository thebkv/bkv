{"key":"c4ca514929c5b90b","source_file":"Potts Di.json","source_id":14239,"source_url":"concordance-disjoin-ppl-sejungere","term":"Disjoin","headwords":["Disjoin","Disjunction"],"latin":["Sejungere","Sejunctio"],"header_pairs":[{"english":["Disjoin"],"latin":["Sejungere"]},{"english":["Disjunction"],"latin":["Sejunctio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DP","HH"],"contexts":[{"reference":{"work":"AC","section":"5474","subsection":null},"text":"Under Disjoin, see this reference.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"531","subsection":"2"},"text":"Hence it is that he is entirely disjoined from Heaven...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"326","subsection":null},"text":"That the acknowledgement of God effects the conjunction of God with man and of man with God, and that the denial of God effects the disjunction.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"778","subsection":"4"},"text":"Heaven then removes itself, and the man is disjoined from it...","comment":null,"footnote":null}],"slug":"disjoin-c4ca51","url":"/meta/potts/disjoin-c4ca51/"}