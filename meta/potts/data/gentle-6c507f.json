{"key":"6c507f3d7f85ace9","source_file":"Potts Ga - Gn.json","source_id":20726,"source_url":"concordance-gentle-ppl-mansuetus","term":"Gentle","headwords":["Gentle","Gentleness"],"latin":["Mansuetus","Mansuetudo"],"header_pairs":[{"english":["Gentle"],"latin":["Mansuetus"]},{"english":["Gentleness"],"latin":["Mansuetudo"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","Coro","DMin","TCR"],"contexts":[{"reference":{"work":"AC","section":"3318","subsection":"4"},"text":"Through temptations... he becomes gentle, etc.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"370","subsection":null},"text":"Jealousy blazes up... into anger with the gentle, and into revenge with the ungentle.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"604","subsection":null},"text":"The wild beasts would tear to pieces the gentle beasts.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4763","subsection":"end"},"text":"They who are in Hell... are more gentle than... when in the World of Spirits.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"298","subsection":"7"},"text":"Ride upon the word of Truth, gentleness, and justice (). AE 355:14. AE 684:14.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"30","subsection":"2"},"text":"The spiritual man in himself is actually like a dove as to gentleness...","comment":null,"footnote":null}],"slug":"gentle-6c507f","url":"/meta/potts/gentle-6c507f/"}