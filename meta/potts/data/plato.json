{"key":"259ce15757739e63","source_file":"Potts Ph - Po.json","source_id":13637,"source_url":"concordance-plato-ppl-plato","term":"Plato","headwords":["Plato","Platonist"],"latin":["Plato","Platonicus"],"header_pairs":[{"english":["Plato"],"latin":["Plato"]},{"english":["Platonist"],"latin":["Platonicus"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","TCR"],"contexts":[{"reference":{"work":"CL","section":"156","subsection":null},"text":"[151a] I asked about Plato and Aristotle; and he said. They and their followers dwell in another region, because they taught rational things which are of the understanding (as distinguished from moral things which are of life).","comment":null,"footnote":null},{"reference":{"work":"CL","section":"156","subsection":null},"text":"[153a] Among them was a certain Platonist; who said...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"182","subsection":null},"text":"Demosthenes is with Plato.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"9","subsection":"end"},"text":"See Aristotle.","comment":null,"footnote":null}],"slug":"plato","url":"/meta/potts/plato/"}