{"key":"7bdbcd835d195995","source_file":"Potts O.json","source_id":21721,"source_url":"concordance-open-to-be-ppl-patere","term":"Open, To be","headwords":["Open, To be","Open"],"latin":["Patere","Patulus"],"header_pairs":[{"english":["Open, To be"],"latin":["Patere"]},{"english":["Open"],"latin":["Patulus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","HH"],"contexts":[{"reference":{"work":"AC","section":"2034","subsection":"5"},"text":"In the other life the interiors are open. AC 2049:4. AC 5700:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4121","subsection":"2"},"text":"The affections there are open.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4126","subsection":"2"},"text":"In the other life all thought is open.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5032","subsection":"2"},"text":"There, the interiors are open; the thoughts, intentions, and ends manifest themselves, and are open as in clear day.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6667","subsection":"end"},"text":"Then it is manifest what the man's quality had been interiorly.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"131","subsection":null},"text":"The interior Angels love all things with them to be open...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"355","subsection":"4"},"text":"When the interiors of man are open.","comment":null,"footnote":null}],"slug":"open-to-be","url":"/meta/potts/open-to-be/"}