{"key":"378f843adc66d6eb","source_file":"Potts Ba - Bi.json","source_id":27610,"source_url":"concordance-before-ppl-prae","term":"Before","headwords":["Before"],"latin":["Prae"],"header_pairs":[{"english":["Before"],"latin":["Prae"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH"],"contexts":[{"reference":{"work":"AC","section":"952","subsection":null},"text":"Pre-eminence above others... AC 1327.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1304","subsection":null},"text":"Loves himself more than others.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1505","subsection":null},"text":"(Sphere of one who thinks himself before others.) AC 1506. AC 1507. AC 2027.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2219","subsection":null},"text":"Despise others in comparison with themselves.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2796","subsection":null},"text":"Think themselves in light above others.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5853","subsection":null},"text":"This prerogative have Spirits above man. AC 5857.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6393","subsection":"2"},"text":"They are actually great and powerful above others.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"57","subsection":"2"},"text":"What a man has above the Angels... (HH 304:2.)","comment":null,"footnote":null}],"slug":"before-378f84","url":"/meta/potts/before-378f84/"}