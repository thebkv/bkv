{"key":"330c8c0ebd33c96a","source_file":"Potts Rh - Ry.json","source_id":15652,"source_url":"concordance-rome-ppl-roma","term":"Rome","headwords":["Rome","Roman"],"latin":["Roma","Romanus"],"header_pairs":[{"english":["Rome"],"latin":["Roma"]},{"english":["Roman"],"latin":["Romanus"]}],"header_sentences":["See Latin."],"redirect_xref":null,"works":["AC","AE","AR","CL","Char","DP","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2724","subsection":"end"},"text":"Hence with the Gentiles, especially in Greece and Rome, so many gods...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8944","subsection":"2"},"text":"How the things of Divine worship reached the Italians or Romans.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10177","subsection":"10"},"text":"Censers, etc., in use with the Roman nation... Such a religiosity was derived from the Ancient Church. AE 504:6.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"312","subsection":"2"},"text":"Think of Home, etc.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"737","subsection":"2"},"text":"The idea that the seven mountains mean Home. AE 1062:2.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"451","subsection":null},"text":"(Modern) Home, mentioned.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"141","subsection":null},"text":"The Roman government of Consul, Senate, and Tribune...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2147","subsection":null},"text":"As with the Romans, who longed for immortality (of fame) more than others...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3394","subsection":null},"text":"One who was like the Romans. Described.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3394","subsection":null},"text":"But the valour of the Romans was mad.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4094","subsection":null},"text":"A certain celebrated Roman seen. (See Cicero.)","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5408","subsection":null},"text":"The city of Home there.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5648","subsection":null},"text":"See Last Judgment. SE 5650.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6012","subsection":null},"text":"He of Home who was from Upsala...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"573","subsection":"13"},"text":"Believed to be said of the destruction of Jerusalem by the Romans...","comment":null,"footnote":null},{"reference":{"work":"Char","section":"86","subsection":null},"text":"If I had been born at Venice, or Home...","comment":null,"footnote":null}],"slug":"rome","url":"/meta/potts/rome/"}