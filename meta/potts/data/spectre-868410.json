{"key":"868410f1f8fb9a88","source_file":"Potts Sp - Sq.json","source_id":9952,"source_url":"concordance-spectre-ppl-spectrum","term":"Spectre","headwords":["Spectre"],"latin":["Spectrum"],"header_pairs":[{"english":["Spectre"],"latin":["Spectrum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","TCR"],"contexts":[{"reference":{"work":"AC","section":"4527","subsection":"2"},"text":"See Spectre.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"424","subsection":"2"},"text":"When the phantasy is removed, the Sirens appear as spectres.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"71","subsection":null},"text":"A confused din as of spectres in forests, heard.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"389","subsection":"6"},"text":"Dead faith is nothing but a spectre. I call it a spectre, because...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"511","subsection":"end"},"text":"Would not spectres infest him there like furies.","comment":null,"footnote":null}],"slug":"spectre-868410","url":"/meta/potts/spectre-868410/"}