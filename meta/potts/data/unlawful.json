{"key":"c8258693d2b0f7ff","source_file":"Potts U.json","source_id":12834,"source_url":"concordance-unlawful-ppl-illicitus","term":"Unlawful","headwords":["Unlawful"],"latin":["Illicitus"],"header_pairs":[{"english":["Unlawful"],"latin":["Illicitus"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","DLife","HH"],"contexts":[{"reference":{"work":"HH","section":"378","subsection":null},"text":"[Swedenborg footnote 1.]. That marriages between those who are of diverse religion are unlawful. Reference.","comment":null,"footnote":null},{"reference":{"work":"DLife","section":"63","subsection":null},"text":"He considers these things lawful before God, but unlawful before the world.","comment":null,"footnote":null},{"reference":{"work":"DLife","section":"111","subsection":null},"text":"He therefore makes adulteries not unlawful before God...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"270","subsection":"6"},"text":"To warm himself at an illicit fire.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"467","subsection":null},"text":"That (this) concubinage is not unlawful. Explained.","comment":null,"footnote":null}],"slug":"unlawful","url":"/meta/potts/unlawful/"}