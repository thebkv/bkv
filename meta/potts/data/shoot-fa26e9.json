{"key":"fa26e985562a5908","source_file":"Potts Sh - So.json","source_id":8823,"source_url":"concordance-shoot-ppl-propago","term":"Shoot","headwords":["Shoot"],"latin":["Propago"],"header_pairs":[{"english":["Shoot"],"latin":["Propago"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","LJ","TCR"],"contexts":[{"reference":{"work":"AC","section":"5114","subsection":null},"text":"In the vine three shoots () = the derivations even to the last. AC 5122.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5122","subsection":"3"},"text":"Each (thing to be regenerated) has an indefinite number of shoots, that is, of progressions and derivations...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9341","subsection":"2"},"text":"Occurs. AE 376:14. AE 515:16.","comment":null,"footnote":null},{"reference":{"work":"LJ","section":"58","subsection":"6"},"text":"They lived... one progeny under another.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"8","subsection":null},"text":"Constructed of the joined branches and shoots.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"103","subsection":"2"},"text":"A graft or offset of the father's soul.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"178","subsection":"end"},"text":"That faith and its offshoots.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"638","subsection":"17"},"text":"Shoots = truths.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"654","subsection":"17"},"text":"She sent out her shoots () = the increase of intelligence, and its extension.","comment":null,"footnote":null}],"slug":"shoot-fa26e9","url":"/meta/potts/shoot-fa26e9/"}