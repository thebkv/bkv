{"key":"fd3580ab4a235190","source_file":"Potts Go - Gy.json","source_id":39066,"source_url":"concordance-goodwill-ppl-benevolentia","term":"Goodwill","headwords":["Goodwill"],"latin":["Benevolentia","Benevolens","Benevelle"],"header_pairs":[{"english":["Goodwill"],"latin":["Benevolentia","Benevolens","Benevelle"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"361","subsection":null},"text":"Occurs.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2950","subsection":null},"text":"The Lord's joy at the goodwill of those of the new Spiritual Church. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4464","subsection":"3"},"text":"In goodwill and charity...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4776","subsection":null},"text":"Charity, that is, to will well to another...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4776","subsection":"2"},"text":"To will well to others, and from willing well to do good to them... AC 4776:2. AC 4776. AC 5128:4. TCR 373:2.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"492","subsection":null},"text":"Friendship, good-will, and sincerity...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"164","subsection":null},"text":"The virtues which belong to the moral wisdom of the men, are... goodwill, etc.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"374","subsection":"2"},"text":"Goodwill or benevolence...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"420","subsection":null},"text":"That charity and good works are distinct as are willing well and doing well. General article. TCR 421.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"444","subsection":null},"text":"Charity is to will well to the neighbour, and thence to act well with him.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"449","subsection":null},"text":"Sincerity, benevolence from charity...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"592","subsection":"end"},"text":"Morality and benevolence in externals...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"388","subsection":"26"},"text":"The rain of benevolences which God causes to drop () = the Divine truth from the Divine good. ( = the influx of Divine truth from the Divine kindness.) AE 650:7.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"661","subsection":null},"text":"To be consociated from love and friendship through goodwill. Signified.","comment":null,"footnote":null}],"slug":"goodwill","url":"/meta/potts/goodwill/"}