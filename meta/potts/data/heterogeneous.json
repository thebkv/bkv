{"key":"0040240fa4d98a55","source_file":"Potts Hi - Hy.json","source_id":15022,"source_url":"concordance-heterogeneous-ppl-heterogeneus","term":"Heterogeneous","headwords":["Heterogeneous","Heterogeneity"],"latin":["Heterogeneus","Heterogeneitas"],"header_pairs":[{"english":["Heterogeneous"],"latin":["Heterogeneus"]},{"english":["Heterogeneity"],"latin":["Heterogeneitas"]}],"header_sentences":[],"redirect_xref":null,"works":["CL","DLW","HH","TCR"],"contexts":[{"reference":{"work":"HH","section":"64","subsection":"2"},"text":"They are cast out of Heaven, because they are heterogeneous.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"192","subsection":"end"},"text":"Things not of the same nature are heterogeneous...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"254","subsection":null},"text":"Contracts at the least touch of anything heterogeneous...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"254","subsection":null},"text":"Evils and falsities are heterogeneous...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"171","subsection":null},"text":"What is heterogeneous and discordant effects disjunction and absence...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"273","subsection":null},"text":"Homogeneities and heterogeneities... (there) appear in the face, speech, and gestures.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"622","subsection":"end"},"text":"A heterogeneous affection separates, and what is heterogeneous torments...","comment":null,"footnote":null}],"slug":"heterogeneous","url":"/meta/potts/heterogeneous/"}