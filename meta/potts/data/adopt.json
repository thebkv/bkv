{"key":"4f332f4495a0e88d","source_file":"Potts Aa - Am.json","source_id":16585,"source_url":"concordance-adopt-ppl-adoptare","term":"Adopt","headwords":["Adopt","Adoption"],"latin":["Adoptare","Adoptatio"],"header_pairs":[{"english":["Adopt"],"latin":["Adoptare"]},{"english":["Adoption"],"latin":["Adoptatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","TCR"],"contexts":[{"reference":{"work":"AC","section":"2834","subsection":null},"text":"The adoption of the spiritual by the Lord's Divine Human. Signified. AC 2841. AC 3246. AC 7035.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3494","subsection":"end"},"text":"So far they are adopted as sons by the Lord.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3911","subsection":null},"text":"Good adopts truths. AC 3995. AC 8516:2. AC 10110.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4423","subsection":null},"text":"The rejection of the Old Church and the adoption of the New. Explained.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"329","subsection":"2"},"text":"No one can be adopted by the Lord before he is separated from the devil.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"380","subsection":null},"text":"Adopts falsities.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"383","subsection":null},"text":"Man can choose, adopt and appropriate to himself good or evil.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"503","subsection":"5"},"text":"Concerning redemption we have adopted purely natural ideas.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"536","subsection":null},"text":"All such are accepted by the Lord and are adopted after death.","comment":null,"footnote":null}],"slug":"adopt","url":"/meta/potts/adopt/"}