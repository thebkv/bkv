{"key":"ac97decdafa654ba","source_file":"Potts Se.json","source_id":7677,"source_url":"concordance-see-ppl-conspicere","term":"See","headwords":["See","Sight","Visible","Clearly"],"latin":["Conspicere","Conspectus","Conspicuous","Conspicue"],"header_pairs":[{"english":["See"],"latin":["Conspicere"]},{"english":["Sight"],"latin":["Conspectus"]},{"english":["Visible"],"latin":["Conspicuous"]},{"english":["Clearly"],"latin":["Conspicue"]}],"header_sentences":["See Clear."],"redirect_xref":null,"works":["AC","AE","DLW","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"1274","subsection":null},"text":"No Spirits are so far away that they cannot be seen; yet no more come into view than the Lord permits.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1274","subsection":"end"},"text":"Under his view and Providence.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1379","subsection":"end"},"text":"Are there presented to view.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1382","subsection":null},"text":"Are instantly present under the Lord's sight.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1628","subsection":null},"text":"They are so clearly seen, that nothing can be more clearly seen.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1756","subsection":"2"},"text":"They represented Divine things by those which were visible on earth.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6122","subsection":null},"text":"If they no longer have any visible truth. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6134","subsection":null},"text":"Good (also) was no longer visible on account of the desolation. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8939","subsection":"2"},"text":"Invisible before the bodily eyes; but visible there...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8947","subsection":null},"text":"A multitude of Spirits (then) comes into sight... They are seen plainly...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9108","subsection":null},"text":"Spirits of Saturn came into sight...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"14","subsection":null},"text":"They are all as one in the Lord's sight.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"479","subsection":"4"},"text":"When the spirit in man turns itself away from another, it is no longer in his view.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"93","subsection":null},"text":"The Sun which is visible to the Angels...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"312","subsection":"2"},"text":"There came into my sight...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"343","subsection":null},"text":"May be more clearly comprehended.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"25","subsection":null},"text":"In sight of His throne () = presence and Providence.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"275","subsection":null},"text":"In sight of the throne () = appearance. See AR 238.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"974","subsection":"2"},"text":"This difference does not appear to the sight of men; but manifestly to the sight of the Angels.","comment":null,"footnote":null}],"slug":"see-ac97de","url":"/meta/potts/see-ac97de/"}