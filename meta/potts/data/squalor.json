{"key":"0e89cd4fe6e4a0dc","source_file":"Potts Sp - Sq.json","source_id":48999,"source_url":"concordance-squalor-ppl-squallor","term":"Squalor","headwords":["Squalor","Squalid"],"latin":["Squallor","Squallidus"],"header_pairs":[{"english":["Squalor"],"latin":["Squallor"]},{"english":["Squalid"],"latin":["Squallidus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"4054","subsection":"end"},"text":"They live in squalor.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5246","subsection":"2"},"text":"A state of temptation is relatively squalid and unclean.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"182","subsection":null},"text":"They appear in garments torn, squalid, and disgusting.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"488","subsection":"6"},"text":"They who have taken delight in adulteries live where all things are sordid and squalid: these they love.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"140","subsection":null},"text":"Purifies the blood from the unclean things which are called filthy.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2813","subsection":null},"text":"Occurs. SE 4854.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3618","subsection":"end"},"text":"Filthy water.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"476","subsection":null},"text":"The garments of those in temptations appear squalid.","comment":null,"footnote":null}],"slug":"squalor","url":"/meta/potts/squalor/"}