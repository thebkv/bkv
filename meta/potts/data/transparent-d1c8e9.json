{"key":"d1c8e9269d45bc7b","source_file":"Potts To - Ty.json","source_id":10605,"source_url":"concordance-transparent-ppl-diaphanus","term":"Transparent","headwords":["Transparent"],"latin":["Diaphanus"],"header_pairs":[{"english":["Transparent"],"latin":["Diaphanus"]}],"header_sentences":[],"redirect_xref":null,"works":["DLW","TCR"],"contexts":[{"reference":{"work":"DLW","section":"245","subsection":"2"},"text":"These transparent forms are opened according to degrees.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"255","subsection":null},"text":"As these degrees are transparent, man can be elevated as to the understanding into the light of Heaven...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"34","subsection":"4"},"text":"Compared to the influx of light into a transparent object.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"216","subsection":null},"text":"Like a transparent object.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"360","subsection":"3"},"text":"The Natural of man thus becomes as it were transparent.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"459","subsection":"13"},"text":"Natural charity, if spiritual within, appears before the Angels transparent like a diamond...","comment":null,"footnote":null}],"slug":"transparent-d1c8e9","url":"/meta/potts/transparent-d1c8e9/"}