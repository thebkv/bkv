{"key":"b822246e3ed268f6","source_file":"Potts In.json","source_id":69042,"source_url":"concordance-intranquillity-ppl-intranquillitas","term":"Intranquillity","headwords":["Intranquillity","Intranquil"],"latin":["Intranquillitas","Intranquillus"],"header_pairs":[{"english":["Intranquillity"],"latin":["Intranquillitas"]},{"english":["Intranquil"],"latin":["Intranquillus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"4393","subsection":"end"},"text":"This state is intranquil, for there are then combats of temptations.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6325","subsection":null},"text":"Others cast themselves continually into solicitudes and cupidities, from which are intranquillities.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6373","subsection":"2"},"text":"When the Divine was presented through the Celestial Kingdom, there was intranquillity...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8722","subsection":"2"},"text":"So long as a man is in truth, and not yet in good, he is in intranquillity... AC 8893.","comment":null,"footnote":null}],"slug":"intranquillity","url":"/meta/potts/intranquillity/"}