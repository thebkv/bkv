{"key":"e431a2f3baceb738","source_file":"Potts Co.json","source_id":17153,"source_url":"concordance-companion-ppl-sodalis","term":"Companion","headwords":["Companion","Companionship"],"latin":["Sodalis","Sodalitium"],"header_pairs":[{"english":["Companion"],"latin":["Sodalis"]},{"english":["Companionship"],"latin":["Sodalitium"]}],"header_sentences":[],"redirect_xref":null,"works":["AR","CL","TCR"],"contexts":[{"reference":{"work":"AR","section":"153","subsection":"10"},"text":"You see your companions; they all labour...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"23","subsection":null},"text":"After this festive companionship...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"134","subsection":"4"},"text":"We agree with our companions from the west...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"110","subsection":"7"},"text":"I asked, whether he, like the others, his companions...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"137","subsection":"3"},"text":"At these words, his companions on the left side...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"380","subsection":"2"},"text":"He brings himself into companionship with the Arians and Socinians...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"665","subsection":"3"},"text":"We have heard from some of our brotherhood...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"797","subsection":"3"},"text":"Melancthon... could not be kept from being alternately let down to his captive companions...","comment":null,"footnote":null}],"slug":"companion-e431a2","url":"/meta/potts/companion-e431a2/"}