{"key":"c85b55daffaaba50","source_file":"Potts Re.json","source_id":45206,"source_url":"concordance-reside-ppl-residere","term":"Reside","headwords":["Reside"],"latin":["Residere"],"header_pairs":[{"english":["Reside"],"latin":["Residere"]}],"header_sentences":["See Dwell."],"redirect_xref":null,"works":["AC","BE","CL","DLW","DP","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"3368","subsection":null},"text":"Reside in the Land (). Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4600","subsection":null},"text":"When Israel resided in this land () = while in this state... To reside = to live... To reside is predicated of truth, but to dwell, of good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9276","subsection":null},"text":"(These) loves reside there.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10199","subsection":"8"},"text":"External truths... reside in the external man.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"506","subsection":"2"},"text":"The Rational had not resided in their interiors, but in their exteriors.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"518","subsection":null},"text":"Whether their Knowledges resided in their memory, or in their life... HH 518:2. HH 551.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"270","subsection":null},"text":"That all evils and falsities thence... reside in the natural mind. DP 33:2.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"96","subsection":"5"},"text":"The reason the Lord resides in these faculties with every man...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"161","subsection":"3"},"text":"Nothing of conjugial love, nor even of the love of the sex, resides with the men...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"216","subsection":null},"text":"a. That conjugial love resides with chaste wives...","comment":null,"footnote":null},{"reference":{"work":"BE","section":"40","subsection":"2"},"text":"Theological things reside in human minds over all other things... TCR 482.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"50","subsection":null},"text":"Love resides in wisdom like a king in his kingdom.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"366","subsection":"2"},"text":"God resides in their supremes...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"367","subsection":"2"},"text":"Charity resides in the will...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"482","subsection":null},"text":"Theological things reside in the highest region of the mind...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"494","subsection":"2"},"text":"In the highest region also resides man's love... and there principally resides his free will...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"498","subsection":null},"text":"Free will... resides in the soul...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"829","subsection":null},"text":"Religion resides in the supremes with man.","comment":null,"footnote":null}],"slug":"reside","url":"/meta/potts/reside/"}