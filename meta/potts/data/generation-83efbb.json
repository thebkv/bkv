{"key":"83efbb3dde025069","source_file":"Potts Ga - Gn.json","source_id":18002,"source_url":"concordance-generation-ppl-progenies","term":"Generation","headwords":["Generation"],"latin":["Progenies"],"header_pairs":[{"english":["Generation"],"latin":["Progenies"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL"],"contexts":[{"reference":{"work":"AC","section":"9013","subsection":"6"},"text":"Hence they are called a generation of vipers.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"392","subsection":null},"text":"This sphere disposes everyone to love, protect, and support his offspring.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"392","subsection":"2"},"text":"This loves itself in its offspring.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"405","subsection":"end"},"text":"With such, the love of their offspring is also the love of self.","comment":null,"footnote":null}],"slug":"generation-83efbb","url":"/meta/potts/generation-83efbb/"}