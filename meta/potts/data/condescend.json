{"key":"10f083be8ab1e196","source_file":"Potts Co.json","source_id":26318,"source_url":"concordance-condescend-ppl-condescendere","term":"Condescend","headwords":["Condescend","Condescension"],"latin":["Condescendere","Condescendentia"],"header_pairs":[{"english":["Condescend"],"latin":["Condescendere"]},{"english":["Condescension"],"latin":["Condescendentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"4245","subsection":null},"text":"The condescension and humiliation of truth before good. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4368","subsection":"3"},"text":"They are sad because they are deprived of deference.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4472","subsection":null},"text":"Condescension as to life. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4472","subsection":"end"},"text":"Hamor condescended to the external things of the sons of Jacob.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4474","subsection":null},"text":"A desire to condescend to it, thus to accept it. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4755","subsection":null},"text":"His brethren hearkened = deference.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8885","subsection":"3"},"text":"To bend the wills of others by ideas variously formed to condescension.","comment":null,"footnote":null}],"slug":"condescend","url":"/meta/potts/condescend/"}