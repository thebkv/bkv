{"key":"55b110999764ab67","source_file":"Potts St - Sy.json","source_id":32939,"source_url":"concordance-subside-ppl-subsidere","term":"Subside","headwords":["Subside","Subsidence"],"latin":["Subsidere","Subsidentia"],"header_pairs":[{"english":["Subside"],"latin":["Subsidere"]},{"english":["Subsidence"],"latin":["Subsidentia"]}],"header_sentences":["See Fall down."],"redirect_xref":null,"works":["AR","CL","DLW","SE"],"contexts":[{"reference":{"work":"DLW","section":"205","subsection":"end"},"text":"Subsiding into a plane.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"343","subsection":null},"text":"By the subsidence and approach of the Heavens.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"675","subsection":"end"},"text":"He sank down into Hell.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"676","subsection":"3"},"text":"They are disposed into Societies, which afterwards sink down.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"263","subsection":"end"},"text":"Such of us as torture others... sink down... into a certain prison. TCR 661:8.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"264","subsection":"3"},"text":"They sank down deeply into their Hells.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"514","subsection":"3"},"text":"Being convicted, they sink down.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4926","subsection":null},"text":"That rock began to subside. SE 4927.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4930","subsection":"end"},"text":"Then that city subsides into the deep.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4944","subsection":null},"text":"See Last Judgment. SE 4975. SE 4977. SE 5053. SE 5057. SE 5064. SE 5202. SE 5418. SE 5650. SE 5792. LJPost 134. LJPost 137.","comment":null,"footnote":null},{"reference":{"work":"SE","secti