{"key":"8981c240654bd923","source_file":"Potts To - Ty.json","source_id":47569,"source_url":"concordance-turn-aside-ppl-secedere","term":"Turn aside","headwords":["Turn aside"],"latin":["Secedere"],"header_pairs":[{"english":["Turn aside"],"latin":["Secedere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"6836","subsection":null},"text":"I will turn aside and see () = reflection upon this revelation; for to turn aside, in the spiritual sense, = to diverge from the thought in which one is; and to see = to perceive; thus both together = to reflect.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"666","subsection":"end"},"text":"I saw them withdrawing from one another.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3608","subsection":null},"text":"It was as if the Spirits had withdrawn from me.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5891","subsection":null},"text":"He withdrew thither.","comment":null,"footnote":null}],"slug":"turn-aside-8981c2","url":"/meta/potts/turn-aside-8981c2/"}