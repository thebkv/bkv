{"key":"1b99d975fbb5ead5","source_file":"Potts Sh - So.json","source_id":9851,"source_url":"concordance-shout-ppl-vociferare","term":"Shout","headwords":["Shout","Shouting, A"],"latin":["Vociferare","Vociferatio"],"header_pairs":[{"english":["Shout"],"latin":["Vociferare"]},{"english":["Shouting, A"],"latin":["Vociferatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"420","subsection":null},"text":"Occurs. AC 1664:10. SE 4768. AE 700:16. AE 721:12.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4592","subsection":"10"},"text":"To shout = to announce.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6413","subsection":"3"},"text":"To shout upon the water brooks () = to long for truths.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10454","subsection":null},"text":"The voice of the people in their shouting () = what the quality of that nation was interiorly.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10454","subsection":"2"},"text":"By shouting is signified what is articulate of sound, whether of speech, singing, or crying aloud.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"376","subsection":"32"},"text":"Lamentation over them is described by shout ye ().","comment":null,"footnote":null}],"slug":"shout-1b99d9","url":"/meta/potts/shout-1b99d9/"}