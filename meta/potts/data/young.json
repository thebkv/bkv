{"key":"9e1444e2ead2ae81","source_file":"Potts Y.json","source_id":3477,"source_url":"concordance-young-ppl-pullus","term":"Young","headwords":["Young"],"latin":["Pullus"],"header_pairs":[{"english":["Young"],"latin":["Pullus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DLW","DWis","Inv","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"870","subsection":"2"},"text":"The young of pigeons. AC 1823.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1782","subsection":null},"text":"The turtle-dove and young pigeon () are representative of the spiritual things of the Church. AC 1821.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1827","subsection":null},"text":"A turtle-dove = those things which are representative of exterior spiritual things; and a young pigeon, those which are representative of interior spiritual things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2781","subsection":"8"},"text":"To ride upon a foal the son of a donkey () = that the Rational was subordinated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4264","subsection":null},"text":"Twenty she-donkeys and ten foals () = those things which are of the natural man, and which are for service.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10210","subsection":"end"},"text":"By turtle-doves, and by the young of pigeons, is signified the good of innocence.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"351","subsection":"2"},"text":"In eggs; that in them there lies hidden a chick...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"20","subsection":"2"},"text":"The young of an eagle.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"405","subsection":"end"},"text":"Like the young of a panther.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2766","subsection":null},"text":"Chickens know their mother...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3038","subsection":null},"text":"Even chickens will resist...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3340","subsection":"end"},"text":"All animals have a sphere... of bringing up their young...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"281","subsection":"6"},"text":"The fluttering of an eagle over its young.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"314","subsection":"end"},"text":"Two of the young pigeons () = innocence.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"329","subsection":"19"},"text":"His donkey's foal ().","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"2","subsection":null},"text":"2. From the rudiments of chickens in the egg...","comment":null,"footnote":null},{"reference":{"work":"Inv","section":"50","subsection":"end"},"text":"Hence a chicken of one day knows more of the order of its life than a little child.","comment":null,"footnote":null}],"slug":"young","url":"/meta/potts/young/"}