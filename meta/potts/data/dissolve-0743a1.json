{"key":"0743a1dcc2d22c7b","source_file":"Potts Di.json","source_id":18842,"source_url":"concordance-dissolve-ppl-dissolvere","term":"Dissolve","headwords":["Dissolve","Dissolute","Dissolution"],"latin":["Dissolvere","Dissolutus","Dissolutio"],"header_pairs":[{"english":["Dissolve"],"latin":["Dissolvere"]},{"english":["Dissolute"],"latin":["Dissolutus"]},{"english":["Dissolution"],"latin":["Dissolutio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"10479","subsection":null},"text":"To be dissolute () = to be turned away... By this word in the Original Language, is also meant to be turned away, and to go back, also to be made naked... AC 10480.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"507","subsection":null},"text":"That by the lust of varieties is meant the utterly dissolute lust of scortation.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"314","subsection":"end"},"text":"Lest they perish, and be dissolved.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"502","subsection":null},"text":"The dragon now wants to be unloosed.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"642","subsection":null},"text":"The more they want to unloose themselves (from the veil), the more closely they are tied.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"676","subsection":null},"text":"By dissolution as it were death...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"835","subsection":null},"text":"(If he were admitted) he would be dissolved.","comment":null,"footnote":null}],"slug":"dissolve-0743a1","url":"/meta/potts/dissolve-0743a1/"}