{"key":"dc1cb86d72f9f48e","source_file":"Potts N.json","source_id":35155,"source_url":"concordance-needle-ppl-acus","term":"Needle","headwords":["Needle"],"latin":["Acus"],"header_pairs":[{"english":["Needle"],"latin":["Acus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"9144","subsection":"2"},"text":"If touched with the point of a needle, it contracts. TCR 258:2.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"365","subsection":"3"},"text":"By the eye of a needle is signified spiritual truth.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"365","subsection":null},"text":"(In footnote): What needlework is, and hence what a needle, see AC 9688.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"29","subsection":"2"},"text":"The whole Spiritual World might (in that case) be drawn through the eye of a needle.","comment":null,"footnote":null}],"slug":"needle","url":"/meta/potts/needle/"}