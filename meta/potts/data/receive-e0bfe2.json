{"key":"e0bfe2202d3252b1","source_file":"Potts Re.json","source_id":7700,"source_url":"concordance-receive-ppl-accipere","term":"Receive","headwords":["Receive"],"latin":["Accipere"],"header_pairs":[{"english":["Receive"],"latin":["Accipere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP"],"contexts":[{"reference":{"work":"AC","section":"23","subsection":null},"text":"Day is taken from time itself. AC 34.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"30","subsection":"2"},"text":"They receive life through faith.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1084","subsection":null},"text":"They took a garment ().","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2511","subsection":null},"text":"He took Sarah ().","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3470","subsection":null},"text":"He took... Judith () = the adjunction of natural truth.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3570","subsection":"4"},"text":"The new soul which man receives.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3662","subsection":null},"text":"Not to take a woman () = not to be conjoined. AC 3681.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3687","subsection":"end"},"text":"To take to wife = to be associated and conjoined. AC 3703:16. AC 4437. AC 4820. AC 9002. AC 10651.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4262","subsection":null},"text":"To take of what came into his hand () = what was of the Divine Providence.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7207","subsection":null},"text":"I will take you... for a people () = that they shall be added to those in Heaven... thus to receive among those who are in Heaven.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7322","subsection":null},"text":"To take the rod and stretch out the hand = to exercise power.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7835","subsection":null},"text":"To take, with a neighbour, one of the flock () = conjunction.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9265","subsection":null},"text":"Not to receive (a gift) = to be averse to.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10405","subsection":null},"text":"To receive out of the hand = to receive such things as are his.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"161","subsection":null},"text":"Remember how thou hast received and heard (). Explained.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"189","subsection":null},"text":"That no one take thy crown () = lest wisdom perish.","comment":null,"footnote":null}],"slug":"receive-e0bfe2","url":"/meta/potts/receive-e0bfe2/"}