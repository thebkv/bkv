{"key":"02aae369c9e3e974","source_file":"Potts Se.json","source_id":34379,"source_url":"concordance-serious-ppl-serius","term":"Serious","headwords":["Serious"],"latin":["Serius"],"header_pairs":[{"english":["Serious"],"latin":["Serius"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1509","subsection":null},"text":"Looking down on all who are in serious employments.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"80","subsection":null},"text":"But [let us address ourselves] to serious things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1125","subsection":null},"text":"Those in the class of the celestials... come into a Society of the serious; for, immediately after vastation, they love nothing more than serious thoughts.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1959","subsection":null},"text":"A certain Spirit not evil, but serious...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2502","subsection":null},"text":"They made it a trouble to me to think or do serious things.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3228","subsection":"end"},"text":"That assassin would have been one of the sternest judges.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4091","subsection":"end"},"text":"By serious repentance.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"6107","subsection":null},"text":"Moses was a serious man.","comment":null,"footnote":null}],"slug":"serious","url":"/meta/potts/serious/"}