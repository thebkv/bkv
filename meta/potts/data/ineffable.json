{"key":"7a3393b8ab26b568","source_file":"Potts In.json","source_id":5980,"source_url":"concordance-ineffable-ppl-ineffabilis","term":"Ineffable","headwords":["Ineffable","Ineffability"],"latin":["Ineffabilis","Ineffabilitas"],"header_pairs":[{"english":["Ineffable"],"latin":["Ineffabilis"]},{"english":["Ineffability"],"latin":["Ineffabilitas"]}],"header_sentences":["See Incomprehensible."],"redirect_xref":null,"works":["AC","CL","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"996","subsection":"2"},"text":"The happiness there is ineffable. AC 2363. AC 2889. AC 3938:5. HH 398.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1621","subsection":"end"},"text":"The varieties are... ineffable. DP 39.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1622","subsection":null},"text":"Ineffable things there. AC 1645. AC 1875. AC 1876. AC 2157. AC 4043:2. HH 239. DLW 202:3.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1887","subsection":"end"},"text":"The things in Heaven are ineffable.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1941","subsection":"end"},"text":"The wisdom of the Angels ineffable. AC 2367. AC 4383. AC 5202. HH 177. DLW 180.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1974","subsection":null},"text":"Which affected the mind in an ineffable manner.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3213","subsection":null},"text":"Angelic ideas ineffable.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5411","subsection":"2"},"text":"By ineffable representatives. HH 411:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6804","subsection":"2"},"text":"The things the Angels speak in Heaven are ineffable. DLW 203. DLW 239:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7381","subsection":"end"},"text":"The ineffable speech of the Angels.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9094","subsection":"2"},"text":"The things the Angels see and think in the light of Heaven are ineffable. HH 576:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9300","subsection":"6"},"text":"Hence they have intelligence and wisdom which are ineffable.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"386","subsection":null},"text":"The delights of conjugial love ineffable: and the more interior the more ineffable. HH 489:7.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"414","subsection":"end"},"text":"This form is ineffable beauty.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"42","subsection":"2"},"text":"These ideas in the world... are ineffable.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"224","subsection":"2"},"text":"The power of Divine truth is ineffable.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2462","subsection":null},"text":"Occurs.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3097","subsection":null},"text":"Ineffability occurs.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4931","subsection":"end"},"text":"The wickedness there is ineffable.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5743","subsection":"2"},"text":"The Lord's temptations were ineffable.","comment":null,"footnote":null}],"slug":"ineffable","url":"/meta/potts/ineffable/"}