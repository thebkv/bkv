{"key":"f14b6e6ff409f430","source_file":"Potts Ea - Es.json","source_id":55186,"source_url":"concordance-enormous-ppl-enormis","term":"Enormous","headwords":["Enormous","Enormity"],"latin":["Enormis","Enormitas"],"header_pairs":[{"english":["Enormous"],"latin":["Enormis"]},{"english":["Enormity"],"latin":["Enormitas"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","BE","DLife","DMin","TCR"],"contexts":[{"reference":{"work":"AC","section":"337","subsection":"end"},"text":"See Doctrine.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2371","subsection":"3"},"text":"In which merit is regarded as something enormous.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4493","subsection":"6"},"text":"The enormous crime (of Simeon and Levi).","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5780","subsection":null},"text":"To claim for themselves what is not their own, is an enormous evil. Signified.","comment":null,"footnote":null},{"reference":{"work":"DLife","section":"31","subsection":null},"text":"By this truth to destroy all the good of charity... is an enormous thing.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"795","subsection":null},"text":"How they might confirm this enormous falsity...","comment":null,"footnote":null},{"reference":{"work":"BE","section":"64","subsection":null},"text":"From the faith of the present Church... enormous births...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"94","subsection":null},"text":"From this... many enormities have flowed into the Church... These enormities enumerated.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4717","subsection":null},"text":"He was shown what a devil he was, and he was enormous.","comment":null,"footnote":null}],"slug":"enormous","url":"/meta/potts/enormous/"}