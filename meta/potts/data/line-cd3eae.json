{"key":"cd3eae310680ed40","source_file":"Potts Li.json","source_id":26940,"source_url":"concordance-line-ppl-linea","term":"Line","headwords":["Line","Linear"],"latin":["Linea","Linearis"],"header_pairs":[{"english":["Line"],"latin":["Linea"]},{"english":["Linear"],"latin":["Linearis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","DMin","DeVerbo","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1272","subsection":null},"text":"Children in a bent line. SE 3589.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1761","subsection":null},"text":"Linear vibrations and reciprocations.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4189","subsection":"3"},"text":"Not in a collateral line, but in the direct line.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5044","subsection":"7"},"text":"The desolation and vastation of truth is signified by the line of emptiness... ().","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6621","subsection":null},"text":"The thoughts of such are represented as closed lines... AC 1952.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9717","subsection":"2"},"text":"Truths are (there) presented as linear.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"305","subsection":"end"},"text":"Sub linea.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"332","subsection":null},"text":"In the line or radius in which the Angels look at the Lord.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"875","subsection":"7"},"text":"A line is not anything unless it becomes an area...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1940","subsection":"end"},"text":"This is represented in a spiritual idea as lines or radii, which are at once closed, so that there is nothing within them.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2299","subsection":null},"text":"This I perceived in a spiritual idea as little white lines.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3960","subsection":"end"},"text":"= He can set it forth in two lines...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4848","subsection":null},"text":"Lines expressing magic characters. Described.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4562","subsection":null},"text":"(Paul writes) by lines circumductas ad fines.","comment":null,"footnote":null},{"reference":{"work":"DeVerbo","section":"3","subsection":"7"},"text":"See Letter.","comment":null,"footnote":null},{"reference":{"work":"DeVerbo","section":"4","subsection":null},"text":"At this day part (of the Hebrew letters) are linear.","comment":null,"footnote":null}],"slug":"line-cd3eae","url":"/meta/potts/line-cd3eae/"}