{"key":"2f6dd2fbdf73cd6a","source_file":"Potts Ca - Ce.json","source_id":7312,"source_url":"concordance-candle-ppl-candela","term":"Candle","headwords":["Candle"],"latin":["Candela"],"header_pairs":[{"english":["Candle"],"latin":["Candela"]}],"header_sentences":["See Lamp."],"redirect_xref":null,"works":["AC","AE","CL","DP","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1053","subsection":"2"},"text":"Like the light of the sun compared with that of a candle.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7801","subsection":null},"text":"Like the reflected light of a candle.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"167","subsection":null},"text":"The light in the highest Hell is like the light from candles.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"380","subsection":"4"},"text":"On the table he had a candle... and the candle seemed to be carried about.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"396","subsection":null},"text":"Like a lantern without a lighted candle.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"385","subsection":null},"text":"Under Read, see this reference.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4047","subsection":null},"text":"On candles and lights.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"252","subsection":"4"},"text":"Let your loins be girded and your candles lighted... The candles they are to have lighted = truths of faith from the good of love.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"675","subsection":"10"},"text":"A lighted candle () = inquiry in herself from affection.","comment":null,"footnote":null}],"slug":"candle","url":"/meta/potts/candle/"}