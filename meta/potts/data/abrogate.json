{"key":"d4cbf2e76fc7d56e","source_file":"Potts Aa - Am.json","source_id":5265,"source_url":"concordance-abrogate-ppl-abrogare","term":"Abrogate","headwords":["Abrogate"],"latin":["Abrogare"],"header_pairs":[{"english":["Abrogate"],"latin":["Abrogare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","Char","TCR"],"contexts":[{"reference":{"work":"AC","section":"2180","subsection":"7"},"text":"Wherefore the Lord abrogated sacrifices, etc. AC 4489:3. AC 10637.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3900","subsection":"8"},"text":"They abrogate the Word.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8972","subsection":"2"},"text":"Although abrogated they are still holy things of the Word. AC 9349:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9211","subsection":"2"},"text":"This part of the Word is not abrogated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9349","subsection":"4"},"text":"The laws, judgments and statutes that are abrogated as to use where the Church is at this day. Enumerated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10360","subsection":"8"},"text":"The Lord abrogated the Sabbath as to representative worship...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"153","subsection":"6"},"text":"After a few days they are deprived of office. AR 153:7. TCR 281:6. TCR 281:7.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"670","subsection":"2"},"text":"The Lord abrogated representative things, retaining only two...","comment":null,"footnote":null},{"reference":{"work":"Char","section":"79","subsection":null},"text":"Deprivations of office...","comment":null,"footnote":null}],"slug":"abrogate","url":"/meta/potts/abrogate/"}