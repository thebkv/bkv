{"key":"a1a9258b74835a9c","source_file":"Potts Re.json","source_id":12781,"source_url":"concordance-recur-ppl-recurrere","term":"Recur","headwords":["Recur"],"latin":["Recurrere"],"header_pairs":[{"english":["Recur"],"latin":["Recurrere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"561","subsection":"end"},"text":"When states of evil and falsity... recur...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4301","subsection":"4"},"text":"When a like delight recurs, such objects recur...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3483","subsection":"2"},"text":"This phantasy, once imbued... easily and spontaneously recurs.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4113","subsection":null},"text":"So long as evil is in the thought only, it does not so much recur.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4222","subsection":null},"text":"When this recurs frequently, it becomes familiar.","comment":null,"footnote":null}],"slug":"recur","url":"/meta/potts/recur/"}