{"key":"8ffa75cb3bf4bb49","source_file":"Potts Re.json","source_id":55127,"source_url":"concordance-revenge-ppl-ultio","term":"Revenge","headwords":["Revenge","Revenger"],"latin":["Ultio","Ulcisci","Ultor"],"header_pairs":[{"english":["Revenge"],"latin":["Ultio","Ulcisci"]},{"english":["Revenger"],"latin":["Ultor"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DLord"],"contexts":[{"reference":{"work":"AC","section":"8226","subsection":"end"},"text":"It is said that revenge will be taken (by the Lord), and that He will be avenged.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10618","subsection":"3"},"text":"He wants the Divine to favour him... that he may revenge himself or be revenged on all whom he hates.","comment":null,"footnote":null},{"reference":{"work":"DLord","section":"14","subsection":"4"},"text":"A day of vengeance, that He may take vengeance of His enemies () = His advent on this account into the world.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"275","subsection":"14"},"text":"Occurs. AE 750:22, AE 778:2.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"811","subsection":"14"},"text":"The gall of revenges () = malice and cruelty.","comment":null,"footnote":null}],"slug":"revenge-8ffa75","url":"/meta/potts/revenge-8ffa75/"}