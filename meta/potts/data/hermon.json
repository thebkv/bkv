{"key":"f9a564d49b0d28d2","source_file":"Potts Hi - Hy.json","source_id":14608,"source_url":"concordance-hermon-ppl-chermon","term":"Hermon","headwords":["Hermon"],"latin":["Chermon"],"header_pairs":[{"english":["Hermon"],"latin":["Chermon"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"9011","subsection":"6"},"text":"See Carmel.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"298","subsection":"2"},"text":"Tabor and Hermon () = those who are in Divine good and in Divine truth.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"340","subsection":"14"},"text":"These things are signified by the dew of Hermon which descends upon the mountains of Zion ().","comment":null,"footnote":null},{"reference":{"work":"AE","section":"375","subsection":"26"},"text":"The dew of Hermon = Divine truth... Thus the dew of Hermon which descends upon the mountains of Zion = the conjunction of truth and good.","comment":null,"footnote":null}],"slug":"hermon","url":"/meta/potts/hermon/"}