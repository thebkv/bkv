{"key":"91a96ae205460745","source_file":"Potts Fl - Fu.json","source_id":11279,"source_url":"concordance-fly-ppl-musca","term":"Fly","headwords":["Fly"],"latin":["Musca"],"header_pairs":[{"english":["Fly"],"latin":["Musca"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DMin","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1594","subsection":"4"},"text":"Occurs. TCR 335:5.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7441","subsection":"2"},"text":"It is these (sensuous) falsities which are signified by the flies of Egypt (). (See Fly.) AC 9331:4. AC 10582:4. AE 410:6.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"68","subsection":"2"},"text":"Than a fly against a camel.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"381","subsection":null},"text":"Like flies round the head of a running horse. TCR 590. ISB 14:6.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2922","subsection":null},"text":"[2921a]. They would all flee from a single fly. SE 3749.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3332","subsection":null},"text":"I fixed my look on a fly...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4304","subsection":"end"},"text":"They are likened to flies...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4743","subsection":null},"text":"Like the flies of a marsh which fly up in a body, and then settle in the marsh.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4757","subsection":null},"text":"As easily as if they had been flies.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"740","subsection":"10"},"text":"See Beelzebub.","comment":null,"footnote":null}],"slug":"fly-91a96a","url":"/meta/potts/fly-91a96a/"}