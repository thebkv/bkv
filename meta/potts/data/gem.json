{"key":"b30e791389be1154","source_file":"Potts Ga - Gn.json","source_id":13502,"source_url":"concordance-gem-ppl-gemma","term":"Gem","headwords":["Gem"],"latin":["Gemma"],"header_pairs":[{"english":["Gem"],"latin":["Gemma"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL"],"contexts":[{"reference":{"work":"AC","section":"3812","subsection":"4"},"text":"Gems () are predicated of the truths which are from good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9847","subsection":"end"},"text":"Good and truth are as gold and the gem which it encompasses...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"12","subsection":null},"text":"Utensils... formed of entire gems in heavenly forms.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"14","subsection":"end"},"text":"The cups were of transparent gems.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"97","subsection":null},"text":"That with man marriage love is in the love of the sex as a gem in its matrix.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"389","subsection":"end"},"text":"Is evident from the matrixes... in which noble gems... are stored up.","comment":null,"footnote":null}],"slug":"gem","url":"/meta/potts/gem/"}