{"key":"ee885a41c341ab94","source_file":"Potts Ph - Po.json","source_id":8873,"source_url":"concordance-pitch-ppl-pix","term":"Pitch","headwords":["Pitch","Pitch-black"],"latin":["Pix","Piceus"],"header_pairs":[{"english":["Pitch"],"latin":["Pix"]},{"english":["Pitch-black"],"latin":["Piceus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"643","subsection":null},"text":"Pitch = direful phantasies.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1299","subsection":"end"},"text":"Pitch and sulphur = falsities and evils of cupidities. AC 6724.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1861","subsection":"4"},"text":"Burning pitch () = direful cupidities, ( = dense and direful falsities. AC 2446:2).","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6724","subsection":null},"text":"Under Bitumen, see this reference.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"380","subsection":"2"},"text":"Built of pitch-black stones. TCR 352.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3210","subsection":"end"},"text":"He was pitch-black...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"304","subsection":"7"},"text":"Burning pitch = all evil springing from the love of self...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"578","subsection":"5"},"text":"The streams shall be turned into pitch () = the Hell into which will be cast those who are in the falsities of evil. The evil of infernal love and its penalty is signified by burning pitch not extinguished night or day.","comment":null,"footnote":null}],"slug":"pitch","url":"/meta/potts/pitch/"}