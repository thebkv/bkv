{"key":"8596ff66b3ac4341","source_file":"Potts In.json","source_id":4205,"source_url":"concordance-indemnify-ppl-indemnificare","term":"Indemnify","headwords":["Indemnify","Indemnification"],"latin":["Indemnificare","Indemnisare","Indemnificatio"],"header_pairs":[{"english":["Indemnify"],"latin":["Indemnificare","Indemnisare"]},{"english":["Indemnification"],"latin":["Indemnificatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","Inv","TCR"],"contexts":[{"reference":{"work":"AC","section":"4172","subsection":null},"text":"I indemnified it () = that good was thence. To indemnify = to render what is good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9030","subsection":null},"text":"Indemnification... here, of spiritual truth. Signified.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"630","subsection":null},"text":"To keep his body from harm.","comment":null,"footnote":null},{"reference":{"work":"Inv","section":"8","subsection":null},"text":"Unless a man approaches the Lord, he labours in vain to keep himself from harm.","comment":null,"footnote":null}],"slug":"indemnify","url":"/meta/potts/indemnify/"}