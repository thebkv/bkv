{"key":"77996355dd5c0ba1","source_file":"Potts St - Sy.json","source_id":25762,"source_url":"concordance-strike-ppl-impingere","term":"Strike","headwords":["Strike"],"latin":["Impingere"],"header_pairs":[{"english":["Strike"],"latin":["Impingere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","SE"],"contexts":[{"reference":{"work":"AC","section":"9163","subsection":"2"},"text":"To stumble on () = to be scandalized, and so from truths to fall into falsities.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9348","subsection":"3"},"text":"To strike on backward () = to avert themselves from what is good and true.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3666","subsection":null},"text":"See Street.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"556","subsection":"9"},"text":"To smite on the right cheek = to do harm to the perception and understanding of interior truth.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"652","subsection":"4"},"text":"Truth has stumbled in the street (). Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"701","subsection":"9"},"text":"To stumble in the law () = to live contrary to Divine truth.","comment":null,"footnote":null}],"slug":"strike-779963","url":"/meta/potts/strike-779963/"}