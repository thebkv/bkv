{"key":"721e45990bf22302","source_file":"Potts I - Im.json","source_id":13673,"source_url":"concordance-immediately-ppl-statim","term":"Immediately","headwords":["Immediately"],"latin":["Statim"],"header_pairs":[{"english":["Immediately"],"latin":["Statim"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH"],"contexts":[{"reference":{"work":"AC","section":"5006","subsection":"4"},"text":"Immediately after death man is in the other life...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5078","subsection":"3"},"text":"Man rises again immediately after death...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"280","subsection":"2"},"text":"See Immediate.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"348","subsection":null},"text":"Those (in Heaven) are in good who immit Divine truths immediately into life... But those are called the intelligent who do not immit Divine truths immediately into life...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"491","subsection":null},"text":"But some... immediately after death are either taken up into Heaven, or cast into Hell...","comment":null,"footnote":null}],"slug":"immediately-721e45","url":"/meta/potts/immediately-721e45/"}