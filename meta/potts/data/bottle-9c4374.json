{"key":"9c4374b7179ec33f","source_file":"Potts Bl - Bu.json","source_id":18781,"source_url":"concordance-bottle-ppl-lagena","term":"Bottle","headwords":["Bottle"],"latin":["Lagena"],"header_pairs":[{"english":["Bottle"],"latin":["Lagena"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"2674","subsection":null},"text":"(Hagar's) bottle of water () = very little truth. AC 2681. AC 2703.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5567","subsection":"2"},"text":"An earthen flask in his hand...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"177","subsection":"9"},"text":"A bottle, or potter's vessel () = falsity.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"374","subsection":"13"},"text":"A flagon () = that which contains, thus the ultimate sense of the Word, which they apply to their falsities and evils.","comment":null,"footnote":null}],"slug":"bottle-9c4374","url":"/meta/potts/bottle-9c4374/"}