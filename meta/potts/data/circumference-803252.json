{"key":"803252b7d1c6651a","source_file":"Potts Ci - Cl.json","source_id":1218,"source_url":"concordance-circumference-ppl-circumferentia","term":"Circumference","headwords":["Circumference"],"latin":["Circumferentia"],"header_pairs":[{"english":["Circumference"],"latin":["Circumferentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","TCR"],"contexts":[{"reference":{"work":"AC","section":"1624","subsection":null},"text":"A very bright light encompassed with a kind of circumference...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1625","subsection":null},"text":"At the circumference...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5291","subsection":"10"},"text":"The number of the circumference does not answer geometrically to the diameter, yet spiritually it involves that which is signified by the compass of that vessel.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"268","subsection":"end"},"text":"The nations in Asia and the Indies constitute the last circumference.","comment":null,"footnote":null}],"slug":"circumference-803252","url":"/meta/potts/circumference-803252/"}