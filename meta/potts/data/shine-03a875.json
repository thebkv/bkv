{"key":"03a8752b2e74987b","source_file":"Potts Sh - So.json","source_id":6734,"source_url":"concordance-shine-ppl-fulgere","term":"Shine","headwords":["Shine"],"latin":["Fulgere"],"header_pairs":[{"english":["Shine"],"latin":["Fulgere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DLW","DWis","HH"],"contexts":[{"reference":{"work":"AC","section":"9263","subsection":"5"},"text":"The just shall shine as the sun (). Explained. HH 348:2. AE 401:7. AE 911:6, Explained. DLove 20:end.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"179","subsection":"2"},"text":"The Divine good and truth are less refulgent with those less intelligent.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"185","subsection":null},"text":"The palaces shone above as if of pure gold, below as if of precious stones.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"361","subsection":null},"text":"Uses shine thus in Heaven. CL 266:2.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"233","subsection":"2"},"text":"The Sun (then) shone out with a more eminent beam and resplendence.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"432","subsection":"3"},"text":"The light of Heaven shone on it.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"137","subsection":"end"},"text":"The furniture shone with gold...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"380","subsection":"3"},"text":"The books shone as with light.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"74","subsection":null},"text":"His face as the sun shineth ().","comment":null,"footnote":null},{"reference":{"work":"AE","section":"440","subsection":"6"},"text":"Shine forth () = that the Lord sends out light which illustrates minds.","comment":null,"footnote":null},{"reference":{"work":"DWis","section":"1","subsection":null},"text":"4. Ex fulgentissimo auro.","comment":null,"footnote":null}],"slug":"shine-03a875","url":"/meta/potts/shine-03a875/"}