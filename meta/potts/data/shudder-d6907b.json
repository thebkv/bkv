{"key":"d6907be3d32b3b9e","source_file":"Potts Sh - So.json","source_id":10667,"source_url":"concordance-shudder-ppl-horrescere","term":"Shudder","headwords":["Shudder","Shuddering, A"],"latin":["Horrescere","Horrescentia"],"header_pairs":[{"english":["Shudder"],"latin":["Horrescere"]},{"english":["Shuddering, A"],"latin":["Horrescentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"7918","subsection":null},"text":"Horror is insinuated, (so) that when the like inflows into the thought, that shuddering returns.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8162","subsection":null},"text":"A shuddering. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8162","subsection":null},"text":"To fear, when predicated of temptation, = horror or shuddering.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8171","subsection":null},"text":"Spiritual fear in temptations is first shuddering, at last despair.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9222","subsection":"3"},"text":"If man saw... he would shudder.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"572","subsection":null},"text":"When heat from Heaven inflows, those in Hell shiver like those seized with ague.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4504","subsection":null},"text":"The very Hells at last shuddered at her.","comment":null,"footnote":null}],"slug":"shudder-d6907b","url":"/meta/potts/shudder-d6907b/"}