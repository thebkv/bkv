{"key":"6648e54ce1a3913e","source_file":"Potts O.json","source_id":7112,"source_url":"concordance-ocean-ppl-oceanus","term":"Ocean","headwords":["Ocean"],"latin":["Oceanus"],"header_pairs":[{"english":["Ocean"],"latin":["Oceanus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DSS","LJPost","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2553","subsection":null},"text":"Like the unterminated sight in some ocean...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4171","subsection":null},"text":"As from an ocean of evils... SE 2486.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8175","subsection":null},"text":"Unless the Divine were to act against the Hells, they would rush in, like the greatest ocean...","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"95","subsection":"2"},"text":"For the sun is a fiery ocean.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"32","subsection":"9"},"text":"(This) is an ocean, in which the human mind may as it were navigate; but it must beware of the tempest...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"67","subsection":null},"text":"Like birds which fly over a great ocean...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"123","subsection":"5"},"text":"(The combat of the Lord with Hell) may be compared to a resistance against the universal ocean...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"154","subsection":"5"},"text":"The Word of the Lord is like an ocean...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"767","subsection":"3"},"text":"All whirlpools and ocean sandbanks...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3939","subsection":null},"text":"Like a particle of water to the ocean.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4657","subsection":null},"text":"There