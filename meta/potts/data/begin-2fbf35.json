{"key":"2fbf35b9a25c6a56","source_file":"Potts Ba - Bi.json","source_id":27897,"source_url":"concordance-begin-ppl-inchoare","term":"Begin","headwords":["Begin","Beginning"],"latin":["Inchoare","Inchoamentum"],"header_pairs":[{"english":["Begin"],"latin":["Inchoare"]},{"english":["Beginning"],"latin":["Inchoamentum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DLW","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"8037","subsection":"end"},"text":"Then heavenly joy first begins... AC 8462:end.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"330","subsection":null},"text":"Little children who die... are only in the rudiments of the capacity of becoming Angels.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"409","subsection":null},"text":"Heavenly joy... begins from the inmost principles.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"432","subsection":null},"text":"The nature of this rudiment (of man) in its form.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"98","subsection":null},"text":"This love does indeed begin from the love of the sex.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"587","subsection":"end"},"text":"When he wills to shun evil, and do good, the state of regeneration begins.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"766","subsection":"end"},"text":"He continues to eternity the rudiments of wisdom implanted in the natural world.","comment":null,"footnote":null}],"slug":"begin-2fbf35","url":"/meta/potts/begin-2fbf35/"}