{"key":"585ad52bd2d78bd7","source_file":"Potts Aa - Am.json","source_id":1942,"source_url":"concordance-abolish-ppl-abolere","term":"Abolish","headwords":["Abolish","Abolition"],"latin":["Abolere","Abolitio"],"header_pairs":[{"english":["Abolish"],"latin":["Abolere"]},{"english":["Abolition"],"latin":["Abolitio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","LJ","TCR"],"contexts":[{"reference":{"work":"AC","section":"59","subsection":null},"text":"Cupidities and falsities cannot be abolished in a moment...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"868","subsection":null},"text":"Not a single evil or falsity is so dispersed as to be abolished... AC 887.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4904","subsection":"2"},"text":"Why the Lord abolished representatives? AC 5136:2. AE 700:33. AE 700:35.","comment":null,"footnote":null},{"reference":{"work":"LJ","section":"65","subsection":null},"text":"On the former heaven and its abolition. General article.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"102","subsection":null},"text":"Falsities and evils in man are not abolished, but removed, and when removed they appear to be abolished. Signified.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"539","subsection":"2"},"text":"Sins are not abolished, but removed...","comment":null,"footnote":null}],"slug":"abolish-585ad5","url":"/meta/potts/abolish-585ad5/"}