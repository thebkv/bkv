{"key":"b97abbd1aec55cac","source_file":"Potts Fa - Fe.json","source_id":30713,"source_url":"concordance-fascinate-ppl-fascinare","term":"Fascinate","headwords":["Fascinate","Fascination","Fascinator","Witchcraft"],"latin":["Fascinare","Fascinatio","Fascinator","Fascinum"],"header_pairs":[{"english":["Fascinate"],"latin":["Fascinare"]},{"english":["Fascination"],"latin":["Fascinatio"]},{"english":["Fascinator"],"latin":["Fascinator"]},{"english":["Witchcraft"],"latin":["Fascinum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","Coro","DMin","DP","DeConj","LJPost","SE"],"contexts":[{"reference":{"work":"AC","section":"4227","subsection":"end"},"text":"(The art of fascinating there.) SE 1822. SE 3090. SE 4828. AE 1107.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"130","subsection":null},"text":"It fascinates the external of thought.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"439","subsection":"2"},"text":"Can fascinate the understanding... AE 715:3.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"462","subsection":"2"},"text":"This was spiritual witchcraft. Described.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3137","subsection":null},"text":"They were interior magicians, fascinators...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3719","subsection":"end"},"text":"They can thus fascinate men. SE 3723.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5306","subsection":null},"text":"They fascinate a holy external before the eyes.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4746","subsection":null},"text":"This is fascination, or the taking away of the power of another.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4746","subsection":null},"text":"Their fascination consists in this...","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4747","subsection":null},"text":"They attack all they meet with their witchcrafts...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"544","subsection":null},"text":"Not by any persuasive fascination.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"556","subsection":null},"text":"This speech fascinates and infatuates the minds of others...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"590","subsection":"2"},"text":"Under Enchant, see this reference.","comment":null,"footnote":null},{"reference":{"work":"LJPost","section":"27","subsection":null},"text":"See Persuade.","comment":null,"footnote":null},{"reference":{"work":"DeConj","section":"93","subsection":null},"text":"The women fascinate the men, and the men the women, by diabolical arts.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"33","subsection":null},"text":"As if it were to fascinate their souls. Signified.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"45","subsection":null},"text":"The Hells of the Ancient Church... exercise their arts... by means of witchcrafts, etc.","comment":null,"footnote":null}],"slug":"fascinate","url":"/meta/potts/fascinate/"}