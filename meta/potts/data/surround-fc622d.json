{"key":"fc622d21260e1991","source_file":"Potts St - Sy.json","source_id":47768,"source_url":"concordance-surround-ppl-circumfundere","term":"Surround","headwords":["Surround","Surrounding, A"],"latin":["Circumfundere","Circumfusio"],"header_pairs":[{"english":["Surround"],"latin":["Circumfundere"]},{"english":["Surrounding, A"],"latin":["Circumfusio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DP","HH"],"contexts":[{"reference":{"work":"AC","section":"7313","subsection":"2"},"text":"They who are in infestations are surrounded by falsities...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8137","subsection":"3"},"text":"A surrounding by waters as of the sea... For at His presence they are surrounded by their own evils and falsities, AC 8188. AC 8223. AC 8299.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"17","subsection":null},"text":"There are spiritual spheres of life, which... surround them...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"296","subsection":"6"},"text":"As sound... spreads itself around in the air...","comment":null,"footnote":null}],"slug":"surround-fc622d","url":"/meta/potts/surround-fc622d/"}