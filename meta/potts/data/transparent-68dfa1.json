{"key":"68dfa1c0f37b7936","source_file":"Potts To - Ty.json","source_id":10789,"source_url":"concordance-transparent-ppl-transparens","term":"Transparent","headwords":["Transparent","Transparency","Shine through"],"latin":["Transparens","Transparentia","Transparere"],"header_pairs":[{"english":["Transparent"],"latin":["Transparens"]},{"english":["Transparency"],"latin":["Transparentia"]},{"english":["Shine through"],"latin":["Transparere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DSS","HH"],"contexts":[{"reference":{"work":"AC","section":"1043","subsection":"3"},"text":"He would wonder that rays of light could ever shine through...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6222","subsection":"2"},"text":"They appear, as it were by transparency, as to their quality.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8243","subsection":"end"},"text":"By means of the face, the mind as it were shines through.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"356","subsection":null},"text":"Their interiors were seen as if transparent from light.","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"42","subsection":null},"text":"Such is the Word in the sense of the letter, from its transparency. Signified.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"264","subsection":null},"text":"Through which fire... shone duskily.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"273","subsection":"2"},"text":"The internal affections shine through.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"382","subsection":null},"text":"From the transparency of this is the dawn and crimson of her life.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1059","subsection":"end"},"text":"Not from any transparency; but from a transpiration.","comment":null,"footnote":null}],"slug":"transparent-68dfa1","url":"/meta/potts/transparent-68dfa1/"}