{"key":"2ad6fdd8cd88e2ca","source_file":"Potts Mi - My.json","source_id":13878,"source_url":"concordance-mistress-ppl-domina","term":"Mistress","headwords":["Mistress"],"latin":["Domina"],"header_pairs":[{"english":["Mistress"],"latin":["Domina"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL"],"contexts":[{"reference":{"work":"AC","section":"1911","subsection":null},"text":"Her mistress was vile in her eyes () = that this Rational held cheap truth itself adjoined to good. Mistress, or Sarai, = truth adjoined to good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1911","subsection":"6"},"text":"Mistress; that is, intellectual truth.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1936","subsection":null},"text":"Return to thy mistress ()... Mistress = the affection of interior truth.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2015","subsection":"5"},"text":"Mistresses () = goods, from which they will be suckled. ( = wisdom. AC 3183:end.) ( = the insinuation of good, which is of wisdom. AC 6740:2.)","comment":null,"footnote":null},{"reference":{"work":"CL","section":"283","subsection":"end"},"text":"That the master and mistress should agree...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"291","subsection":"3"},"text":"A ruling wife...","comment":null,"footnote":null}],"slug":"mistress-2ad6fd","url":"/meta/potts/mistress-2ad6fd/"}