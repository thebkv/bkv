{"key":"eb0ac66a217e1da5","source_file":"Potts St - Sy.json","source_id":37491,"source_url":"concordance-such-ppl-talis","term":"Such","headwords":["Such"],"latin":["Talis"],"header_pairs":[{"english":["Such"],"latin":["Talis"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH"],"contexts":[{"reference":{"work":"AC","section":"4227","subsection":null},"text":"They who have been such (here), are such in the other life.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8991","subsection":"2"},"text":"Such he remains. NJHD 62:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10153","subsection":"2"},"text":"Everyone is such as is his good.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"350","subsection":"2"},"text":"Man is such as is his will and understanding. HH 358.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"480","subsection":null},"text":"After 2000 years, they were found to be altogether such as they had been described.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"501","subsection":null},"text":"Man is altogether such as he is as to his interiors.","comment":null,"footnote":null}],"slug":"such","url":"/meta/potts/such/"}