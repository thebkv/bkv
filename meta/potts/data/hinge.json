{"key":"c7354d2d74b330b4","source_file":"Potts Hi - Hy.json","source_id":19699,"source_url":"concordance-hinge-ppl-cardo","term":"Hinge","headwords":["Hinge"],"latin":["Cardo"],"header_pairs":[{"english":["Hinge"],"latin":["Cardo"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","Coro","DMin","DP","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"9730","subsection":"2"},"text":"The hinge of the determinations is (then) turned inwards.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"235","subsection":null},"text":"Like a hinge which can turn a door both ways...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"146","subsection":null},"text":"Like a door with a hinge, which is opened by determination...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"174","subsection":null},"text":"They began to pluck the door of the temple from its hinge...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"381","subsection":"4"},"text":"Like doors hanging from a round hinge...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5554","subsection":null},"text":"The spring of the hinges is in the endeavour.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4760","subsection":null},"text":"His presence smote me with a grievous pain in the hinges of the loins.","comment":null,"footnote":null},{"reference":{"work":"Coro","section":"28","subsection":null},"text":"No more moveable than a door without a hinge.","comment":null,"footnote":null}],"slug":"hinge","url":"/meta/potts/hinge/"}