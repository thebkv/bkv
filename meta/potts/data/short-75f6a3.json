{"key":"75f6a3a0a0f6fa72","source_file":"Potts Sh - So.json","source_id":9109,"source_url":"concordance-short-ppl-brevis","term":"Short","headwords":["Short","Shorten"],"latin":["Brevis","Abbreviare"],"header_pairs":[{"english":["Short"],"latin":["Brevis"]},{"english":["Shorten"],"latin":["Abbreviare"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","AR","BE","HH"],"contexts":[{"reference":{"work":"HH","section":"168","subsection":"end"},"text":"Times are short to those in glad states. AE 1219:4.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"4","subsection":"2"},"text":"Unless those days be shortened () = unless the Church be ended before its time.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"9","subsection":null},"text":"(Therefore) the time has been shortened by the Lord.","comment":null,"footnote":null},{"reference":{"work":"BE","section":"92","subsection":null},"text":"To shorten those days = to put an end to the present Church, and instaurate a new one. Explained. TCR 182. CanonsNC 47. Trinity. 10. 1.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"328","subsection":"14"},"text":"Occurs. AE 1066.","comment":null,"footnote":null}],"slug":"short-75f6a3","url":"/meta/potts/short-75f6a3/"}