{"key":"aed2f560df710449","source_file":"Potts Ph - Po.json","source_id":21248,"source_url":"concordance-portent-ppl-portentum","term":"Portent","headwords":["Portent"],"latin":["Portentum"],"header_pairs":[{"english":["Portent"],"latin":["Portentum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","TCR"],"contexts":[{"reference":{"work":"AC","section":"7030","subsection":null},"text":"See all the portents which I have put in thine hand () = the mediums of power from the Spiritual then. Portents, or miracles, = mediums of Divine power.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"10","subsection":"3"},"text":"On seeing him the Angels said. What portent is this?","comment":null,"footnote":null},{"reference":{"work":"CL","section":"533","subsection":null},"text":"Let down the paper to the earth, and you will see a portent. Described.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"16","subsection":"end"},"text":"On seeing this portent they laughed.","comment":null,"footnote":null}],"slug":"portent","url":"/meta/potts/portent/"}