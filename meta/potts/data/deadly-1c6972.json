{"key":"1c697248fe67c12f","source_file":"Potts De.json","source_id":81,"source_url":"concordance-deadly-ppl-internecinus","term":"Deadly","headwords":["Deadly"],"latin":["Internecinus"],"header_pairs":[{"english":["Deadly"],"latin":["Internecinus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","TCR"],"contexts":[{"reference":{"work":"AC","section":"818","subsection":"end"},"text":"Under Hate, see these references. AC 1032:3. AC 1267. SE 4205, etc.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"509","subsection":"end"},"text":"This lust (of varieties) is deadly to marriage love; and, as marriage love constitutes the inmost of life with man, it is deadly to that life.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"309","subsection":null},"text":"Not to bring any deadly evil upon his name and reputation.","comment":null,"footnote":null}],"slug":"deadly-1c6972","url":"/meta/potts/deadly-1c6972/"}