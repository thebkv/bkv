{"key":"645ef1f15bfb5fbb","source_file":"Potts Ea - Es.json","source_id":55826,"source_url":"concordance-entangle-ppl-intricare","term":"Entangle","headwords":["Entangle","Entangled"],"latin":["Intricare","Intricatus"],"header_pairs":[{"english":["Entangle"],"latin":["Intricare"]},{"english":["Entangled"],"latin":["Intricatus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW","SE"],"contexts":[{"reference":{"work":"AC","section":"4096","subsection":"3"},"text":"He loves to view more intricate things than these.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"283","subsection":"2"},"text":"Lest they should entangle the understanding in a so-called Gordian knot.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"155","subsection":"5"},"text":"However abstruse, intricate, varied, a thing may come forth in a lower sphere, still it can be reduced by God Messiah into heavenly order...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4628","subsection":null},"text":"This thought (is) not entangled and defiled with such ideas.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4676","subsection":null},"text":"They do not care for these entangled questions and disputations...","comment":null,"footnote":null}],"slug":"entangle-645ef1","url":"/meta/potts/entangle-645ef1/"}