{"key":"aeee55808d29d8eb","source_file":"Potts Sh - So.json","source_id":51950,"source_url":"concordance-sorcery-ppl-veneficium","term":"Sorcery","headwords":["Sorcery"],"latin":["Veneficium"],"header_pairs":[{"english":["Sorcery"],"latin":["Veneficium"]}],"header_sentences":["See Poison."],"redirect_xref":null,"works":["AE","AR","CL","SE"],"contexts":[{"reference":{"work":"AR","section":"800","subsection":null},"text":"By thy sorcery were all the nations seduced () = their wicked arts and cunning, by which they have led away minds from the holy worship of the Lord to the profane worship of living and dead men and idols. AE 1191.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"488","subsection":"2"},"text":"See Sorcery.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5496","subsection":null},"text":"On the Hell of poisoners.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"659","subsection":"5"},"text":"To poisoners nothing is more delightful than a cadaverous stench.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1191","subsection":null},"text":"Sorcery, in the Word, means almost the same as enchantment...","comment":null,"footnote":null}],"slug":"sorcery-aeee55","url":"/meta/potts/sorcery-aeee55/"}