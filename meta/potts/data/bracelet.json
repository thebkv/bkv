{"key":"14fc6eac413f84c7","source_file":"Potts Bl - Bu.json","source_id":21277,"source_url":"concordance-bracelet-ppl-armilla","term":"Bracelet","headwords":["Bracelet"],"latin":["Armilla"],"header_pairs":[{"english":["Bracelet"],"latin":["Armilla"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL"],"contexts":[{"reference":{"work":"AC","section":"3103","subsection":null},"text":"(The truth of the Church was represented by the bracelets given to a bride. Illustrated.)","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3105","subsection":null},"text":"Two bracelets () = Divine truth. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3105","subsection":null},"text":"Bracelets were also for a king, but on the arm. AE 358:2.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"20","subsection":"3"},"text":"The bridegroom took bracelets and a necklace of pearls, and fastened the bracelets on her wrists...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"42","subsection":"4"},"text":"Her bracelets were of pearls.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"195","subsection":"7"},"text":"Bracelets = the truths and goods of the Church. References.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"242","subsection":"15"},"text":"Bracelets upon the hands () = specifically, truths from good. References.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"358","subsection":"end"},"text":"A bracelet upon the arm () was an ensign of power... against what is evil and false.","comment":null,"footnote":null}],"slug":"bracelet","url":"/meta/potts/bracelet/"}