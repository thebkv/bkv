{"key":"4d1aa736a76e781a","source_file":"Potts Fi.json","source_id":18745,"source_url":"concordance-fit-together-ppl-concinnare","term":"Fit together","headwords":["Fit together","Finish","Neatly"],"latin":["Concinnare","Concinnitas","Concinne"],"header_pairs":[{"english":["Fit together"],"latin":["Concinnare"]},{"english":["Finish"],"latin":["Concinnitas"]},{"english":["Neatly"],"latin":["Concinne"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL","DLife","DSS","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"66","subsection":"end"},"text":"In a skillfully put together order...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"403","subsection":"end"},"text":"To fit together in a historical form... AC 813:2. AC 1020. AC 1756:2. AC 5291:4.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1974","subsection":null},"text":"Garlands... of such a form and skilful construction...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8891","subsection":"4"},"text":"They fitted together such things as fully corresponded.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8971","subsection":null},"text":"Composed in a more elegant style...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10406","subsection":null},"text":"To concoct a false doctrinal thing...","comment":null,"footnote":null},{"reference":{"work":"DSS","section":"13","subsection":"4"},"text":"In the spiritual sense all things cohere in a continuous connection, to the adjustment of which each word in the literal sense conduces.","comment":null,"footnote":null},{"reference":{"work":"DLife","section":"7","subsection":null},"text":"When they are composing their sermons...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"454","subsection":null},"text":"For finish and elegance of discourse...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"175","subsection":"3"},"text":"From the elegance and finish of the composition...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"370","subsection":"end"},"text":"To make various things belonging to women's work.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"60","subsection":null},"text":"The things in man fit themselves together by such a connection that the one belongs to the other.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"353","subsection":"2"},"text":"The light and glory of faith from the abundance of Truths fitting into it...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"381","subsection":"3"},"text":"Who dress the hair.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"786","subsection":"2"},"text":"The doctrine which they concocted...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"155","subsection":"4"},"text":"Occurs. SE 1681. SE 1937. AE 781:10.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2040","subsection":null},"text":"They who have constructed lexicons.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3757","subsection":"end"},"text":"They construct their nests so neatly... (and) had they needed garments they would have made them more neatly than man.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4263","subsection":null},"text":"They who are in charity... can as from themselves... construct whole doctrines...","comment":null,"footnote":null}],"slug":"fit-together","url":"/meta/potts/fit-together/"}