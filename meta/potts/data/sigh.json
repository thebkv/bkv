{"key":"d020d019cefeb779","source_file":"Potts Sh - So.json","source_id":12757,"source_url":"concordance-sigh-ppl-suspirare","term":"Sigh","headwords":["Sigh"],"latin":["Suspirare","Suspirium"],"header_pairs":[{"english":["Sigh"],"latin":["Suspirare","Suspirium"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","SE"],"contexts":[{"reference":{"work":"AC","section":"2209","subsection":"2"},"text":"In one sigh there are indefinite things which the Angels perceive, and which can never be described.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5365","subsection":"3"},"text":"With a holy aspiration.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5391","subsection":null},"text":"They become anxious, and sigh. SE 970.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6800","subsection":null},"text":"The sons of Israel sighed () = grief.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"611","subsection":null},"text":"They desire Heaven with some aspiration.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3308","subsection":null},"text":"The Angels know man's quality from a sigh. SE 3308. For a sigh is the thought of the heart.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4140","subsection":null},"text":"From whatever affection they think, as from a sigh...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"315","subsection":"17"},"text":"That gaspeth for breath () = grief.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"394","subsection":null},"text":"Sighs to the Lord. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"427","subsection":"2"},"text":"Those who groan and sigh over the abominations () = those not in evils and the derivative falsities: a groan and sigh over them = aversion and grief on account of them.","comment":null,"footnote":null}],"slug":"sigh","url":"/meta/potts/sigh/"}