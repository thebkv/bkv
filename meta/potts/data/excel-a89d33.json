{"key":"a89d339426a80214","source_file":"Potts Et - Ez.json","source_id":29193,"source_url":"concordance-excel-ppl-pollere","term":"Excel","headwords":["Excel"],"latin":["Pollere"],"header_pairs":[{"english":["Excel"],"latin":["Pollere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH"],"contexts":[{"reference":{"work":"AC","section":"1661","subsection":"2"},"text":"Before he excels in judgment...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1860","subsection":"2"},"text":"He who excels in the capacity of thinking...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3957","subsection":"2"},"text":"When man puts off the body, he excels in much more enlightened understanding...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5991","subsection":null},"text":"They who in the world had excelled in cleverness and in knowledges.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6598","subsection":null},"text":"One man excels another in the capacity of understanding and perceiving what is honest... what is just... and what is good... Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6697","subsection":null},"text":"The man who excels in understanding...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7437","subsection":"end"},"text":"In proportion as he excels in the gift of reasoning and perverting.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9128","subsection":"3"},"text":"He who excels others in the gift of thinking and perceiving...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"456","subsection":"3"},"text":"That their body excels in touch as before...","comment":null,"footnote":null}],"slug":"excel-a89d33","url":"/meta/potts/excel-a89d33/"}