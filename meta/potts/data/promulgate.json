{"key":"9ef32c7ba0375b93","source_file":"Potts Pr - Py.json","source_id":28808,"source_url":"concordance-promulgate-ppl-promulgare","term":"Promulgate","headwords":["Promulgate","Promulgation"],"latin":["Promulgare","Promulgatio"],"header_pairs":[{"english":["Promulgate"],"latin":["Promulgare"]},{"english":["Promulgation"],"latin":["Promulgatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"8862","subsection":null},"text":"Promulgated from Mount Sinai. AC 8862:2. AC 9411. DLife 53. DLife 55. CL 351:2. SE 3253.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8931","subsection":"end"},"text":"He willed to promulgate viva voce the ten commandments.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9414","subsection":"end"},"text":"The promulgation of the Law. Treated of. DLife 59.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"414","subsection":"2"},"text":"A law inscribed on the human heart, whence has been promulgated...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3891","subsection":null},"text":"Indignant that I should promulgate these things.","comment":null,"footnote":null}],"slug":"promulgate","url":"/meta/potts/promulgate/"}