{"key":"bb222e825fd04a3e","source_file":"Potts De.json","source_id":40512,"source_url":"concordance-devolve-ppl-devolvere","term":"Devolve","headwords":["Devolve","Devolution"],"latin":["Devolvere","Devolutio"],"header_pairs":[{"english":["Devolve"],"latin":["Devolvere"]},{"english":["Devolution"],"latin":["Devolutio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","Ath"],"contexts":[{"reference":{"work":"AC","section":"3789","subsection":null},"text":"To roll down the stone from the well's mouth () = to uncover the Word as to its interiors. AC 3798.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5650","subsection":null},"text":"To roll down upon us () = to present them in fault.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8719","subsection":null},"text":"Devolve from upon thee, and let them bear with thee () = to derive it also to others...","comment":null,"footnote":null},{"reference":{"work":"Ath","section":"190","subsection":null},"text":"The radiant circles are devolutions of the Infinite...","comment":null,"footnote":null}],"slug":"devolve","url":"/meta/potts/devolve/"}