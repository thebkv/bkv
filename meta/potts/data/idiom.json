{"key":"5f991daebdf7cd7b","source_file":"Potts I - Im.json","source_id":5145,"source_url":"concordance-idiom-ppl-idioma","term":"Idiom","headwords":["Idiom"],"latin":["Idioma"],"header_pairs":[{"english":["Idiom"],"latin":["Idioma"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE"],"contexts":[{"reference":{"work":"AC","section":"4195","subsection":null},"text":"In the idiom of Syria.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4196","subsection":null},"text":"In the Hebrew idiom...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4197","subsection":"2"},"text":"In his own idiom... and, afterwards, in the idiom of Canaan.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4197","subsection":null},"text":"To speak in the idiom, or lip, of Canaan, is to apply himself to the Divine. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1305","subsection":null},"text":"All would perceive it in their own language, or in their own idiom.","comment":null,"footnote":null}],"slug":"idiom","url":"/meta/potts/idiom/"}