ained.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"421","subsection":"end"},"text":"Charity for the sake of self and the world is spurious charity.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"450","subsection":null},"text":"On spurious charity. TCR 451. TCR 457.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1808","subsection":null},"text":"On those who constitute spurious spirits. SE 1812. LJPost 59.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3353","subsection":null},"text":"A spurious offspring of the Most Ancient Church.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4717","subsection":null},"text":"Such are spurious within, in the love of self...","comment":null,"footnote":null}],"slug":"spurious","url":"/meta/potts/spurious/"}