{"key":"4864b085f2eabd91","source_file":"Potts In.json","source_id":5852,"source_url":"concordance-industry-ppl-industria","term":"Industry","headwords":["Industry","Industrious"],"latin":["Industria","Industrius"],"header_pairs":[{"english":["Industry"],"latin":["Industria"]},{"english":["Industrious"],"latin":["Industrius"]}],"header_sentences":["See Assiduity."],"redirect_xref":null,"works":["AC","CL","Char","DLove","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"5388","subsection":null},"text":"He had been one among the industrious ones. SE 1168.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"104","subsection":"end"},"text":"Prepared by human industry...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"164","subsection":null},"text":"Industry (one of the virtues which belong to the moral wisdom of the men).","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"531","subsection":null},"text":"By the industry and the works of men.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"956","subsection":null},"text":"They are not active robbers.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1160","subsection":"end"},"text":"The active robber confessed the same.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1169","subsection":"end"},"text":"Occurs. SE 1171. SE 1173. SE 2289. SE 5638. SE 6008. SE 6071. DWis 3. 3.","comment":null,"footnote":null},{"reference":{"work":"DLove","section":"17","subsection":"3"},"text":"With all diligence and industry.","comment":null,"footnote":null},{"reference":{"work":"Char","section":"195","subsection":null},"text":"They who have an affection for mere gain... may be industrious, etc.","comment":null,"footnote":null}],"slug":"industry","url":"/meta/potts/industry/"}