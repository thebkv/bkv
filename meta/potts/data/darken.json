{"key":"0dd88036812541eb","source_file":"Potts Da.json","source_id":2047,"source_url":"concordance-darken-ppl-obfuscare","term":"Darken","headwords":["Darken","Darkening"],"latin":["Obfuscare","Obfuscatio"],"header_pairs":[{"english":["Darken"],"latin":["Obfuscare"]},{"english":["Darkening"],"latin":["Obfuscatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1639","subsection":null},"text":"(The corporeal memory) darkens the interior one.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2056","subsection":null},"text":"The darkening and contamination of a thing. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2196","subsection":"13"},"text":"Man's Rational... thus darkened...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"404","subsection":null},"text":"Resplendent before the eyes of men, but dark before those of Angels.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2263","subsection":"end"},"text":"There thus results nothing but a darkening of the true light.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2264","subsection":null},"text":"Thus the light is darkened, as by a rain cloud...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5749","subsection":null},"text":"Heaven begins to be darkened in them...","comment":null,"footnote":null}],"slug":"darken","url":"/meta/potts/darken/"}