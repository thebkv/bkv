{"key":"afe83a0209367d64","source_file":"Potts Sa - Sc.json","source_id":6403,"source_url":"concordance-salute-ppl-salutare","term":"Salute","headwords":["Salute","Salutation"],"latin":["Salutare","Salutatio"],"header_pairs":[{"english":["Salute"],"latin":["Salutare"]},{"english":["Salutation"],"latin":["Salutatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","CL","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"8736","subsection":null},"text":"These saints, who are saluted as lords.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"287","subsection":"2"},"text":"Salutations in ancient times were... Peace be with you; which the Lord confirmed...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"12","subsection":null},"text":"Grace be to you, and peace = a Divine salutation. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"463","subsection":"6"},"text":"I saluted them, and said...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"75","subsection":"end"},"text":"After a salutation of peace, we departed.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"115","subsection":"end"},"text":"The Angel, after a salutation of peace... ascended.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3284","subsection":null},"text":"Occurs. SE 4728:2. AE 365:8.","comment":null,"footnote":null}],"slug":"salute","url":"/meta/potts/salute/"}