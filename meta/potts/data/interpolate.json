{"key":"ec0e08f85baaee38","source_file":"Potts In.json","source_id":67336,"source_url":"concordance-interpolate-ppl-interpolare","term":"Interpolate","headwords":["Interpolate"],"latin":["Interpolare"],"header_pairs":[{"english":["Interpolate"],"latin":["Interpolare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","CL","DP","HH","LJPost","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1978","subsection":null},"text":"Spirits by whom they are often interrupted.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"249","subsection":"2"},"text":"Religious things... when man does not interpolate various things which are of use... (make men) visionaries and enthusiasts.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"266","subsection":"3"},"text":"The thoughts of the Angels... are not interpolated by any cares...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"296","subsection":"10"},"text":"Besides undelightful things which interrupt.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"804","subsection":null},"text":"The Babylonians who had interrupted the influx...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"839","subsection":"13"},"text":"The Armageddoni wanted to interrupt our discourse.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"160","subsection":"end"},"text":"According to the intruding cares.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"256","subsection":"end"},"text":"Not interrupted by cares.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"475","subsection":"2"},"text":"Conjugial love... is then only interrupted; and love interrupted, and not separated, remains in the subject.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"61","subsection":null},"text":"When what is undelightful intrudes...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5379","subsection":null},"text":"The Angels complained that they were interrupted in their thoughts about the Lord...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5392","subsection":"end"},"text":"They induce a sadness which interrupts their joy.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1194","subsection":"2"},"text":"It is granted to interrupt works by various things... which are recreations.","comment":null,"footnote":null},{"reference":{"work":"LJPost","section":"238","subsection":null},"text":"He was intruded upon by thought about himself.","comment":null,"footnote":null}],"slug":"interpolate","url":"/meta/potts/interpolate/"}