{"key":"ede0bbb76fc610c8","source_file":"Potts Ta - Ti.json","source_id":43763,"source_url":"concordance-throat-ppl-guttur","term":"Throat","headwords":["Throat"],"latin":["Guttur"],"header_pairs":[{"english":["Throat"],"latin":["Guttur"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"4791","subsection":null},"text":"See Tongue.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5320","subsection":"end"},"text":"A sign of the conjunction of interior truth with exterior truth, is signified by a chain upon thy throat (). AE 242:15.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"44","subsection":null},"text":"A bird (puts food) into the throats (of her young).","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4035","subsection":null},"text":"a. They spoke with me as if in the throat or windpipe.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4357","subsection":null},"text":"Hypocrites have no face, but a yawning throat...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4500","subsection":null},"text":"Her gullet was forced asunder...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"556","subsection":"9"},"text":"All things which pertain to the mouth, as the throat, etc. = such things as belong to the perception and understanding of truth, because they correspond to them.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"659","subsection":"11"},"text":"Their throat is an open sepulchre () = that there is Hell within.","comment":null,"footnote":null}],"slug":"throat","url":"/meta/potts/throat/"}