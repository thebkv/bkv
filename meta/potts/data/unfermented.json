{"key":"2652fe5fb36f78b9","source_file":"Potts U.json","source_id":8728,"source_url":"concordance-unfermented-ppl-infermentatus","term":"Unfermented","headwords":["Unfermented"],"latin":["Infermentatus"],"header_pairs":[{"english":["Unfermented"],"latin":["Infermentatus"]}],"header_sentences":["See Unleavened."],"redirect_xref":null,"works":["AC","DP","TCR"],"contexts":[{"reference":{"work":"AC","section":"2342","subsection":null},"text":"Unfermented or unleavened.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9287","subsection":null},"text":"What is unfermented or unleavened = good purified from falsities.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"284","subsection":"end"},"text":"Then good with its truth... becomes turbid and foul, like unfermented wine, and unfermented strong drink.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"404","subsection":"end"},"text":"Like the unfermented must of wine, which tastes sweet, but infests the stomach.","comment":null,"footnote":null}],"slug":"unfermented","url":"/meta/potts/unfermented/"}