{"key":"7ba7e1a1bf52f7f2","source_file":"Potts Wi.json","source_id":32611,"source_url":"concordance-with-ppl-apud","term":"With","headwords":["With"],"latin":["Apud"],"header_pairs":[{"english":["With"],"latin":["Apud"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLord","HH","LJPost"],"contexts":[{"reference":{"work":"AC","section":"1010","subsection":null},"text":"The internal life is not in man, but with him; for the Lord's life is charity, which is not in man, because man is filthy, but is with man.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1266","subsection":"end"},"text":"Unless Angels and Spirits are with him.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2009","subsection":null},"text":"All things that are his, with him, and in him.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"423","subsection":"end"},"text":"What is of the understanding only is with a man, but not in him.","comment":null,"footnote":null},{"reference":{"work":"DLord","section":"1","subsection":"2"},"text":"With God () = in God...","comment":null,"footnote":null},{"reference":{"work":"DLord","section":"1","subsection":null},"text":"With Thee () = in Thyself.","comment":null,"footnote":null},{"reference":{"work":"LJPost","section":"234","subsection":null},"text":"All evil loves are with him, and with him.","comment":null,"footnote":null}],"slug":"with-7ba7e1","url":"/meta/potts/with-7ba7e1/"}