{"key":"a238f0d6e76b084b","source_file":"Potts De.json","source_id":4574,"source_url":"concordance-decrease-ppl-decrescere","term":"Decrease","headwords":["Decrease"],"latin":["Decrescere","Decrescentia"],"header_pairs":[{"english":["Decrease"],"latin":["Decrescere","Decrescentia"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW"],"contexts":[{"reference":{"work":"AC","section":"494","subsection":"2"},"text":"As the Church decreases...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"495","subsection":null},"text":"As the Most Ancient Church decreased...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"530","subsection":null},"text":"The case with Churches is that they decrease... AC 2909:3. AC 2910:4. AC 2913:3.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2905","subsection":"3"},"text":"Good and truth... is wont to decrease.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"94","subsection":null},"text":"Spiritual heat and light decrease in proceeding, and the decrease takes place through degrees.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"186","subsection":null},"text":"Thus does wisdom decrease down to ignorance, as light decreases to shade.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"253","subsection":"2"},"text":"In each Society the light decreases from the middle to the boundaries.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"302","subsection":null},"text":"The atmospheres... decrease in downward progression according to degrees of breadth... DLW 303.","comment":null,"footnote":null}],"slug":"decrease","url":"/meta/potts/decrease/"}