{"key":"ff50653d8ad21284","source_file":"Potts Ca - Ce.json","source_id":15896,"source_url":"concordance-cave-ppl-antrum","term":"Cave","headwords":["Cave"],"latin":["Antrum"],"header_pairs":[{"english":["Cave"],"latin":["Antrum"]}],"header_sentences":[],"redirect_xref":null,"works":["AR","HH","TCR"],"contexts":[{"reference":{"work":"HH","section":"429","subsection":null},"text":"The caves which lead down to the Hells...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"481","subsection":"4"},"text":"They hide themselves in caves and caverns...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"484","subsection":null},"text":"The entrance was through a cave; I went down and entered...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"487","subsection":"end"},"text":"They could not bear to have this passage explained; but some of them rushed away into a cave...","comment":null,"footnote":null}],"slug":"cave-ff5065","url":"/meta/potts/cave-ff5065/"}