{"key":"f25379606bc017a5","source_file":"Potts Se.json","source_id":16621,"source_url":"concordance-seize-ppl-arripere","term":"Seize","headwords":["Seize"],"latin":["Arripere"],"header_pairs":[{"english":["Seize"],"latin":["Arripere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"1016","subsection":"3"},"text":"What a man loves he freely seizes on... HH 479:5.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1482","subsection":null},"text":"The knowledge He learned with avidity in early childhood.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1515","subsection":null},"text":"Sirens learn with avidity all things. AC 1983:3. SE 4307.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5135","subsection":"2"},"text":"In childhood... man learns easily...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9188","subsection":"2"},"text":"Instead of these, they learned falsities with avidity. AC 10283:9.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"352","subsection":null},"text":"They can learn with avidity falsity equally with truth. HH 464:4. HH 479:5.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"133","subsection":null},"text":"(An infant) seizes whatever comes to hand, and puts it into his mouth.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"377","subsection":"2"},"text":"Snatches fruit from the trees.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4243","subsection":"end"},"text":"As soon as they perceive anything delightful, they seize it.","comment":null,"footnote":null}],"slug":"seize-f25379","url":"/meta/potts/seize-f25379/"}