{"key":"d9bd208071df6994","source_file":"Potts Ba - Bi.json","source_id":40238,"source_url":"concordance-bind-ppl-obstringere","term":"Bind","headwords":["Bind","Binding"],"latin":["Obstringere","Obstrictio"],"header_pairs":[{"english":["Bind"],"latin":["Obstringere"]},{"english":["Binding"],"latin":["Obstrictio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"3021","subsection":null},"text":"A binding signification. AC 3045. AC 6179.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3023","subsection":null},"text":"To bind by an oath, for adjuration is nothing but a binding... AC 3046.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9211","subsection":"2"},"text":"This law was binding upon that nation, but is not binding upon Christians.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9213","subsection":"6"},"text":"(That we are) not to oblige or incite another to confirm our own truths... For he who obliges or incites another to confirm his own truths causes him not to think or speak from himself... Signified.","comment":null,"footnote":null}],"slug":"bind-d9bd20","url":"/meta/potts/bind-d9bd20/"}