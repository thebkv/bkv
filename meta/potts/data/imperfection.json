{"key":"e6f9f9b2b341cb91","source_file":"Potts I - Im.json","source_id":14961,"source_url":"concordance-imperfection-ppl-imperfectio","term":"Imperfection","headwords":["Imperfection","Imperfect"],"latin":["Imperfectio","Imperfectus"],"header_pairs":[{"english":["Imperfection"],"latin":["Imperfectio"]},{"english":["Imperfect"],"latin":["Imperfectus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","CL","DLW","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2477","subsection":"2"},"text":"They were then in a like imperfection to that in which they had been before when they were men.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"204","subsection":"2"},"text":"The lowest things, which are more imperfect as they are distant.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"346","subsection":"2"},"text":"Under Animal, see this reference.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"133","subsection":"end"},"text":"Thus the imperfection of man's birth becomes his perfection; and the perfection of the birth of a beast is its imperfection.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"52","subsection":"2"},"text":"The perfection or imperfection of the state results from the order.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3484","subsection":null},"text":"By means of the removals of imperfections...","comment":null,"footnote":null}],"slug":"imperfection","url":"/meta/potts/imperfection/"}