{"key":"d3a1c410b2963c0a","source_file":"Potts Lo - Ly.json","source_id":49016,"source_url":"concordance-lowest-ppl-infimus","term":"Lowest","headwords":["Lowest"],"latin":["Infimus"],"header_pairs":[{"english":["Lowest"],"latin":["Infimus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DLW"],"contexts":[{"reference":{"work":"AC","section":"2162","subsection":"2"},"text":"A shoe = lowest things of all, which are unclean.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2219","subsection":"4"},"text":"The love of self even with those of the lowest sort...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2761","subsection":null},"text":"The heel = the lowest Natural.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4041","subsection":null},"text":"The heavenly form in the lowest sphere. Described.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4459","subsection":"end"},"text":"(The Israelites) are in outermost or lowest things...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5387","subsection":"4"},"text":"The beard and the teeth = the lowest natural things.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6188","subsection":"2"},"text":"In the corner of a bed = in the lowest of the Natural.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6389","subsection":null},"text":"A bony donkey = the lowest service.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6390","subsection":"2"},"text":"To serve in the lowest things. Signified.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6398","subsection":"2"},"text":"Sensuous things are the lowest with man...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7784","subsection":"3"},"text":"A dog = the lowest of all in the Church.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8313","subsection":"4"},"text":"They who are in charity... want as the lowest to serve all.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9895","subsection":"2"},"text":"That the things which are lowest, or ultimate, hold higher things together... Reference. This lowest, or ultimate, is represented by the belt of the ephod.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10044","subsection":"2"},"text":"Under Highest, see this reference.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10049","subsection":null},"text":"The purification of the lowest things. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"253","subsection":"2"},"text":"Being natural... they are in the lowest things of Heaven, where they sometimes suffer hard things.","comment":null,"footnote":null}],"slug":"lowest","url":"/meta/potts/lowest/"}