{"key":"8b057a693cbef884","source_file":"Potts To - Ty.json","source_id":12134,"source_url":"concordance-treat-to-ppl-tractare","term":"Treat, To","headwords":["Treat, To"],"latin":["Tractare"],"header_pairs":[{"english":["Treat, To"],"latin":["Tractare"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","SE"],"contexts":[{"reference":{"work":"SE","section":"2438","subsection":null},"text":"(Such) are treated severely.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3299","subsection":null},"text":"Another cohort treated him cruelly...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3358","subsection":null},"text":"Whom they treat in many cruel ways. SE 3411.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3657","subsection":"end"},"text":"They treated David as he treated the gentiles.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3680","subsection":"end"},"text":"They are miserably treated.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3684","subsection":null},"text":"He is treated by others like a dog.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3851","subsection":null},"text":"As the dragon was being badly treated by them.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4596","subsection":"2"},"text":"They treat others miserably without any mercy.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4684","subsection":null},"text":"When anyone supposes himself greater than others... he is treated severely in the other life. Described.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"627","subsection":"15"},"text":"The Lord permitted the Jews to treat Him exactly as they were treating the Divine truth... AE 655:11.","comment":null,"footnote":null}],"slug":"treat-to","url":"/meta/potts/treat-to/"}