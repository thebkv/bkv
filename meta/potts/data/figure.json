{"key":"c6b35f6f8b6b4338","source_file":"Potts Fi.json","source_id":4498,"source_url":"concordance-figure-ppl-figura","term":"Figure","headwords":["Figure"],"latin":["Figura","Figuratio","Figurare"],"header_pairs":[{"english":["Figure"],"latin":["Figura","Figuratio","Figurare"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DLW","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"9340","subsection":"end"},"text":"For the sake of this figure.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9457","subsection":"3"},"text":"In which they are figured.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"71","subsection":"2"},"text":"Nothing in common with the figure and form which derive anything from the length, breadth, and height of space; but from the state of a thing...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"76","subsection":null},"text":"Carved in the figures of men, etc.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"291","subsection":"2"},"text":"Divine things were set forth under various figures and sculptures...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"671","subsection":null},"text":"These washings figured, that is represented...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"674","subsection":null},"text":"Which figured the internal Church.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"715","subsection":null},"text":"(Such) are at once turned into the figures of animals.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"724","subsection":"11"},"text":"See Daughter.","comment":null,"footnote":null}],"slug":"figure","url":"/meta/potts/figure/"}