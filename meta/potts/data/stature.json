{"key":"0681c3950efa3cd2","source_file":"Potts St - Sy.json","source_id":10190,"source_url":"concordance-stature-ppl-statura","term":"Stature","headwords":["Stature"],"latin":["Statura"],"header_pairs":[{"english":["Stature"],"latin":["Statura"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DLW","TCR"],"contexts":[{"reference":{"work":"AC","section":"9233","subsection":null},"text":"In stature (the Spirits of the moon) were like boys of seven.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"285","subsection":"end"},"text":"His human body cannot be thought of as being of any stature.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"411","subsection":null},"text":"That infants (there) grow in stature and intelligence as (here).","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"412","subsection":null},"text":"I have seen a Society as one man, in stature like a man (here).","comment":null,"footnote":null},{"reference":{"work":"AE","section":"727","subsection":"3"},"text":"Such pride is signified by she lifted herself up in her stature ().","comment":null,"footnote":null}],"slug":"stature","url":"/meta/potts/stature/"}