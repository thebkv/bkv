{"key":"f96b25bd4087228e","source_file":"Potts In.json","source_id":42500,"source_url":"concordance-insult-ppl-insultus","term":"Insult","headwords":["Insult","Insult, To","Insulting, An"],"latin":["Insultus","Insultare","Insultatio"],"header_pairs":[{"english":["Insult"],"latin":["Insultus"]},{"english":["Insult, To"],"latin":["Insultare"]},{"english":["Insulting, An"],"latin":["Insultatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"9079","subsection":null},"text":"An insult by the affection of evil against the truths and goods of faith. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9438","subsection":"2"},"text":"Safe from the insult of evil Spirits...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"536","subsection":"end"},"text":"Unless the Lord restrained the insults by the Hells...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"572","subsection":"end"},"text":"Only when the insults (of the infernals) are to be allayed.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"574","subsection":"3"},"text":"Hence come new outbreaks.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"595","subsection":"end"},"text":"In so far as possible, the outrages in the Hells are mastered.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"121","subsection":null},"text":"Such an outbreak of the Hells is meant by the tower (of Babel).","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"123","subsection":"4"},"text":"Not one of them dares to... make an assault upon any man who is in the Lord.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"407","subsection":"2"},"text":"If anyone repels an insulting enemy... he acts in the vein of charity.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3913","subsection":null},"text":"The bones defend the brain from attacks.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4633","subsection":null},"text":"On the Hells of insulters.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4633","subsection":null},"text":"In a dream there were two who grievously insulted me...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4634","subsection":null},"text":"Others came, and insulted me without any cause... These insulted with words.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4634","subsection":null},"text":"In Hell they complained that they were being insulted by them.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4634","subsection":null},"text":"Until their ferine nature... moved by such insultings from others.","comment":null,"footnote":null}],"slug":"insult-f96b25","url":"/meta/potts/insult-f96b25/"}