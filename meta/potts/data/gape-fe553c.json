{"key":"fe553c8e82b2705f","source_file":"Potts Ga - Gn.json","source_id":2621,"source_url":"concordance-gape-ppl-hiscere","term":"Gape","headwords":["Gape"],"latin":["Hiscere"],"header_pairs":[{"english":["Gape"],"latin":["Hiscere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","Ath","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"986","subsection":"2"},"text":"They dare not mutter anything against good and truth...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10367","subsection":"7"},"text":"The Hells do not mutter against the Divine.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"48","subsection":"end"},"text":"Nor do they venture to ascend any more.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2321","subsection":"end"},"text":"Not one can gape against another. SE 2322. SE 4069.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4471","subsection":"2"},"text":"They then do not venture to rise up into the World of Spirits.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4527","subsection":null},"text":"They no longer venture to do anything against another. DMin 4763.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5231","subsection":null},"text":"A mountain there was pulled asunder or yawned...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"783","subsection":"2"},"text":"None of them ventures to raise a finger...","comment":null,"footnote":null},{"reference":{"work":"Ath","section":"194","subsection":null},"text":"The Hells do not venture to look at Him.","comment":null,"footnote":null}],"slug":"gape-fe553c","url":"/meta/potts/gape-fe553c/"}