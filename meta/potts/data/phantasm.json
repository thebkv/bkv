{"key":"d56a240d66e57984","source_file":"Potts Ph - Po.json","source_id":59,"source_url":"concordance-phantasm-ppl-phantasma","term":"Phantasm","headwords":["Phantasm"],"latin":["Phantasma"],"header_pairs":[{"english":["Phantasm"],"latin":["Phantasma"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"2385","subsection":"2"},"text":"See phantasms in nocturnal light. AC 6400.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4335","subsection":"end"},"text":"As there is no internal in them, they are phantasms.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4623","subsection":"2"},"text":"When inspected by the Angels, their sensations appear like phantasms...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7290","subsection":"end"},"text":"He would reject the miracles as phantasms.","comment":null,"footnote":null}],"slug":"phantasm","url":"/meta/potts/phantasm/"}