{"key":"065e3b04e847e8c1","source_file":"Potts Fi.json","source_id":12376,"source_url":"concordance-fireplace-ppl-focus","term":"Fireplace","headwords":["Fireplace"],"latin":["Focus"],"header_pairs":[{"english":["Fireplace"],"latin":["Focus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","DP","ISB","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"3812","subsection":"5"},"text":"A hearth of bones () = the affection of truth.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7852","subsection":"2"},"text":"A fire of coals () = good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10515","subsection":null},"text":"A fireplace in which there was no fire burning, but luminous wood.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"206","subsection":"end"},"text":"There it makes its hearth...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"77","subsection":"5"},"text":"Adulterers are cast out into the fireplaces of the west... The fireplaces of the west are the loves of evil.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"231","subsection":"2"},"text":"In the middle of the amphitheatre appeared a fireplace...","comment":null,"footnote":null},{"reference":{"work":"ISB","section":"9","subsection":"3"},"text":"The concentration of its rays into a focus...","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"159","subsection":null},"text":"Smoke rising from the wood in the fireplace...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3923","subsection":null},"text":"Occurs. SE 4047.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"177","subsection":"7"},"text":"The hearth () = the Word as to good.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"504","subsection":"8"},"text":"His hearth is in Zion, and his oven in Jerusalem ()... Celestial love is relatively a hearth; and the truth of doctrine is as an oven, in which bread is prepared. AE 540:11.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"513","subsection":"16"},"text":"A hearth, or fire () = good... A hearth, and a fire = the good of love.","comment":null,"footnote":null}],"slug":"fireplace","url":"/meta/potts/fireplace/"}