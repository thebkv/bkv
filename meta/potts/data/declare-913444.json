{"key":"913444a816d666f8","source_file":"Potts De.json","source_id":4306,"source_url":"concordance-declare-ppl-declarare","term":"Declare","headwords":["Declare","Declaration"],"latin":["Declarare","Declaratio"],"header_pairs":[{"english":["Declare"],"latin":["Declarare"]},{"english":["Declaration"],"latin":["Declaratio"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","CL","SE"],"contexts":[{"reference":{"work":"CL","section":"167","subsection":"end"},"text":"This would carry with it the declaration and publication of their love.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"296","subsection":"3"},"text":"Hence... declaration belongs to the men.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"300","subsection":null},"text":"After a declaration of consent, pledges are to be given.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"300","subsection":"3"},"text":"They were then declared to be bride and bridegroom.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4650","subsection":null},"text":"They then declared that they now know what the internal man is.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"785","subsection":"2"},"text":"They declare such to be saved.","comment":null,"footnote":null}],"slug":"declare-913444","url":"/meta/potts/declare-913444/"}