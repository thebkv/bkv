{"key":"5067de59a11c5aec","source_file":"Potts Lo - Ly.json","source_id":36235,"source_url":"concordance-love-back-to-ppl-redamare","term":"Love back, To","headwords":["Love back, To","Loving back, A"],"latin":["Redamare","Redamatio"],"header_pairs":[{"english":["Love back, To"],"latin":["Redamare"]},{"english":["Loving back, A"],"latin":["Redamatio"]}],"header_sentences":["See Love, To."],"redirect_xref":null,"works":["CL","DLW","DP"],"contexts":[{"reference":{"work":"DLW","section":"115","subsection":null},"text":"Is not only received, but is also loved back.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"92","subsection":"2"},"text":"In proportion as love is loved back, it is in itself.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"160","subsection":null},"text":"In order that they may be loved back.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"200","subsection":"end"},"text":"What is lacking is a loving back by the husband.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"217","subsection":"end"},"text":"In proportion as they are loved back by their husbands.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"330","subsection":"3"},"text":"From lier spiritual beauty he loves his wife back.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"331","subsection":"3"},"text":"You do not see that you are loved by your wives, and that thus you love back.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"372","subsection":null},"text":"The man who receives the love of his consort, and loves her in return.","comment":null,"footnote":null}],"slug":"love-back-to","url":"/meta/potts/love-back-to/"}