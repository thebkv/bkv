{"key":"799383c917526b57","source_file":"Potts O.json","source_id":15508,"source_url":"concordance-olive-wood-ppl-lignum-olei","term":"Olive wood","headwords":["Olive wood"],"latin":["Lignum olei"],"header_pairs":[{"english":["Olive wood"],"latin":["Lignum olei"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL"],"contexts":[{"reference":{"work":"AC","section":"7847","subsection":"end"},"text":"Olive wood (lit. wood of oil) () = the good of truth, or the good which is of the Spiritual Church.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10261","subsection":"5"},"text":"I will give in the desert... the wood of oil () = celestial good. AE 294:2.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"77","subsection":"2"},"text":"(The sacred edifices of the people of the Copper Age are built of olive wood.)","comment":null,"footnote":null},{"reference":{"work":"CL","section":"103","subsection":"3"},"text":"The posts of these windows were of olive wood.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"156","subsection":null},"text":"[155a]. He led me to houses built of olive-wood.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"277","subsection":"5"},"text":"By the olive wood of which the cherubs were made () is signified the good of love.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"638","subsection":"8"},"text":"See Olive-tree.","comment":null,"footnote":null}],"slug":"olive-wood","url":"/meta/potts/olive-wood/"}