{"key":"4a837381d3468041","source_file":"Potts Cr - Cz.json","source_id":8810,"source_url":"concordance-cultivate-ppl-excolere","term":"Cultivate","headwords":["Cultivate"],"latin":["Excolere"],"header_pairs":[{"english":["Cultivate"],"latin":["Excolere"]}],"header_sentences":["See Worship."],"redirect_xref":null,"works":["AC","AE","HH"],"contexts":[{"reference":{"work":"AC","section":"2913","subsection":null},"text":"Under Canaanite, see this reference.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"351","subsection":"end"},"text":"Their interiors not much cultivated... HH 356:end.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"356","subsection":"end"},"text":"The human mind is like ground, which is as it is made by cultivation.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"466","subsection":null},"text":"Under Rational, see this reference, and at HH 468. HH 469. HH 488:2. HH 489:4. SE 5785.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"488","subsection":"3"},"text":"They who are in the knowledge of doctrinal things, but have not applied anything to life... shun cultivated places.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"304","subsection":"37"},"text":"Ye shall be tilled and sown () = to inseminate these things. AE 768:22.","comment":null,"footnote":null}],"slug":"cultivate","url":"/meta/potts/cultivate/"}