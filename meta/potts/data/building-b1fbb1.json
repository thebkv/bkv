{"key":"b1fbb1be7608f223","source_file":"Potts Bl - Bu.json","source_id":37201,"source_url":"concordance-building-ppl-aedes","term":"Building","headwords":["Building"],"latin":["Aedes","Aedificium"],"header_pairs":[{"english":["Building"],"latin":["Aedes","Aedificium"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"10208","subsection":"3"},"text":"Occurs.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10513","subsection":null},"text":"Their sacred buildings not of stone, but of wood. AC 10514, Described.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"223","subsection":"end"},"text":"The buildings in the Celestial Kingdom are not called temples, but houses of God. The buildings in this kingdom are devoid of magnificence, but in the Spiritual Kingdom are characterized by magnificence, greater or less.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4575","subsection":null},"text":"On a vision of a city and its buildings.","comment":null,"footnote":null}],"slug":"building-b1fbb1","url":"/meta/potts/building-b1fbb1/"}