{"key":"e9a10f48ac6d7429","source_file":"Potts Ba - Bi.json","source_id":27966,"source_url":"concordance-begin-ppl-incipere","term":"Begin","headwords":["Begin","Beginning"],"latin":["Incipere","Inceptum"],"header_pairs":[{"english":["Begin"],"latin":["Incipere"]},{"english":["Beginning"],"latin":["Inceptum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC"],"contexts":[{"reference":{"work":"AC","section":"1317","subsection":null},"text":"This is their beginning to do () = that now they were beginning to become of a different quality. A beginning to do = thought, or intention, thus the end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4249","subsection":null},"text":"Then the Natural begins to be enlightened by good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7906","subsection":"2"},"text":"When he begins to act from the good of charity.","comment":null,"footnote":null}],"slug":"begin-e9a10f","url":"/meta/potts/begin-e9a10f/"}