{"key":"62de6f715c69f0de","source_file":"Potts Aa - Am.json","source_id":14489,"source_url":"concordance-adapt-ppl-aptare","term":"Adapt","headwords":["Adapt","Adaptation"],"latin":["Aptare","Adaptare","Aptatio","Adaptatio"],"header_pairs":[{"english":["Adapt"],"latin":["Aptare","Adaptare"]},{"english":["Adaptation"],"latin":["Aptatio","Adaptatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","TCR"],"contexts":[{"reference":{"work":"AC","section":"1475","subsection":null},"text":"Adapts it to itself. AC 1495:2. DLW 263.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1637","subsection":null},"text":"Correspondently and adaptedly.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5952","subsection":"end"},"text":"The Lord thus adapts truths according to the reception of good...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6112","subsection":null},"text":"Every true and suitable scientific. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8941","subsection":null},"text":"To hew or fit the stones = to hatch or invent things like truths from what is our own.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8966","subsection":null},"text":"He is thus rendered fit to receive the life of Heaven.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9670","subsection":"6"},"text":"The incense brought within the veil = adaptation.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10729","subsection":"end"},"text":"Divine truths are such that they can be adapted to what is good.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"588","subsection":"2"},"text":"No conjunction of an active with a passive without adaptation or application.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"814","subsection":null},"text":"Influx adapts itself to efflux.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"838","subsection":"2"},"text":"Could the pure ether surround a man unless it thus adapted itself?","comment":null,"footnote":null}],"slug":"adapt-62de6f","url":"/meta/potts/adapt-62de6f/"}