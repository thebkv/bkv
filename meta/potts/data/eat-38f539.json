{"key":"38f5395d840dbb10","source_file":"Potts Ea - Es.json","source_id":16219,"source_url":"concordance-eat-ppl-manducare","term":"Eat","headwords":["Eat","Eating"],"latin":["Manducare","Manducatio"],"header_pairs":[{"english":["Eat"],"latin":["Manducare"]},{"english":["Eating"],"latin":["Manducatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"2187","subsection":"3"},"text":"To eat of the tree of life is the same as to eat the Lord; and to eat the Lord is to be endowed with love and charity...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4735","subsection":"3"},"text":"The eating of the Lord's flesh... AC 9393:4.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10521","subsection":null},"text":"Eating = appropriation and conjunction. TCR 702. AE 617:20.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"716","subsection":"end"},"text":"The Holy Supper is a spiritual eating. TCR 728.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4221","subsection":null},"text":"Eating or chewing is done from habit.","comment":null,"footnote":null}],"slug":"eat-38f539","url":"/meta/potts/eat-38f539/"}