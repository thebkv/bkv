{"key":"d1364de60f3c1af1","source_file":"Potts Rh - Ry.json","source_id":17017,"source_url":"concordance-rouge-ppl-fucare","term":"Rouge","headwords":["Rouge"],"latin":["Fucare","Fucus"],"header_pairs":[{"english":["Rouge"],"latin":["Fucare","Fucus"]}],"header_sentences":[],"redirect_xref":null,"works":["AE","CL","DP","TCR"],"contexts":[{"reference":{"work":"DP","section":"121","subsection":"2"},"text":"Rouged so as to appear handsome.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"231","subsection":"5"},"text":"Their office is to prepare red-lead into rouge, to bedaub the faces of harlots.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"109","subsection":"3"},"text":"Like an old woman whose face had been rouged, and who, from the crimson of the rouge, appeared to herself beautiful.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"972","subsection":"end"},"text":"Their sincerity and rectitude are only a pretence and cunning.","comment":null,"footnote":null}],"slug":"rouge","url":"/meta/potts/rouge/"}