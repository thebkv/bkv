{"key":"f8bf5d5a4d8801d0","source_file":"Potts Li.json","source_id":26600,"source_url":"concordance-lily-ppl-lilium","term":"Lily","headwords":["Lily"],"latin":["Lilium"],"header_pairs":[{"english":["Lily"],"latin":["Lilium"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","SE"],"contexts":[{"reference":{"work":"AC","section":"1519","subsection":null},"text":"See Flower.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"137","subsection":null},"text":"Garlands of lilies and roses of a hyacinthine colour... adorned their bosoms.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"252","subsection":"end"},"text":"All the magnificence of Solomon cannot be compared to the least lily.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"638","subsection":"11"},"text":"The first state of his regeneration is signified by, he shall blossom as the lily (). The lily = the efflorescence which precedes the fruit.","comment":null,"footnote":null}],"slug":"lily","url":"/meta/potts/lily/"}