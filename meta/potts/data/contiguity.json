{"key":"ba2da4f070aaff78","source_file":"Potts Co.json","source_id":52073,"source_url":"concordance-contiguity-ppl-contiguitas","term":"Contiguity","headwords":["Contiguity","Contiguous"],"latin":["Contiguitas","Contiguus"],"header_pairs":[{"english":["Contiguity"],"latin":["Contiguitas"]},{"english":["Contiguous"],"latin":["Contiguus"]}],"header_sentences":[],"redirect_xref":null,"works":["AR","DLW","DP"],"contexts":[{"reference":{"work":"DLW","section":"56","subsection":null},"text":"Not by continuity, but by contiguity...","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"291","subsection":"2"},"text":"These substances, contiguous to his body...","comment":null,"footnote":null},{"reference":{"work":"DP","section":"57","subsection":"end"},"text":"What is living in a man or Angel is from the proceeding Divine conjoined with him by contiguity, which appears to him as his own.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"55","subsection":"end"},"text":"The Lord's presence with man is adjunction, thus conjunction by contiguity, and this contiguity is nearer and fuller as man loves the Lord...","comment":null,"footnote":null}],"slug":"contiguity","url":"/meta/potts/contiguity/"}