{"key":"6f074cbde179384c","source_file":"Potts Ea - Es.json","source_id":37336,"source_url":"concordance-eloquence-ppl-eloquentia","term":"Eloquence","headwords":["Eloquence"],"latin":["Eloquentia","Eloquium"],"header_pairs":[{"english":["Eloquence"],"latin":["Eloquentia","Eloquium"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","SE"],"contexts":[{"reference":{"work":"AC","section":"1321","subsection":"2"},"text":"With eloquence, and apparent zeal...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1514","subsection":null},"text":"When the sphere of those who have studied eloquence in order that all things may contribute to self-admiration is turned into an odour, there is as it were the odour of burnt bread. SE 1046.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2184","subsection":"3"},"text":"Expressions such as those of eloquent discourses with the wise men of the world...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5718","subsection":null},"text":"In the life of the body they had excelled in eloquence...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"354","subsection":"end"},"text":"The state after temptation as to free eloquence from perception. Signified.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"1224","subsection":null},"text":"Under Corporeal, see this reference.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"3605","subsection":null},"text":"1.2. I saw a dead horse, signifying that eloquence is not to be studied...","comment":null,"footnote":null}],"slug":"eloquence-6f074c","url":"/meta/potts/eloquence-6f074c/"}