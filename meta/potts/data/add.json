{"key":"0019c26fc9922d1f","source_file":"Potts Aa - Am.json","source_id":14619,"source_url":"concordance-add-ppl-addere","term":"Add","headwords":["Add","Additament"],"latin":["Addere","Additamentum"],"header_pairs":[{"english":["Add"],"latin":["Addere"]},{"english":["Additament"],"latin":["Additamentum"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR"],"contexts":[{"reference":{"work":"AC","section":"380","subsection":null},"text":"Not to add to give its strength to thee = to be barren.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1461","subsection":"end"},"text":"The human essence was only an additament to His Divine.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3969","subsection":null},"text":"Joseph was named from gathering and adding.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4692","subsection":null},"text":"To add = more. AC 7614. AC 7737.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4914","subsection":null},"text":"Not to add = no more.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"9333","subsection":"2"},"text":"Whatever man thinks, wills, speaks and does, adds itself to his life... AC 9334:2.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"957","subsection":null},"text":"To add anything to these words = by adding anything that will destroy those truths.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"957","subsection":"end"},"text":"To add is also a prophetic term meaning to destroy. Illustrated.","comment":null,"footnote":null}],"slug":"add","url":"/meta/potts/add/"}