{"key":"dc091473ce7599a3","source_file":"Potts Ci - Cl.json","source_id":1571,"source_url":"concordance-circumspection-ppl-circumspectio","term":"Circumspection","headwords":["Circumspection","To exercise Circumspection"],"latin":["Circumspectio","Circumspicere"],"header_pairs":[{"english":["Circumspection"],"latin":["Circumspectio"]},{"english":["To exercise Circumspection"],"latin":["Circumspicere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","AR","CL"],"contexts":[{"reference":{"work":"AC","section":"197","subsection":null},"text":"A serpent, with the most ancients, signified circumspection...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"197","subsection":null},"text":"The brazen serpent = the Lord's Sensual... Who alone exercises circumspection and provides for all.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3901","subsection":"5"},"text":"The face of an eagle = circumspection, and thence Providence.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6398","subsection":"2"},"text":"The very sagacity and circumspection which comes forth in externals, is signified by serpents.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"561","subsection":null},"text":"The Divine circumspection for the New Church. Signified.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"194","subsection":null},"text":"The innate circumspection of wives.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"281","subsection":"2"},"text":"He placed it circumspectly () = multiplication... To place it circumspectly = to separate from falsities.","comment":null,"footnote":null}],"slug":"circumspection","url":"/meta/potts/circumspection/"}