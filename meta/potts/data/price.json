{"key":"22572fe014c6590e","source_file":"Potts Pr - Py.json","source_id":12712,"source_url":"concordance-price-ppl-pretium","term":"Price","headwords":["Price"],"latin":["Pretium"],"header_pairs":[{"english":["Price"],"latin":["Pretium"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE"],"contexts":[{"reference":{"work":"AC","section":"2959","subsection":null},"text":"The price of redemption by truth. Signified, Explained.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2959","subsection":"5"},"text":"A shekel = price, or estimation.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2959","subsection":"6"},"text":"A shekel = the price of what is holy. Illustrated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2959","subsection":null},"text":"The number determines the estimation or price of good and truth.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2966","subsection":null},"text":"The price of redemption, is the Lord's merit and justice through the most grievous temptations...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2966","subsection":"end"},"text":"With these, the price of redemption is signified by...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8568","subsection":"2"},"text":"To buy without price () = to acquire from the Lord; thus gratis. ( = without Own intelligence. AE 617:10.)","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8849","subsection":null},"text":"Something of small value.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"328","subsection":"10"},"text":"Occurs. AE 695:3.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"654","subsection":"61"},"text":"Our woods come for a price () = instruction from ourselves; whence come mere evils.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":"18"},"text":"Not for price, nor reward () = gratis from the Divine love. AE 811:19.","comment":null,"footnote":null}],"slug":"price","url":"/meta/potts/price/"}