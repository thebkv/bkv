{"key":"12a96ea1e4f9dabe","source_file":"Potts Re.json","source_id":56346,"source_url":"concordance-revive-ppl-refocillare","term":"Revive","headwords":["Revive","Revival"],"latin":["Refocillare","Refocillatio"],"header_pairs":[{"english":["Revive"],"latin":["Refocillare"]},{"english":["Revival"],"latin":["Refocillatio"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","CL","SE","TCR"],"contexts":[{"reference":{"work":"AC","section":"7218","subsection":null},"text":"Those infested by mere falsities, and not revived by truths...","comment":null,"footnote":null},{"reference":{"work":"CL","section":"5","subsection":"end"},"text":"They fled away home, everyone to his work, and were revived.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"216","subsection":"end"},"text":"The consorts are revived by the hope of its continuation after death.","comment":null,"footnote":null},{"reference":{"work":"CL","section":"294","subsection":"4"},"text":"The man is revived by the influent meretricious sphere.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"434","subsection":null},"text":"Assemblies of friendship... for the revival of the sensuous things of the body.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"569","subsection":"2"},"text":"Stenches revive their nostrils and hearts.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4700","subsection":"end"},"text":"He inquired where he could be revived, and at last he was revived.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5941","subsection":null},"text":"This is their quiet, and revival.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"1214","subsection":"2"},"text":"Minds are revived, recreated, and excited... by the odours and flavours of plants.","comment":null,"footnote":null}],"slug":"revive-12a96e","url":"/meta/potts/revive-12a96e/"}