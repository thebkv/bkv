{"key":"219ea8cea0b7c124","source_file":"Potts Se.json","source_id":15960,"source_url":"concordance-seek-ppl-quaerere","term":"Seek","headwords":["Seek"],"latin":["Quaerere"],"header_pairs":[{"english":["Seek"],"latin":["Quaerere"]}],"header_sentences":["See Inquire, and Question."],"redirect_xref":null,"works":["AC","AE","AR","DLW","DP","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"1008","subsection":null},"text":"To require the life of man () = to avenge profanation.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"3058","subsection":"2"},"text":"Those who seek water () = those who long to be instructed in truths.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4367","subsection":null},"text":"Nay, I pray () = the origin of affection.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4718","subsection":null},"text":"What seekest thou? () = foresight.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"5610","subsection":null},"text":"Of my hand thou shalt require him () = that it shall not be separated.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6513","subsection":null},"text":"Speak, I pray () = solicitation.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6563","subsection":null},"text":"Remit, I pray () = supplication.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7021","subsection":null},"text":"Those who seek thy soul () = those who endeavour to destroy the life.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7043","subsection":null},"text":"To seek to kill () = not to receive.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"563","subsection":"2"},"text":"Reduced to seek alms.","comment":null,"footnote":null},{"reference":{"work":"DLW","section":"342","subsection":null},"text":"This shall now be [a matter] of investigation. ConvCalvin 2.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"101","subsection":"end"},"text":"It is not asked, What has thy faith been...","comment":null,"footnote":null},{"reference":{"work":"AR","section":"429","subsection":null},"text":"Men shall seek death () = that they want the understanding to be closed up in the things of faith... To seek is predicated of the understanding; and to desire, of the will. AE 550.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4676","subsection":null},"text":"Do not care for these intricate questions.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"386","subsection":"19"},"text":"Those who seek Jehovah () = those who are therefore loved by the Lord.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"706","subsection":"24"},"text":"Occurs. AE 750:12.","comment":null,"footnote":null}],"slug":"seek-219ea8","url":"/meta/potts/seek-219ea8/"}