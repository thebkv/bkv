{"key":"39049d8609a6afed","source_file":"Potts Fl - Fu.json","source_id":51683,"source_url":"concordance-funeral-ppl-funeralis","term":"Funeral","headwords":["Funeral","Burial"],"latin":["Funeralis","Funus"],"header_pairs":[{"english":["Funeral"],"latin":["Funeralis"]},{"english":["Burial"],"latin":["Funus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DMin","HH"],"contexts":[{"reference":{"work":"AC","section":"2299","subsection":null},"text":"In the idea of a grave there is somewhat of burial which they thus removed. HH 335.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4622","subsection":"4"},"text":"He spoke with me about the funeral ceremonies while I was following in his funeral procession...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"312","subsection":"4"},"text":"I told them that their funeral and obsequies were now being made ready...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4622","subsection":"4"},"text":"See Funeral. HH 312:4.","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4752","subsection":null},"text":"Polhem died on a Monday... When I was invited to the funeral he saw his coffin, and those who were there...","comment":null,"footnote":null}],"slug":"funeral-39049d","url":"/meta/potts/funeral-39049d/"}