{"key":"03e2da9ef78597ad","source_file":"Potts Pr - Py.json","source_id":11706,"source_url":"concordance-press-ppl-incumbere","term":"Press","headwords":["Press"],"latin":["Incumbere"],"header_pairs":[{"english":["Press"],"latin":["Incumbere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DP","HH"],"contexts":[{"reference":{"work":"AC","section":"1661","subsection":"3"},"text":"Hell presses on man as the sea upon each part of a dyke. AC 1692:end.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2163","subsection":null},"text":"Recline ye under the tree () = to the perception of his state in which he was.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"7296","subsection":null},"text":"The Egyptians applied themselves to such things.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"589","subsection":null},"text":"Lower things react in proportion as the higher ones press down.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"296","subsection":"end"},"text":"No more is incumbent on man than...","comment":null,"footnote":null},{"reference":{"work":"AE","section":"409","subsection":"end"},"text":"My Servant, upon whom I lean () = the Divine Human.","comment":null,"footnote":null}],"slug":"press-03e2da","url":"/meta/potts/press-03e2da/"}