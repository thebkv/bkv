{"key":"5b8cb86121c5ea55","source_file":"Potts Pr - Py.json","source_id":9564,"source_url":"concordance-present-to-be-ppl-adesse","term":"Present, To be","headwords":["Present, To be"],"latin":["Adesse"],"header_pairs":[{"english":["Present, To be"],"latin":["Adesse"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","DMin"],"contexts":[{"reference":{"work":"AC","section":"1114","subsection":null},"text":"They are present in a moment. AC 1274:2. SE 3076. SE 5669. SE 5697:end. AE 1219:2.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1316","subsection":null},"text":"The Lord can never be present; man's proprium removes the Lord.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"2338","subsection":"end"},"text":"Prayers that He be present.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"4549","subsection":null},"text":"To provide, properly, is to be present with anyone...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"6574","subsection":"2"},"text":"With those in temptation, the Lord Himself, both immediately, and mediately through Angels, is present...","comment":null,"footnote":null},{"reference":{"work":"DMin","section":"4574","subsection":null},"text":"Those who in the world had associated with others with no other end than that they might be present. Treated of.","comment":null,"footnote":null}],"slug":"present-to-be","url":"/meta/potts/present-to-be/"}