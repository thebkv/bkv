{"key":"d466b90ac9ace9f6","source_file":"Potts K.json","source_id":21335,"source_url":"concordance-know-ppl-dignoscere","term":"Know","headwords":["Know"],"latin":["Dignoscere"],"header_pairs":[{"english":["Know"],"latin":["Dignoscere"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AR","HH","TCR"],"contexts":[{"reference":{"work":"AC","section":"1072","subsection":"2"},"text":"Spirits are known... as to whether they are in the faith of charity, or not...","comment":null,"footnote":null},{"reference":{"work":"AC","section":"1079","subsection":"2"},"text":"These two kinds of men are thence known...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"438","subsection":"end"},"text":"They are well distinguished from the Spirits who are there.","comment":null,"footnote":null},{"reference":{"work":"AR","section":"110","subsection":"end"},"text":"By truths alone is one known from the other.","comment":null,"footnote":null},{"reference":{"work":"TCR","section":"103","subsection":"2"},"text":"The Jews are thereby known from others.","comment":null,"footnote":null}],"slug":"know-d466b9","url":"/meta/potts/know-d466b9/"}