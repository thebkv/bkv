{"key":"8d653bd4ef730a2f","source_file":"Potts St - Sy.json","source_id":25295,"source_url":"concordance-stretch-ppl-tendere","term":"Stretch","headwords":["Stretch"],"latin":["Tendere"],"header_pairs":[{"english":["Stretch"],"latin":["Tendere"]}],"header_sentences":["See Tendon."],"redirect_xref":null,"works":["AC","AE","DP","HH","SE"],"contexts":[{"reference":{"work":"AC","section":"2892","subsection":null},"text":"He is certain that all things tend to his good.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"8439","subsection":"end"},"text":"The ultimate, to which all Divine influx tends.","comment":null,"footnote":null},{"reference":{"work":"AC","section":"10546","subsection":null},"text":"To stretch a tent () = to provide, dispose, and ordinate the things which are of the Church and of worship.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"429","subsection":null},"text":"Stretching obliquely downwards...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"479","subsection":"5"},"text":"Ways tending elsewhere they do not see.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"496","subsection":"end"},"text":"They go in the ways which tend thither.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"534","subsection":null},"text":"The way which tended to the left was narrow... The way which tended to the right was broad...","comment":null,"footnote":null},{"reference":{"work":"HH","section":"590","subsection":"2"},"text":"Good Spirits go in ways which tend to Heaven; evil Spirits in those which tend to Hell.","comment":null,"footnote":null},{"reference":{"work":"HH","section":"592","subsection":"2"},"text":"From proprium, all tend to Hell.","comment":null,"footnote":null},{"reference":{"work":"DP","section":"69","subsection":null},"text":"Of himself, man continually tends to the lowest of Hell.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"4652","subsection":null},"text":"(Gentiles explored by noticing whether they tend to Heaven or to Hell.)","comment":null,"footnote":null},{"reference":{"work":"AE","section":"238","subsection":"3"},"text":"They bend their bow. ( = prepared to destroy. AE 357:21.)","comment":null,"footnote":null}],"slug":"stretch","url":"/meta/potts/stretch/"}