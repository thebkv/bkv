{"key":"e8589bc834e5d2ac","source_file":"Potts Mi - My.json","source_id":13477,"source_url":"concordance-mist-ppl-nebula","term":"Mist","headwords":["Mist","Misty"],"latin":["Nebula","Nebulosus"],"header_pairs":[{"english":["Mist"],"latin":["Nebula"]},{"english":["Misty"],"latin":["Nebulosus"]}],"header_sentences":[],"redirect_xref":null,"works":["AC","AE","DeVerbo","SE"],"contexts":[{"reference":{"work":"AC","section":"581","subsection":null},"text":"In Hell, under a misty and dense rock...","comment":null,"footnote":null},{"reference":{"work":"SE","section":"2700","subsection":null},"text":"Lest they should be veiled over with such a misty sphere.","comment":null,"footnote":null},{"reference":{"work":"SE","section":"5765","subsection":null},"text":"c. Where they were not seen, except as a mist.","comment":null,"footnote":null},{"reference":{"work":"AE","section":"937","subsection":"3"},"text":"I will come to thee in the mist of a cloud (). It is said in the mist of a cloud, because by a cloud is signified the Word in the letter.","comment":null,"footnote":null},{"reference":{"work":"DeVerbo","section":"7","subsection":"7"},"text":"Whereas a mist agrees with falsities.","comment":null,"footnote":null}],"slug":"mist-e8589b","url":"/meta/potts/mist-e8589b/"}